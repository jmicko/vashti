// The MoE router's choice (one workgroup of 512 lanes, one expert per lane): probs =
// sigmoid(logits); the `used` experts with the largest probs + bias (ties: the lower index),
// in that order; their weights the unbiased probs, normalized to sum 1 (at least 6.1e-5)
// and times `scale`. Writes, to the host-visible `route` (uvec4 units): the ids [used] as
// uints, the weights [used], the block's normed input x [n] (for the CPU), and last, after
// the rest is visible, `seq` at word 2*used + n (the host spins on it instead of a fence).
// The ids and weights also go to `dev` (device memory, for the device's experts).
// used is a multiple of 4.
#version 460
layout(local_size_x = 512) in;
layout(set = 0, binding = 0) readonly buffer Logits { float logits[]; };
layout(set = 0, binding = 1) readonly buffer Bias { float bias[]; };
layout(set = 0, binding = 2) readonly buffer X { vec4 x[]; };
layout(set = 0, binding = 3) coherent buffer Route { uvec4 route[]; };
layout(set = 0, binding = 4) writeonly buffer Dev { uint dev[]; };
#ifdef BATCHED
// Batched: token t = workgroup z, its logits at t*experts, its ids and weights to
// dev[t*2used ..] only (nothing to the host).
layout(push_constant) uniform Constants { uint experts; uint used; float scale; } p;
#else
layout(push_constant) uniform Constants { uint experts; uint used; float scale; uint n; uint seq; } p;
#endif

shared float key[512];
shared float prob[512];
shared uint chosen[16];
shared uint words[32];

void main() {
    uint e = gl_LocalInvocationIndex;
#ifdef BATCHED
    uint lb = gl_WorkGroupID.z * p.experts, db = gl_WorkGroupID.z * 2 * p.used;
#else
    uint lb = 0, db = 0;
#endif
    float pr = 0.0, k = -1.0 / 0.0;
    if (e < p.experts) {
        pr = 1.0 / (1.0 + exp(-logits[lb + e]));
        k = pr + bias[e];
    }
    key[e] = k;
    prob[e] = pr;
    barrier();
    if (e < p.experts) {
        uint rank = 0;
        for (uint o = 0; o < p.experts; o++) {
            float ko = key[o];
            rank += (ko > k || (ko == k && o < e)) ? 1u : 0u;
        }
        if (rank < p.used) chosen[rank] = e;
    }
    barrier();
    if (e == 0) {
        float sum = 0.0;
        for (uint i = 0; i < p.used; i++) sum += prob[chosen[i]];
        sum = max(sum, 6.1035156e-5);
        for (uint i = 0; i < p.used; i++) {
            uint wv = floatBitsToUint(prob[chosen[i]] / sum * p.scale);
            words[i] = chosen[i];
            words[p.used + i] = wv;
            dev[db + i] = chosen[i];
            dev[db + p.used + i] = wv;
        }
    }
#ifdef BATCHED
    return;
#else
    barrier();
    uint head = 2 * p.used / 4;   // uvec4s of ids and weights
    if (e < head) route[e] = uvec4(words[4 * e], words[4 * e + 1], words[4 * e + 2], words[4 * e + 3]);
    for (uint i = e; i < p.n / 4; i += 512) route[head + i] = floatBitsToUint(x[i]);
    memoryBarrierBuffer();
    barrier();
    if (e == 0) {
        memoryBarrierBuffer();
        route[head + p.n / 4] = uvec4(p.seq, 0, 0, 0);
    }
#endif
}
