// Absorbed latent attention for a batch (mla.comp's), H = 16 heads per workgroup so each
// cached latent is read once for all of them, with a running (online) softmax: workgroup
// (g, t) takes heads [g*16, g*16 + 16) of token t at position pos + t over its causal span of
// latents [positions][lora] (or, past top_k + kpool - 1 positions, the indexer's choice
// idx[t*idx_st ..]), queries at t*q_st, mixed into t*m_st. Per tile of 16 positions lane
// (h, i) = (lane / 16, lane % 16) scores head h against position i (a 16-lane cluster per
// head for the tile's max and sum); then lane takes channels 2*lane, 2*lane + 1 of every
// head's running mix. lora 512.
#version 460
#extension GL_KHR_shader_subgroup_clustered : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Absorbed { vec4 q[]; };
layout(set = 0, binding = 1) readonly buffer Latents { vec4 lat[]; };
layout(set = 0, binding = 2) writeonly buffer Mixed { vec2 mixed[]; };
layout(set = 0, binding = 3) readonly buffer Idx { uint idx[]; };
layout(push_constant) uniform Constants { uint lora; float scale; uint pos; uint top_k; uint kpool; uint q_st; uint m_st; uint idx_st; } p;

const uint H = 16, T = 16, L4 = 128;
shared vec4 qs[H][L4];
shared float pt[H][T];        // the tile's weights exp(s - max)
shared float rescale[H];      // exp(old max - new max) per head
shared uint at[T];

void main() {
    uint g = gl_WorkGroupID.x, tok = gl_WorkGroupID.y, lane = gl_LocalInvocationIndex;
    uint P = p.pos + tok;
    uint pools = (P + 1) / p.kpool, keep = p.top_k / p.kpool;
    bool indexed = pools > keep;
    uint count = indexed ? keep * p.kpool + (P + 1 - pools * p.kpool) : P + 1;
    uint ib = tok * p.idx_st;
    for (uint i = lane; i < H * L4; i += 256) {
        uint h = i / L4, c = i % L4;
        qs[h][c] = q[(tok * p.q_st) / 4 + (g * H + h) * L4 + c];
    }
    uint sh = lane / T, si = lane % T;       // scoring: head, position in the tile
    float m = -1.0 / 0.0, l = 0.0;           // head sh's running max and sum (its 16 lanes)
    vec2 acc[H];
    for (uint h = 0; h < H; h++) acc[h] = vec2(0.0);
    uint c2 = lane;                          // channels 2*lane, 2*lane + 1
    for (uint t0 = 0; t0 < count; t0 += T) {
        if (lane < T) at[lane] = t0 + lane < count ? (indexed ? idx[ib + t0 + lane] : t0 + lane) : 0u;
        barrier();
        bool live = t0 + si < count;
        float s = -1.0 / 0.0;
        if (live) {
            uint b = at[si] * L4;
            float d = 0.0;
            for (uint c = 0; c < L4; c++) d += dot(qs[sh][c], lat[b + c]);
            s = d * p.scale;
        }
        float tm = subgroupClusteredMax(s, T);
        float nm = max(m, tm);
        float e = live ? exp(s - nm) : 0.0;
        float ts = subgroupClusteredAdd(e, T);
        float r = exp(m - nm);
        l = l * r + ts;
        m = nm;
        pt[sh][si] = e;
        if (si == 0) rescale[sh] = r;
        barrier();
        for (uint h = 0; h < H; h++) acc[h] *= rescale[h];
        uint n = min(T, count - t0);
        for (uint i = 0; i < n; i++) {
            vec4 lv = lat[at[i] * L4 + c2 / 2];
            vec2 v = (c2 % 2) == 0 ? lv.xy : lv.zw;
            for (uint h = 0; h < H; h++) acc[h] += pt[h][i] * v;
        }
        barrier();
    }
    // Every head's sum, from its scoring lanes.
    if (si == 0) rescale[sh] = 1.0 / l;
    barrier();
    for (uint h = 0; h < H; h++)
        mixed[(tok * p.m_st + (g * H + h) * p.lora) / 2 + c2] = acc[h] * rescale[h];
}
