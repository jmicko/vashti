// Clamped SwiGLU: out[e n + i] = silu(min(gu[e 2n + i], limit)) * clamp(gu[e 2n + n + i],
// -limit, limit) for `count` experts (gate then up, as one product's rows); limit <= 1e-6
// means no clamp.
#version 460
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Gu { float gu[]; };
layout(set = 0, binding = 1) writeonly buffer Out { float o[]; };
layout(push_constant) uniform Constants { uint n; float limit; uint count; } p;

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= p.n * p.count) return;
    uint e = t / p.n, i = t % p.n;
    float g = gu[e * 2 * p.n + i], u = gu[e * 2 * p.n + p.n + i];
    if (p.limit > 1e-6) {
        g = min(g, p.limit);
        u = clamp(u, -p.limit, p.limit);
    }
    o[t] = g / (1.0 + exp(-g)) * u;
}
