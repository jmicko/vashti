// Grouped-query attention for n queries. Queries [n][heads][dim] at q_off; keys and values
// [key][kv_heads][dim] at k_off/v_off, key j at position j. Query t sits at position
// pos0 + t; causal queries see keys up to their own position, within `window` positions
// (0: all); bidirectional queries see keys 0..keys. Scores go through `scratch`, one row of
// `cap` floats per (query, head). Output [n][heads][dim] at o_off, times the sigmoid of
// the head's gate ([n][heads]) when `gated`. One workgroup per (query, head); each
// subgroup takes whole keys (its lanes over the dimensions, the query in registers; dim at
// most 8 per lane), then the lanes take keys for the softmax, and for the sum lane groups
// of `dim` lanes split the keys.
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1) readonly buffer K { float k[]; };
layout(set = 0, binding = 2) readonly buffer V { float v[]; };
layout(set = 0, binding = 3) buffer Scratch { float sc[]; };
layout(set = 0, binding = 4) buffer O { float o[]; };
layout(set = 0, binding = 5) readonly buffer Gates { float gates[]; };
layout(push_constant) uniform Constants {
    uint n; uint heads; uint kv_heads; uint dim;
    uint q_off; uint k_off; uint v_off; uint o_off;
    uint pos0; uint keys; uint causal; uint window;
    float scale; uint cap; uint gated;
} p;

shared float part[128];

// Across the workgroup: subgroup reductions, then one value per subgroup through `part`.
float reduce_max(float mine, uint lane) {
    mine = subgroupMax(mine);
    if (gl_SubgroupInvocationID == 0) part[gl_SubgroupID] = mine;
    barrier();
    float r = part[0];
    for (uint s = 1; s < gl_NumSubgroups; s++) r = max(r, part[s]);
    barrier();
    return r;
}
float reduce_sum(float mine, uint lane) {
    mine = subgroupAdd(mine);
    if (gl_SubgroupInvocationID == 0) part[gl_SubgroupID] = mine;
    barrier();
    float r = 0.0;
    for (uint s = 0; s < gl_NumSubgroups; s++) r += part[s];
    barrier();
    return r;
}

void main() {
    uint head = gl_WorkGroupID.x % p.heads;
    uint t = gl_WorkGroupID.x / p.heads;
    uint lane = gl_LocalInvocationIndex;
    uint g = head / (p.heads / p.kv_heads);
    uint kvw = p.kv_heads * p.dim;
    uint qa = p.q_off + (t * p.heads + head) * p.dim;
    uint first = 0, last = p.keys;   // [first, last)
    if (p.causal != 0) {
        uint pos = p.pos0 + t;
        last = pos + 1;
        if (p.window != 0 && pos + 1 > p.window) first = pos + 1 - p.window;
    }
    uint row = gl_WorkGroupID.x * p.cap;
    uint width = gl_SubgroupSize, sl = gl_SubgroupInvocationID;
    // This lane's dimensions of the query (dim up to 8 per lane).
    float qv[8];
    for (uint u = 0; u < 8; u++) {
        uint i = sl + u * width;
        qv[u] = i < p.dim ? q[qa + i] : 0.0;
    }
    float top = -3.4e38;
    for (uint j = first + gl_SubgroupID; j < last; j += gl_NumSubgroups) {
        uint ka = p.k_off + j * kvw + g * p.dim;
        float d = 0.0;
        for (uint u = 0; u < 8; u++) {
            uint i = sl + u * width;
            if (i < p.dim) d += qv[u] * k[ka + i];
        }
        d = subgroupAdd(d) * p.scale;
        if (sl == 0) sc[row + j] = d;
        top = max(top, d);
    }
    memoryBarrierBuffer();
    top = reduce_max(top, lane);
    float sum = 0.0;
    for (uint j = first + lane; j < last; j += 128) {
        float e = exp(sc[row + j] - top);
        sc[row + j] = e;
        sum += e;
    }
    sum = reduce_sum(sum, lane);
    memoryBarrierBuffer();
    barrier();
    uint va = p.v_off + g * p.dim;
    if (p.dim <= 128) {
        // Lane groups of `dim` lanes split the keys (128 / dim groups), four running sums a
        // lane; the groups meet in `part`.
        uint groups = 128 / p.dim, i = lane % p.dim, grp = lane / p.dim;
        float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
        if (grp < groups) {
            uint j = first + grp;
            for (; j + 3 * groups < last; j += 4 * groups) {
                a0 += sc[row + j] * v[va + j * kvw + i];
                a1 += sc[row + j + groups] * v[va + (j + groups) * kvw + i];
                a2 += sc[row + j + 2 * groups] * v[va + (j + 2 * groups) * kvw + i];
                a3 += sc[row + j + 3 * groups] * v[va + (j + 3 * groups) * kvw + i];
            }
            for (; j < last; j += groups) a0 += sc[row + j] * v[va + j * kvw + i];
        }
        part[lane] = (a0 + a1) + (a2 + a3);
        barrier();
        if (lane < p.dim) {
            float acc = 0.0;
            for (uint q = 0; q < groups; q++) acc += part[q * p.dim + lane];
            float out_v = acc / sum;
            // A gated head: times the sigmoid of its gate ([n][heads]).
            if (p.gated != 0) out_v *= 1.0 / (1.0 + exp(-gates[t * p.heads + head]));
            o[p.o_off + (t * p.heads + head) * p.dim + lane] = out_v;
        }
        return;
    }
    for (uint i = lane; i < p.dim; i += 128) {
        float acc = 0.0;
        for (uint j = first; j < last; j++) acc += sc[row + j] * v[va + j * kvw + i];
        float v = acc / sum;
        // A gated head: times the sigmoid of its gate ([n][heads]).
        if (p.gated != 0) v *= 1.0 / (1.0 + exp(-gates[t * p.heads + head]));
        o[p.o_off + (t * p.heads + head) * p.dim + i] = v;
    }
}
