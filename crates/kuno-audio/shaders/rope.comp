// NEOX rotary embedding in place: for token t (position pos0 + t), each of `heads` heads of
// `dim` values, the pair (i, i + dim/2) is rotated by pos * base^(-2i/dim) (divided by
// factor[i] when factors are used). Token rows are `stride` values apart.
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer Factors { float f[]; };
layout(push_constant) uniform Constants {
    uint n; uint heads; uint dim; uint off; uint stride; uint pos0; float base; uint factors;
} p;

void main() {
    uint half_ = p.dim / 2;
    uint id = gl_GlobalInvocationID.x;
    if (id >= p.n * p.heads * half_) return;
    uint i = id % half_;
    uint head = (id / half_) % p.heads;
    uint t = id / (half_ * p.heads);
    float theta = float(p.pos0 + t) * pow(p.base, -2.0 * float(i) / float(p.dim));
    if (p.factors != 0) theta /= f[i];
    float s = sin(theta), c = cos(theta);
    uint at = p.off + t * p.stride + head * p.dim + i;
    float a = x[at], b = x[at + half_];
    x[at] = a * c - b * s;
    x[at + half_] = a * s + b * c;
}
