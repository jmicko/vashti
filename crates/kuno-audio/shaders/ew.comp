// Element-wise steps on `count` values. mode 0: out[i] = silu(a[i]) * b[i] (SwiGLU, a and b
// of the same layout); mode 1: out[i] *= sigmoid(a[gate row]) per head (a: [n][heads]
// gates, out: [n][heads][dim]); mode 2: out[i] = a[i] + b[i]; mode 3: out[i] += a[i];
// mode 4: out[i] = a[i].
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer A { float a[]; };
layout(set = 0, binding = 1) readonly buffer B { float b[]; };
layout(set = 0, binding = 2) buffer Out { float o[]; };
layout(push_constant) uniform Constants {
    uint count; uint mode; uint a_off; uint b_off; uint o_off; uint dim;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    if (p.mode == 0) {
        float g = a[p.a_off + i];
        o[p.o_off + i] = g / (1.0 + exp(-g)) * b[p.b_off + i];
    } else if (p.mode == 1) {
        float g = a[p.a_off + i / p.dim];
        o[p.o_off + i] *= 1.0 / (1.0 + exp(-g));
    } else if (p.mode == 2) {
        o[p.o_off + i] = a[p.a_off + i] + b[p.b_off + i];
    } else if (p.mode == 3) {
        o[p.o_off + i] += a[p.a_off + i];
    } else {
        o[p.o_off + i] = a[p.a_off + i];
    }
}
