// Qwen Image 2.1 VAE: unfolds a channel-major f32 map x[ci][y * w_src + x] for one k x k
// convolution (k = 1 or 3) into rows of half floats for gemm16: col[p][tap * inputs + ci],
// tap = ky * k + kx, for output pixels p (w_out wide) of one chunk. Output (oy, ox) reads
// input (oy * stride + ky - pad, ox * stride + kx - pad), zero outside the w_in x h_in map.
// With `norm` 1, each value is first RMS-normalized over channels and passed through SiLU:
//   silu(v * scale[pixel] * gamma[ci]); with `norm` 2 only normalized.
// With `up`, the convolution reads the map upsampled 2x (nearest): w_in x h_in is the
// upsampled size and the source half of that. Columns from taps * inputs to `columns` are zeros, and so are
// pixels past `pixels`.
// Dispatch x = ceil(inputs / 128), y = 256, z = chunk / 256; one invocation per (ci, p).
#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer In { float x[]; };
layout(set = 0, binding = 1) readonly buffer Scale { float s[]; };
layout(set = 0, binding = 2) readonly buffer Vectors { float v[]; };
layout(set = 0, binding = 3) writeonly buffer Col { float16_t col[]; };
layout(push_constant) uniform Constants {
    uint inputs;
    uint w_in;
    uint h_in;
    uint in_stride;
    uint pixels;
    uint first;
    uint kernel;
    uint columns;
    uint norm;
    uint gamma_first;
    uint up;
    uint w_out;
    uint stride;
    uint pad;
} p;

void main() {
    uint ci = gl_WorkGroupID.x * 128 + gl_LocalInvocationID.x;
    uint local = gl_WorkGroupID.z * 256 + gl_WorkGroupID.y;
    uint q = p.first + local;
    if (ci >= p.inputs) return;
    uint taps = p.kernel * p.kernel;
    uint row = local * p.columns;
    if (ci == 0) {
        for (uint c = taps * p.inputs; c < p.columns; c++) col[row + c] = float16_t(0.0);
    }
    if (q >= p.pixels) {
        for (uint t = 0; t < taps; t++) col[row + t * p.inputs + ci] = float16_t(0.0);
        return;
    }
    uint oy = q / p.w_out;
    uint ox = q - oy * p.w_out;
    int pad = int(p.pad);
    uint w_src = p.up != 0 ? p.w_in / 2 : p.w_in;
    float gamma = p.norm != 0 ? v[p.gamma_first + ci] : 1.0;
    uint base = ci * p.in_stride;
    for (uint ky = 0; ky < p.kernel; ky++) {
        int iy = int(oy * p.stride + ky) - pad;
        for (uint kx = 0; kx < p.kernel; kx++) {
            int ix = int(ox * p.stride + kx) - pad;
            float value = 0.0;
            if (iy >= 0 && iy < int(p.h_in) && ix >= 0 && ix < int(p.w_in)) {
                uint sy = p.up != 0 ? uint(iy) / 2 : uint(iy);
                uint sx = p.up != 0 ? uint(ix) / 2 : uint(ix);
                uint at = sy * w_src + sx;
                value = x[base + at];
                if (p.norm != 0) {
                    value *= s[at] * gamma;
                    if (p.norm == 1) value = value / (1.0 + exp(-value));
                }
            }
            col[row + (ky * p.kernel + kx) * p.inputs + ci] = float16_t(value);
        }
    }
}
