// Residual update of the f32 stream for live tokens, one vec4 per invocation:
//   x[token][c] += scale[c] * (g[token][c] + bias[c])
#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], 4459, 16);

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Stream { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Update { vec4 g[]; };
layout(set = 0, binding = 2) readonly buffer Vectors { vec4 v[]; };
// Offsets are in values and multiples of 4.
layout(push_constant) uniform Constants { uint tokens; uint bias_first; uint scale_first; } p;

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint at = gl_GlobalInvocationID.y * 512 + c;
    if (gl_GlobalInvocationID.y >= p.tokens) return;
    x[at] += v[(p.scale_first >> 2) + c] * (g[at] + v[(p.bias_first >> 2) + c]);
}
