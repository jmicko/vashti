// Text encoder residual update from an INT8 product, one vec4 per invocation:
//   x[token][c] += sum[token][c] * activation scale[token] * weight scale[c]
// for live tokens. Dispatch x = width / 4 / 64, y = tokens.
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Stream { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Sums { ivec4 g[]; };
layout(set = 0, binding = 2) readonly buffer Scales { float as[]; };
layout(set = 0, binding = 3) readonly buffer Weights { vec4 ws[]; };
// `scale_first` is in values and a multiple of 4.
layout(push_constant) uniform Constants { uint tokens; uint width; uint scale_first; } p;

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint token = gl_GlobalInvocationID.y;
    uint width4 = p.width >> 2;
    if (token >= p.tokens || c >= width4) return;
    uint at = token * width4 + c;
    x[at] += vec4(g[at]) * as[token] * ws[(p.scale_first >> 2) + c];
}
