// Gathers the machine-code attention kernel's output for the video decoder (xe2/attend.rs),
// o[head][tile of 16 tokens][channel 0..128][token] with one weight sum per token and head,
// into half-float token rows of 32 heads x 64 channels, divided by the sum and written in
// the machine-code product's layout (see norm.comp). One vec4 per invocation; padded tokens
// are written as zeros.
// Dispatch: x = heads, y = padded tokens.
#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], 4459, 16);

layout(local_size_x = 16) in;
layout(set = 0, binding = 0) readonly buffer Mixed { float o[]; };
layout(set = 0, binding = 1) readonly buffer Sums { float w[]; };
layout(set = 0, binding = 2) writeonly buffer Out { f16vec4 h[]; };
layout(push_constant) uniform Constants { uint tokens; uint padded; } p;

void main() {
    uint head = gl_WorkGroupID.x;
    uint token = gl_WorkGroupID.y;
    uint c = gl_LocalInvocationIndex;
    uint tile = head * (p.padded >> 4) + (token >> 4);
    uint lane = token & 15;
    float scale = token < p.tokens ? 1.0 / w[tile * 16 + lane] : 0.0;
    uint from = (tile * 128 + c * 4) * 16 + lane;
    uint unit = head * 16 + c;
    uint at = (((token >> 5) * 128 + (unit >> 2)) * 32 + (token & 31)) * 4 + (unit & 3);
    h[at] = f16vec4(vec4(o[from], o[from + 16], o[from + 32], o[from + 48]) * scale);
}
