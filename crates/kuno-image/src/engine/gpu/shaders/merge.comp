// Gathers per-head attention output o[head][token][128] into f16 token rows
// h[token][head][64]: columns 0..64 are the weighted values and column 64 the weight sum
// they are divided by. Padded tokens are written as zeros. With `stream` set, the halves
// are written in the machine-code product's layout (see norm.comp).
#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], 4459, 16);

layout(local_size_x = 32) in;
layout(set = 0, binding = 0) readonly buffer Mixed { float o[]; };
layout(set = 0, binding = 1) writeonly buffer Half { float16_t h[]; };
layout(push_constant) uniform Constants { uint tokens; uint padded; uint stream; } p;

void main() {
    uint head = gl_GlobalInvocationID.x;
    uint token = gl_GlobalInvocationID.y;
    uint from = (head * p.padded + token) * 128;
    float scale = token < p.tokens ? 1.0 / o[from + 64] : 0.0;
    for (uint c = 0; c < 64; c++) {
        uint column = head * 64 + c;
        uint at = p.stream == 0 ? token * 2048 + column
            : (((token >> 5) * 128 + (column >> 4)) * 32 + (token & 31)) * 16 + (column & 15);
        h[at] = float16_t(o[from + c] * scale);
    }
}
