// Qwen Image 2.1 attention queries, keys and values from the INT8 query/key/value product
// (`gemm8`), for the fused attention kernel (fattend16.comp):
//   value = sum[token][part * 4096 + c] * activation scale[token] * weight scale[part][c]
// Queries and keys then take unit RMS over the head's 128 channels (eps 1e-6) times a
// weight and the rotary turn on neighbouring pairs (2i, 2i + 1); values are used as they
// are. Out: half floats `[head][stride][128]` (queries `query_stride` rows per head, keys
// and values `key_stride`), row = token. Padded queries are zeros; padded keys and values
// are not written. With `store` set, keys and values also go to the per-layer caches
// `[head][capacity][128]` at row `store_first + token` (live tokens only).
// A group of 16 invocations is one token, part and head; an invocation owns 8 channels.
// Dispatch: x = 3 * 32 heads / 4, y = padded tokens.
#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], 4459, 16);

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Sums { ivec4 g[]; };
layout(set = 0, binding = 1) readonly buffer Scales { float s[]; };
layout(set = 0, binding = 2) readonly buffer Vectors { vec4 v[]; };
layout(set = 0, binding = 3) readonly buffer Rotary { vec4 turn[]; };
layout(set = 0, binding = 4) writeonly buffer Queries { uvec4 q[]; };
layout(set = 0, binding = 5) writeonly buffer Keys { uvec4 k[]; };
layout(set = 0, binding = 6) writeonly buffer Values { uvec4 vs[]; };
layout(set = 0, binding = 7) writeonly buffer KeyCache { uvec4 ck[]; };
layout(set = 0, binding = 8) writeonly buffer ValueCache { uvec4 cv[]; };
// Vector offsets are in values and multiples of 4.
layout(push_constant) uniform Constants {
    uint tokens;
    uint query_stride;
    uint key_stride;
    uint query_norm;
    uint key_norm;
    uint weight_scales;
    uint store;
    uint store_first;
    uint capacity;
} p;
const uint HEADS = 32;
const uint DIM4 = 1024;

void main() {
    uint unit = gl_WorkGroupID.x * 4 + (gl_LocalInvocationIndex >> 4);
    uint part = unit / HEADS, head = unit % HEADS;
    uint lane = gl_LocalInvocationIndex & 15u;
    uint token = gl_WorkGroupID.y;
    bool live = token < p.tokens;
    if (!live && part != 0) return;
    uint c4 = part * DIM4 + head * 32 + lane * 2;
    float row = live ? s[token] : 0.0;
    vec4 mine[2];
    float squares = 0.0;
    for (uint j = 0; j < 2; j++) {
        mine[j] = live ? vec4(g[token * (3 * DIM4) + c4 + j]) * row
                * v[(p.weight_scales >> 2) + c4 + j]
            : vec4(0.0);
        squares += dot(mine[j], mine[j]);
    }
    uint words[4];
    if (part < 2) {
        float norm = 1.0 / sqrt(subgroupClusteredAdd(squares, 16) / 128.0 + 1e-6);
        uint weight = ((part == 0 ? p.query_norm : p.key_norm) >> 2) + lane * 2;
        for (uint j = 0; j < 2; j++) {
            vec4 a = mine[j] * (norm * v[weight + j]);
            vec4 t = live ? turn[token * 32 + lane * 2 + j] : vec4(1.0, 0.0, 1.0, 0.0);
            vec4 r = vec4(t.x * a.x - t.y * a.y, t.y * a.x + t.x * a.y,
                          t.z * a.z - t.w * a.w, t.w * a.z + t.z * a.w);
            words[j * 2] = packHalf2x16(r.xy);
            words[j * 2 + 1] = packHalf2x16(r.zw);
        }
    } else {
        for (uint j = 0; j < 2; j++) {
            words[j * 2] = packHalf2x16(mine[j].xy);
            words[j * 2 + 1] = packHalf2x16(mine[j].zw);
        }
    }
    uvec4 word = uvec4(words[0], words[1], words[2], words[3]);
    if (part == 0) {
        q[(head * p.query_stride + token) * 16 + lane] = word;
        return;
    }
    uint at = (head * p.key_stride + token) * 16 + lane;
    uint cache = (head * p.capacity + p.store_first + token) * 16 + lane;
    if (part == 1) {
        k[at] = word;
        if (p.store != 0) ck[cache] = word;
    } else {
        vs[at] = word;
        if (p.store != 0) cv[cache] = word;
    }
}
