// gemm8.comp for 32-lane subgroups and 16 x 32 int8 matrices (NVIDIA): the same product,
// buffers, constants and 128-token x 256-row tiling, laid out for these GPUs.
//   out[t][r] = sum_k in[t][k] * weight[r][k]      (int8 operands, exact int32 sums)
//
// 16 subgroups of 32 lanes each own 64 tokens x 32 rows as eight 16 x 16 accumulators. Each
// step takes 64 columns (two 32-column multiplies) through one shared buffer whose rows are
// padded from 64 to 80 bytes, so the 16 rows a matrix load reads fall in different banks;
// the next step's operands are fetched into registers while the current one multiplies.
// Columns are a multiple of 32; a last step of 32 skips its second multiply.
#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 512) in;
layout(set = 0, binding = 0) readonly buffer In { uvec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Weight { uvec4 w[]; };
layout(set = 0, binding = 2) writeonly buffer Out { int y[]; };
layout(push_constant) uniform Constants {
    uint columns;
    uint in_first;
    uint weight_first;
    uint out_first;
    uint out_stride;
} p;

// Row stride in words: four 16-byte words of data, one of padding.
#define STRIDE 5
shared uvec4 a[128 * STRIDE];
shared uvec4 b[256 * STRIDE];

#define A coopmat<int8_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseA>
#define B coopmat<int8_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB>
#define C coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

void main() {
    uint sg = gl_SubgroupID;
    uint lane = sg * 32 + gl_SubgroupInvocationID;
    uint am = (sg >> 3) * 64;
    uint bn = (sg & 7) * 32;
    uint token = gl_WorkGroupID.y * 128;
    uint row = gl_WorkGroupID.x * 256;
    uint cols16 = p.columns >> 4;
    // Lane copies: one word of the token tile (row lane / 4, word lane % 4) and two of the
    // weight tile (rows lane / 4 and 128 + lane / 4).
    uint r4 = lane >> 2, word = lane & 3;
    uint in16 = (p.in_first >> 4) + (token + r4) * cols16 + word;
    uint w16 = (p.weight_first >> 4) + (row + r4) * cols16 + word;
    uint w16b = w16 + 128 * cols16;
    uint sa = r4 * STRIDE + word, sb2 = (128 + r4) * STRIDE + word;
    C c[4][2];
    for (uint i = 0; i < 4; i++) {
        c[i][0] = C(0);
        c[i][1] = C(0);
    }
    A ma[4];
    B mb[2];
    bool live = word < cols16;
    uvec4 ta = live ? x[in16] : uvec4(0), tb = live ? w[w16] : uvec4(0);
    uvec4 tc = live ? w[w16b] : uvec4(0);
    for (uint k16 = 0; k16 < cols16; k16 += 4) {
        a[sa] = ta;
        b[sa] = tb;
        b[sb2] = tc;
        memoryBarrierShared();
        barrier();
        uint next = k16 + 4;
        if (next + word < cols16) {
            ta = x[in16 + next];
            tb = w[w16 + next];
            tc = w[w16b + next];
        }
        uint halves = min(2u, (cols16 - k16) >> 1);
        for (uint h = 0; h < halves; h++) {
            for (uint i = 0; i < 4; i++)
                coopMatLoad(ma[i], a, (am + i * 16) * STRIDE + h * 2, STRIDE,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0; j < 2; j++)
                coopMatLoad(mb[j], b, (bn + j * 16) * STRIDE + h * 2, STRIDE,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0; i < 4; i++)
                for (uint j = 0; j < 2; j++) c[i][j] = coopMatMulAdd(ma[i], mb[j], c[i][j]);
        }
        barrier();
    }
    uint first = p.out_first + (token + am) * p.out_stride + row + bn;
    uint s = p.out_stride;
    for (uint i = 0; i < 4; i++)
        for (uint j = 0; j < 2; j++)
            coopMatStore(c[i][j], y, first + i * 16 * s + j * 16, s,
                         gl_CooperativeMatrixLayoutRowMajor);
}
