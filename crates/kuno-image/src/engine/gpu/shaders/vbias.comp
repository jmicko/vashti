// Vision tower: a linear layer's bias and what follows it, from the product g[t][c] (row
// stride `g_stride`) for columns c < width:
//   mode 0: x[t][c] += g + bias           (residual, f32 stream; rows < count)
//   mode 1: h[t][c] = gelu_tanh(g + bias) (half floats, row stride `out_stride`)
//   mode 2: h[t][c] = gelu_erf(g + bias)
//   mode 3: x[t][c] = g + bias            (f32 output, row stride `out_stride`)
// Half-float rows from `count` up are zeros. Dispatch x = ceil(width / 256), y = rows.
#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer G { float g[]; };
layout(set = 0, binding = 1) readonly buffer Vectors { float v[]; };
layout(set = 0, binding = 2) buffer Stream { float x[]; };
layout(set = 0, binding = 3) writeonly buffer Half { float16_t h[]; };
layout(push_constant) uniform Constants {
    uint width;
    uint g_stride;
    uint out_stride;
    uint bias_first;
    uint count;
    uint mode;
} p;

// erf to float precision (Abramowitz-Stegun 7.1.26 is 1.5e-7 absolute, enough for f32).
float erf_(float z) {
    float a = abs(z);
    float t = 1.0 / (1.0 + 0.3275911 * a);
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-a * a);
    return sign(z) * y;
}

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint t = gl_WorkGroupID.y;
    if (c >= p.width) return;
    if (t >= p.count) {
        if (p.mode == 1 || p.mode == 2) h[t * p.out_stride + c] = float16_t(0.0);
        return;
    }
    float value = g[t * p.g_stride + c] + v[p.bias_first + c];
    if (p.mode == 0) {
        x[t * p.width + c] += value;
    } else if (p.mode == 3) {
        x[t * p.out_stride + c] = value;
    } else {
        float y;
        if (p.mode == 1) {
            float inner = 0.7978845608 * (value + 0.044715 * value * value * value);
            y = 0.5 * value * (1.0 + tanh(inner));
        } else {
            y = 0.5 * value * (1.0 + erf_(value * 0.7071067812));
        }
        h[t * p.out_stride + c] = float16_t(y);
    }
}
