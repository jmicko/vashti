// Qwen Image 2512: the gated residual alone (after the last block), one vec4 per invocation:
//   x[token][c] += (sum[token][c] * scale[token] * weight scale[c] + bias[c]) * gate[c]
// Dispatch: x = 768 / 64, y = padded tokens.
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Stream { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Sums { ivec4 g[]; };
layout(set = 0, binding = 2) readonly buffer Scales { float as[]; };
layout(set = 0, binding = 3) readonly buffer Vectors { vec4 ws[]; };
layout(set = 0, binding = 4) readonly buffer Mods { vec4 m[]; };
layout(push_constant) uniform Constants {
    uint tokens;
    uint scale_first;
    uint bias_first;
    uint gate_first;
} p;
const uint DIM4 = 768;

void main() {
    uint c = gl_GlobalInvocationID.x, token = gl_GlobalInvocationID.y;
    if (token >= p.tokens) return;
    uint at = token * DIM4 + c;
    vec4 update = vec4(g[at]) * as[token] * ws[(p.scale_first >> 2) + c]
        + ws[(p.bias_first >> 2) + c];
    x[at] += update * m[(p.gate_first >> 2) + c];
}
