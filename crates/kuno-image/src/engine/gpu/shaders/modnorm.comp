// DiT block input: RMS normalization of each 5376-wide token row of the f32 stream with a
// weight, then the token's time/modality modulation:
//   t = x / sqrt(mean(x^2) + 1e-5) * weight;   h = t + t * scale[row] + shift[row]
// `m` holds [rows][6][5376] modulation vectors; `r` the row of each token. Padded tokens are
// written as zeros. One workgroup per token; lanes read neighbouring vec4s.
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Stream { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Vectors { vec4 v[]; };
layout(set = 0, binding = 2) readonly buffer Parts { vec4 m[]; };
layout(set = 0, binding = 3) readonly buffer Rows { uint r[]; };
layout(set = 0, binding = 4) writeonly buffer Out { vec4 h[]; };
// `weight_first` is in values and a multiple of 4; `shift` and `scale` pick two of the six
// vectors.
layout(push_constant) uniform Constants { uint tokens; uint weight_first; uint shift; uint scale; } p;
const uint DIM4 = 1344;

shared float part[64];

void main() {
    uint token = gl_WorkGroupID.x;
    uint base = token * DIM4;
    uint lane = gl_LocalInvocationIndex;
    bool live = token < p.tokens;
    vec4 squares = vec4(0.0);
    for (uint j = 0; j < 21; j++) {
        vec4 d = x[base + lane + j * 64];
        squares += d * d;
    }
    part[lane] = squares.x + squares.y + squares.z + squares.w;
    memoryBarrierShared();
    barrier();
    float sum = 0.0;
    for (uint i = 0; i < 64; i++) sum += part[i];
    float norm = 1.0 / sqrt(sum / 5376.0 + 1e-5);
    uint row = live ? r[token] : 0;
    uint shift = (row * 6 + p.shift) * DIM4, scale = (row * 6 + p.scale) * DIM4;
    for (uint j = 0; j < 21; j++) {
        uint c = lane + j * 64;
        vec4 t = x[base + c] * (norm * v[(p.weight_first >> 2) + c]);
        t = t + t * m[scale + c] + m[shift + c];
        h[base + c] = live ? t : vec4(0.0);
    }
}
