// Matrix product for the half-precision linear layers, f32 accumulation:
//   out[t][r] = sum_k in[t][k] * weight[r][k]
// The plan is gemm8.comp's (see there): 128 x 256 tiles, eight accumulators per subgroup,
// operands requested one step ahead. A half-precision fragment covers 16 columns, which is
// the same 32 bytes per row and step as the integer kernel's 32, so the layout is identical.
// The caller pads tokens to a multiple of 128, rows to 256 and columns to 16, and keeps
// offsets multiples of 8 values.
#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_spirv_intrinsics : require

// Keep half-precision subnormals (tiny weights) instead of reading them as zero.
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], 4459, 16);

layout(local_size_x = 512) in;
layout(set = 0, binding = 0) readonly buffer In { uvec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Weight { uvec4 w[]; };
layout(set = 0, binding = 2) writeonly buffer Out { float y[]; };
// Offsets are in values; the half-precision ones are multiples of 8.
layout(push_constant) uniform Constants {
    uint columns;
    uint in_first;
    uint weight_first;
    uint out_first;
    uint out_stride;
} p;

// Per buffer: 128 tokens x 2 words, 256 rows x 2 words.
shared uvec4 a[512];
shared uvec4 b[1024];

#define A coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA>
#define B coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define C coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

void main() {
    uint sg = gl_SubgroupID;
    uint lane = sg * 16 + gl_SubgroupInvocationID;
    uint am = (sg >> 3) * 32;
    uint bn = (sg & 7) * 32;
    uint token = gl_WorkGroupID.y * 128;
    uint row = gl_WorkGroupID.x * 256;
    uint cols16 = p.columns >> 3;
    // Every lane copies one word of a weight row per step; the first 256 also one word of a
    // token row.
    bool copies = lane < 256;
    uint in16 = (p.in_first >> 3) + (token + (lane >> 1)) * cols16 + (lane & 1);
    uint weight16 = (p.weight_first >> 3) + (row + (lane >> 1)) * cols16 + (lane & 1);
    uvec4 ta, tb;
    A a0, a1, a2, a3;
    B b0, b1;
    C c00 = C(0.0), c01 = C(0.0), c10 = C(0.0), c11 = C(0.0);
    C c20 = C(0.0), c21 = C(0.0), c30 = C(0.0), c31 = C(0.0);
    if (copies) {
        a[lane] = x[in16];
    }
    b[lane] = w[weight16];
    memoryBarrierShared();
    barrier();
    uint cur = 0;
    for (uint k = 0; k < p.columns; k += 16) {
        uint next = 1 - cur;
        bool more = k + 16 < p.columns;
        uint k16 = (k + 16) >> 3;
        if (more) {
            if (copies) {
                ta = x[in16 + k16];
            }
            tb = w[weight16 + k16];
        }
        uint aa = cur * 256 + am * 2;
        uint bb = cur * 512 + bn * 2;
        coopMatLoad(a0, a, aa, 2, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(a1, a, aa + 16, 2, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(a2, a, aa + 32, 2, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(a3, a, aa + 48, 2, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b0, b, bb, 2, gl_CooperativeMatrixLayoutColumnMajor);
        coopMatLoad(b1, b, bb + 32, 2, gl_CooperativeMatrixLayoutColumnMajor);
        c00 = coopMatMulAdd(a0, b0, c00);
        c10 = coopMatMulAdd(a1, b0, c10);
        c20 = coopMatMulAdd(a2, b0, c20);
        c30 = coopMatMulAdd(a3, b0, c30);
        c01 = coopMatMulAdd(a0, b1, c01);
        c11 = coopMatMulAdd(a1, b1, c11);
        c21 = coopMatMulAdd(a2, b1, c21);
        c31 = coopMatMulAdd(a3, b1, c31);
        if (more) {
            if (copies) {
                a[next * 256 + lane] = ta;
            }
            b[next * 512 + lane] = tb;
        }
        memoryBarrierShared();
        barrier();
        cur = next;
    }
    uint first = p.out_first + (token + am) * p.out_stride + row + bn;
    uint s = p.out_stride;
    coopMatStore(c00, y, first, s, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(c01, y, first + 16, s, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(c10, y, first + 8 * s, s, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(c11, y, first + 8 * s + 16, s, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(c20, y, first + 16 * s, s, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(c21, y, first + 16 * s + 16, s, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(c30, y, first + 24 * s, s, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(c31, y, first + 24 * s + 16, s, gl_CooperativeMatrixLayoutRowMajor);
}
