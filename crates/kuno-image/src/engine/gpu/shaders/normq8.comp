// DiT block input and its quantization in one pass over the stream: RMS normalization of
// each 5376-wide token row with a weight and the token's time/modality modulation, then
// the ConvRot quantizer (rotate8.comp) on the result, which is never written out. One workgroup per token. The row is read once into shared memory, each group
// of 256 values is normalized and rotated in place there, and the rounding pass reads the
// rotated values back.
//   t = x / sqrt(mean(x^2) + 1e-5) * weight;   h = t + t * scale[row] + shift[row]
// `m` holds [rows][6][5376] modulation vectors; `r` the row of each token. Padded tokens
// quantize to zeros. With `stream` set, bytes are written in the machine-code product's
// layout (xe2/int8.rs).
#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Stream { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Vectors { vec4 w[]; };
layout(set = 0, binding = 2) readonly buffer Parts { vec4 m[]; };
layout(set = 0, binding = 3) readonly buffer Rows { uint rows[]; };
layout(set = 0, binding = 4) writeonly buffer Out { uvec4 q[]; };
layout(set = 0, binding = 5) writeonly buffer Scales { float s[]; };
// `weight_first` and `parts_first` (this block's vectors in `m`) are in values and multiples
// of 4; `shift` and `scale` pick two of the six vectors.
layout(push_constant) uniform Constants {
    uint tokens;
    uint weight_first;
    uint shift;
    uint scale;
    uint parts_first;
    uint stream;
} p;
const uint DIM4 = 1344;
const uint GROUPS = 21;
const uint ROUNDS = 2;

shared float mem[5376];
shared float maxima[16];

float norm;
uint shift_at, scale_at;
bool live;

vec4 source(uint c) {
    vec4 t = vec4(mem[c * 4], mem[c * 4 + 1], mem[c * 4 + 2], mem[c * 4 + 3]);
    t *= norm * w[(p.weight_first >> 2) + c];
    t = t + t * m[scale_at + c] + m[shift_at + c];
    return live ? t : vec4(0.0);
}

float v[16];

void quad(uint a, uint b, uint c, uint d) {
    precise float va = v[a], vb = v[b], vc = v[c], vd = v[d];
    precise float ra = va + vb + vc - vd;
    precise float rb = va + vb - vc + vd;
    precise float rc = va - vb + vc + vd;
    precise float rd = -va + vb + vc + vd;
    v[a] = ra;
    v[b] = rb;
    v[c] = rc;
    v[d] = rd;
}
void stages() {
    for (uint m = 0; m < 4; m++) quad(4 * m, 4 * m + 1, 4 * m + 2, 4 * m + 3);
    for (uint m = 0; m < 4; m++) quad(m, m + 4, m + 8, m + 12);
}

// Rotates the row into `mem` in natural order and returns the row's largest magnitude.
// The first stages' results pass through the group's own slots of `mem` to be transposed.
float rotate_row() {
    uint sg = gl_SubgroupID, lane = gl_SubgroupInvocationID;
    float top = 0.0;
    for (uint r = 0; r < ROUNDS; r++) {
        uint g = r * 16 + sg;
        bool used = g < GROUPS;
        if (used) {
            for (uint j = 0; j < 4; j++) {
                vec4 part = source(g * 64 + lane * 4 + j);
                for (uint e = 0; e < 4; e++) v[j * 4 + e] = part[e] * 0.0625;
            }
            stages();
            for (uint j = 0; j < 16; j++) mem[g * 256 + lane * 16 + j] = v[j];
        }
        memoryBarrierShared();
        barrier();
        if (used) {
            for (uint j = 0; j < 16; j++) v[j] = mem[g * 256 + j * 16 + lane];
        }
        memoryBarrierShared();
        barrier();
        if (used) {
            stages();
            for (uint j = 0; j < 16; j++) {
                top = max(top, abs(v[j]));
                mem[g * 256 + j * 16 + lane] = v[j];
            }
        }
    }
    top = subgroupMax(top);
    if (lane == 0) maxima[sg] = top;
    memoryBarrierShared();
    barrier();
    for (uint i = 0; i < 16; i++) top = max(top, maxima[i]);
    return top;
}

// Rounds the rotated row to INT8 with one scale and writes 16 bytes per lane and group.
void round_row(uint row, float top, uint stream) {
    uint sg = gl_SubgroupID, lane = gl_SubgroupInvocationID;
    // The GPU's single-precision divide is not correctly rounded; a last-bit difference in
    // the scale would move bytes at rounding ties. Dividing in double precision and rounding
    // once gives the reference's values.
    float scale = float(double(top) / 127.0lf);
    float inverse = float(1.0lf / double(scale));
    if (gl_LocalInvocationIndex == 0) s[row] = scale;
    for (uint r = 0; r < ROUNDS; r++) {
        uint g = r * 16 + sg;
        if (g >= GROUPS) continue;
        uvec4 word = uvec4(0);
        for (uint b = 0; b < 16; b++) {
            precise float scaled = mem[g * 256 + lane * 16 + b] * inverse;
            int value = scale == 0.0 ? 0 : int(clamp(roundEven(scaled), -127.0, 127.0));
            word[b >> 2] |= (uint(value) & 255u) << ((b & 3) * 8);
        }
        uint w16 = g * 16 + lane;
        uint at = stream == 0 ? row * (GROUPS * 16) + w16
            : (((row >> 5) * (GROUPS * 8) + (w16 >> 1)) * 32 + (row & 31)) * 2 + (w16 & 1);
        q[at] = word;
    }
}

void main() {
    uint token = gl_WorkGroupID.x;
    uint sg = gl_SubgroupID, lane = gl_SubgroupInvocationID;
    uint slot = sg * 16 + lane;
    live = token < p.tokens;
    vec4 squares = vec4(0.0);
    for (uint c = slot; c < DIM4; c += 256) {
        vec4 d = x[token * DIM4 + c];
        squares += d * d;
        for (uint e = 0; e < 4; e++) mem[c * 4 + e] = d[e];
    }
    float sum = subgroupAdd(squares.x + squares.y + squares.z + squares.w);
    if (lane == 0) maxima[sg] = sum;
    memoryBarrierShared();
    barrier();
    sum = 0.0;
    for (uint i = 0; i < 16; i++) sum += maxima[i];
    norm = 1.0 / sqrt(sum / 5376.0 + 1e-5);
    uint row = live ? rows[token] : 0;
    uint first = p.parts_first >> 2;
    shift_at = first + (row * 6 + p.shift) * DIM4;
    scale_at = first + (row * 6 + p.scale) * DIM4;
    // Everyone has read the sums before the maxima reuse their slots.
    memoryBarrierShared();
    barrier();
    float top = rotate_row();
    round_row(token, top, p.stream);
}
