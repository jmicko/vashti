// Qwen Image 2512 output head: LayerNorm (no weights, eps 1e-6) of each image row, then
// `x * (1 + scale) + shift` (AdaLayerNormContinuous: `mods` holds the scale, then the shift),
// then `proj_out` (64 x 3072) with bias: out[token][64]. One workgroup per token; each group
// of 16 invocations makes 4 outputs. Dispatch: x = live tokens.
#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require

#define SG16 (gl_LocalInvocationIndex >> 4)
#define LANE16 (gl_LocalInvocationIndex & 15u)

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Stream { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Mods { vec4 mods[]; };
layout(set = 0, binding = 2) readonly buffer Weight { vec4 weight[]; };
layout(set = 0, binding = 3) readonly buffer Bias { float bias[]; };
layout(set = 0, binding = 4) writeonly buffer Out { float out_[]; };
layout(push_constant) uniform Constants { uint tokens; } p;
const uint DIM4 = 768;

shared vec4 mem[DIM4];
shared float part[16];

float reduce(float value) {
    float sum = subgroupClusteredAdd(value, 16);
    memoryBarrierShared();
    barrier();
    if (LANE16 == 0) part[SG16] = sum;
    memoryBarrierShared();
    barrier();
    sum = 0.0;
    for (uint i = 0; i < 16; i++) sum += part[i];
    return sum;
}

void main() {
    uint token = gl_WorkGroupID.x, lane = gl_LocalInvocationIndex;
    vec4 total = vec4(0.0);
    for (uint c = lane; c < DIM4; c += 256) {
        vec4 d = x[token * DIM4 + c];
        mem[c] = d;
        total += d;
    }
    float mean = reduce(total.x + total.y + total.z + total.w) / 3072.0;
    vec4 squares = vec4(0.0);
    for (uint c = lane; c < DIM4; c += 256) {
        vec4 d = mem[c] - mean;
        squares += d * d;
    }
    float inv = 1.0 / sqrt(reduce(squares.x + squares.y + squares.z + squares.w) / 3072.0 + 1e-6);
    memoryBarrierShared();
    barrier();
    for (uint c = lane; c < DIM4; c += 256)
        mem[c] = (mem[c] - mean) * inv * (1.0 + mods[c]) + mods[DIM4 + c];
    memoryBarrierShared();
    barrier();
    for (uint k = 0; k < 4; k++) {
        uint o = SG16 * 4 + k;
        float sum = 0.0;
        for (uint c = LANE16; c < DIM4; c += 16) sum += dot(mem[c], weight[o * DIM4 + c]);
        sum = subgroupClusteredAdd(sum, 16);
        if (LANE16 == 0 && token < p.tokens) out_[token * 64 + o] = sum + bias[o];
    }
}
