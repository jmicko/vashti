// Vision tower attention output o[head][channel][t] (f32, 128 channel rows of `padded`
// tokens per head, 72 live) gathered into half-float rows h[t][head * 72 + c] for the
// output projection. Tokens from `count` up are zeros. Dispatch x = ceil(1152 / 128) = 9,
// y = padded tokens.
#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer O { float o[]; };
layout(set = 0, binding = 1) writeonly buffer H { float16_t h[]; };
layout(push_constant) uniform Constants { uint count; uint padded; } p;

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint t = gl_WorkGroupID.y;
    if (c >= 1152) return;
    uint hd = c / 72;
    uint ch = c - hd * 72;
    h[t * 1152 + c] = float16_t(t < p.count ? o[(hd * 128 + ch) * p.padded + t] : 0.0);
}
