// Qwen Image 2.1 feed-forward activation from the INT8 gate/up product (`gemm8`):
//   u = sum[token][c] * scale[token] * weight scale[c], w likewise at column 12288 + c,
//   h[token][c] = silu(u) * w      as bf16 (rounded to nearest even), for qhidq8.comp.
// Padded tokens give zeros. Dispatch: x = 12288 / 4 / 64, y = padded tokens.
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Sums { ivec4 g[]; };
layout(set = 0, binding = 1) readonly buffer Scales { float s[]; };
layout(set = 0, binding = 2) readonly buffer Vectors { vec4 ws[]; };
layout(set = 0, binding = 3) writeonly buffer Hidden { uvec2 h[]; };
layout(push_constant) uniform Constants { uint tokens; uint scale_first; } p;
const uint HIDDEN4 = 3072;

uint bf16(float x) {
    uint b = floatBitsToUint(x);
    return (b + 0x7fffu + ((b >> 16) & 1u)) >> 16;
}

void main() {
    uint c = gl_GlobalInvocationID.x, token = gl_WorkGroupID.y;
    vec4 out_ = vec4(0.0);
    if (token < p.tokens) {
        float row = s[token];
        uint scale = p.scale_first >> 2;
        vec4 u = vec4(g[token * 2 * HIDDEN4 + c]) * row * ws[scale + c];
        vec4 w = vec4(g[token * 2 * HIDDEN4 + HIDDEN4 + c]) * row * ws[scale + HIDDEN4 + c];
        out_ = u / (1.0 + exp(-u)) * w;
    }
    h[token * HIDDEN4 + c] = uvec2(bf16(out_.x) | (bf16(out_.y) << 16),
                                   bf16(out_.z) | (bf16(out_.w) << 16));
}
