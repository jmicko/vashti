// Qwen Image 2.1 attention queries or keys from the INT8 query/key/value product:
//   g[token][query 4096, key 4096, value 4096] (int32 sums), each [head][128]
//   value = sum * activation scale[token] * weight scale[column]
// then unit RMS over the head's 128 channels (eps 1e-6) times a weight, then the rotary
// turn on neighbouring pairs (2i, 2i + 1), 64 per head.
//   out: half floats in the machine-code attention kernel's stream layouts (xe2/attend.rs):
//   queries by tile of 16 (`stride` padded queries per head), keys by chunk of 16 inside
//   the key/value stream (`stride` padded keys per head). Padded queries are zeros; keys
//   are written for live tokens only (the stream holds other keys after them).
// With `store` set (keys only), each key also goes to the plain per-layer cache
// `[head][capacity][128]` f16 at row `store_first + token`.
// One subgroup of 16 lanes is one token and head; a lane owns 8 neighbouring channels.
// Dispatch: x = heads / 4, y = padded tokens; `side` is 0 for queries, 1 for keys.
#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], 4459, 16);

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Sums { ivec4 g[]; };
layout(set = 0, binding = 1) readonly buffer Scales { float as[]; };
layout(set = 0, binding = 2) readonly buffer Vectors { vec4 v[]; };
layout(set = 0, binding = 3) readonly buffer Rotary { vec4 turn[]; };
// Two half floats per word.
layout(set = 0, binding = 4) writeonly buffer Out { uint o[]; };
layout(set = 0, binding = 5) writeonly buffer Store { uvec4 cache[]; };
// Offsets are in values and multiples of 4.
layout(push_constant) uniform Constants {
    uint tokens;
    uint stride;
    uint side;
    uint scale_first;
    uint weight_first;
    uint store;
    uint store_first;
    uint capacity;
} p;
const uint DIM4 = 1024;

void main() {
    uint head = gl_WorkGroupID.x * 4 + gl_SubgroupID;
    uint token = gl_WorkGroupID.y;
    uint lane = gl_SubgroupInvocationID;
    bool live = token < p.tokens;
    if (!live && p.side == 1) return;
    float row_scale = live ? as[token] : 0.0;
    uint from = token * (3 * DIM4) + p.side * DIM4 + head * 32 + lane * 2;
    uint scales = (p.scale_first >> 2) + p.side * DIM4 + head * 32 + lane * 2;
    vec4 mine[2];
    float squares = 0.0;
    for (uint j = 0; j < 2; j++) {
        mine[j] = vec4(g[from + j]) * row_scale * v[scales + j];
        squares += dot(mine[j], mine[j]);
    }
    float norm = 1.0 / sqrt(subgroupAdd(squares) / 128.0 + 1e-6);
    uint tiles = p.stride >> 4;
    // Words: a query tile is 1024, a key chunk (keys, then values) 2048.
    uint to = p.side == 0
        ? (head * tiles + (token >> 4)) * 1024 + (lane >> 1) * 128 + (lane & 1) * 64 + (token & 15)
        : (head * tiles + (token >> 4)) * 2048 + (lane >> 1) * 128 + (token & 15) * 8 + (lane & 1) * 4;
    uint pair = p.side == 0 ? 16 : 1;
    uint words[4];
    for (uint j = 0; j < 2; j++) {
        vec4 a = mine[j] * (norm * v[(p.weight_first >> 2) + lane * 2 + j]);
        // Cosine and sine of this vec4's two pairs.
        vec4 t = live ? turn[token * 32 + lane * 2 + j] : vec4(1.0, 0.0, 1.0, 0.0);
        vec4 result = vec4(
            t.x * a.x - t.y * a.y, t.y * a.x + t.x * a.y,
            t.z * a.z - t.w * a.w, t.w * a.z + t.z * a.w);
        words[j * 2] = packHalf2x16(result.xy);
        words[j * 2 + 1] = packHalf2x16(result.zw);
        o[to + (j * 2) * pair] = words[j * 2];
        o[to + (j * 2 + 1) * pair] = words[j * 2 + 1];
    }
    if (p.store != 0) {
        cache[((head * p.capacity) + p.store_first + token) * 16 + lane] =
            uvec4(words[0], words[1], words[2], words[3]);
    }
}
