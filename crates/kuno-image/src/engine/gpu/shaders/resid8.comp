// Gated residual update of the DiT stream from an INT8 product, one vec4 per invocation:
//   x[token][c] += sum[token][c] * activation scale[token] * weight scale[c] * gate[row][c]
// for live tokens. `m` holds [rows][6][5376] modulation vectors; `r` the row of each token.
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Stream { vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer Sums { ivec4 g[]; };
layout(set = 0, binding = 2) readonly buffer Scales { float as[]; };
layout(set = 0, binding = 3) readonly buffer Vectors { vec4 v[]; };
layout(set = 0, binding = 4) readonly buffer Parts { vec4 m[]; };
layout(set = 0, binding = 5) readonly buffer Rows { uint r[]; };
// `scale_first` and `parts_first` (this block's vectors in `m`) are in values and multiples
// of 4; `gate` picks one of the six vectors.
layout(push_constant) uniform Constants { uint tokens; uint scale_first; uint gate; uint parts_first; } p;
const uint DIM4 = 1344;

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint token = gl_GlobalInvocationID.y;
    if (token >= p.tokens) return;
    uint at = token * DIM4 + c;
    vec4 update = vec4(g[at]) * as[token] * v[(p.scale_first >> 2) + c];
    x[at] += update * m[(p.parts_first >> 2) + (r[token] * 6 + p.gate) * DIM4 + c];
}
