// Largest value of each row:  top[z][row] = max of s[z][row][..columns]
// Rows hold `stride` values (a multiple of 4), of which the first `columns` count; `scoremax`
// already left out padded keys. One invocation per row.
// Dispatch: x = rows per z / 64, z = batch.
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Scores { vec4 s[]; };
layout(set = 0, binding = 1) writeonly buffer Top { float top[]; };
// `padded` is the rows per z; `top_first` the first row's index in `top`.
layout(push_constant) uniform Constants { uint columns; uint stride; uint padded; uint top_first; } p;

void main() {
    uint row = gl_GlobalInvocationID.z * p.padded + gl_GlobalInvocationID.x;
    uint words = p.stride >> 2;
    vec4 best = vec4(-3.0e38);
    for (uint c = 0; c < words; c++) {
        bvec4 live = lessThan(uvec4(c * 4) + uvec4(0, 1, 2, 3), uvec4(p.columns));
        best = max(best, mix(vec4(-3.0e38), s[row * words + c], live));
    }
    top[p.top_first + row] = max(max(best.x, best.y), max(best.z, best.w));
}
