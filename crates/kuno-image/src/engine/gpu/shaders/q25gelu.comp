// Qwen Image 2512 feed-forward activation from the INT8 input product (`gemm8`):
//   h[token][c] = gelu(sum[token][c] * scale[token] * weight scale[c] + bias[c])
// (tanh form) as bf16 rounded to nearest even, the rows `qhidq8.comp` quantizes. Padded
// tokens give zeros. Dispatch: x = 12288 / 4 / 64, y = padded tokens.
#version 460
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Sums { ivec4 g[]; };
layout(set = 0, binding = 1) readonly buffer Scales { float s[]; };
layout(set = 0, binding = 2) readonly buffer Vectors { vec4 ws[]; };
layout(set = 0, binding = 3) writeonly buffer Hidden { uvec2 h[]; };
layout(push_constant) uniform Constants { uint tokens; uint scale_first; uint bias_first; } p;
const uint HIDDEN4 = 3072;

uint bf16(float x) {
    uint b = floatBitsToUint(x);
    return (b + 0x7fffu + ((b >> 16) & 1u)) >> 16;
}
vec4 gelu(vec4 v) {
    return 0.5 * v * (1.0 + tanh(0.7978846 * (v + 0.044715 * v * v * v)));
}

void main() {
    uint c = gl_GlobalInvocationID.x, token = gl_WorkGroupID.y;
    vec4 out_ = vec4(0.0);
    if (token < p.tokens) {
        vec4 pre = vec4(g[token * HIDDEN4 + c]) * s[token] * ws[(p.scale_first >> 2) + c]
            + ws[(p.bias_first >> 2) + c];
        out_ = gelu(pre);
    }
    h[token * HIDDEN4 + c] = uvec2(bf16(out_.x) | (bf16(out_.y) << 16),
                                   bf16(out_.z) | (bf16(out_.w) << 16));
}
