// Text encoder causal attention with grouped keys and values (`heads` query heads sharing
// each of the key/value heads in groups of `group`), f32 with an online softmax:
//   out[t][h * 128 + c] = sum_{s <= t} softmax_s(q[h][t] . k[h / group][s] / sqrt(128)) v[h / group][s][c]
// One subgroup of 16 lanes per query and head; a lane owns 8 neighbouring channels.
// Dispatch x = padded tokens / 4, y = query heads. Tokens from `tokens` on are zeros.
#version 460
#extension GL_GOOGLE_include_directive : require
#define REDUCE(x) subgroupAdd(x)
#include "tattend.glsl"
