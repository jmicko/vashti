// Video encoder: adds a convolution's bias, and with `add` the residual already in `out`:
//   out[c][q] = y[c][q] + bias[c] (+ out[c][q]), for q < count (row stride `stride`).
// Dispatch x = ceil(count / 256), y = channels.
#version 460

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Y { float y[]; };
layout(set = 0, binding = 1) readonly buffer Vectors { float v[]; };
layout(set = 0, binding = 2) buffer Out { float o[]; };
layout(push_constant) uniform Constants { uint count; uint stride; uint bias_first; uint add; } p;

void main() {
    uint q = gl_GlobalInvocationID.x;
    uint c = gl_WorkGroupID.y;
    if (q >= p.count) return;
    uint i = c * p.stride + q;
    float value = y[i] + v[p.bias_first + c];
    o[i] = p.add != 0 ? o[i] + value : value;
}
