// Unnormalized attention weights, one vec4 per invocation:
//   w[head][query][key] = exp(score / 8) for live keys, 0 for padded keys.
// Queries and keys have unit RMS over 64 channels, so score / 8 lies in -8..8 and the
// weights (0.0003 to 2981) are normal f16 values without subtracting a row maximum. The row
// sum comes out of the mixing product itself (see `heads` and `merge`).
#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], 4459, 16);

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Scores { vec4 s[]; };
layout(set = 0, binding = 1) writeonly buffer Weights { f16vec4 w[]; };
layout(push_constant) uniform Constants { uint tokens; uint padded; } p;

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= (p.padded >> 2)) return;
    uint at = (gl_GlobalInvocationID.z * p.padded + gl_GlobalInvocationID.y) * (p.padded >> 2) + c;
    bvec4 keep = lessThan(uvec4(c * 4) + uvec4(0, 1, 2, 3), uvec4(p.tokens));
    w[at] = f16vec4(mix(vec4(0.0), exp(s[at] * 0.125), keep));
}
