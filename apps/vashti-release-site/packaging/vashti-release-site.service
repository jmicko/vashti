[Unit]
Description=Vashti release site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vashti-release
Group=vashti-release
StateDirectory=vashti-release-site
WorkingDirectory=/var/lib/vashti-release-site
Environment=VASHTI_RELEASE_DATA_DIR=/var/lib/vashti-release-site
Environment=VASHTI_RELEASE_BIND=127.0.0.1:7781
ExecStart=/usr/local/bin/vashti-release-site
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/vashti-release-site

[Install]
WantedBy=multi-user.target
