+    HostCachePipeline::~HostCachePipeline() {
+        if (transfer_) ggml_backend_synchronize(transfer_);
+        if (enabled_) {
+            ggml_backend_synchronize(compute_);
+            for (auto& segment : inputs_) for (auto& input : segment) {
+                input.tensor->buffer = nullptr;
+                input.tensor->data = nullptr;
+                input.tensor->extra = nullptr;
+                uploads_[input.tensor] = input.source;
+            }
+        }
+        for (int slot = 0; slot < 2; ++slot) {
+            if (ready_[slot]) ggml_backend_event_free(ready_[slot]);
+            ggml_backend_buffer_free(buffers_[slot]);
+        }
+        if (transfer_) ggml_backend_free(transfer_);
+        resident_bytes_ = 0;
+    }
+
+    void HostCachePipeline::enqueue(size_t index) {
+        if (!enabled_ || index >= inputs_.size() || queued_[index]) return;
+        for (const auto& input : inputs_[index]) {
+            ggml_backend_tensor_set_async(transfer_, input.tensor, input.source, 0, ggml_nbytes(input.tensor));
+        }
+        ggml_backend_event_record(ready_[index % 2], transfer_);
+        queued_[index] = true;
+    }
+
+    void HostCachePipeline::wait(size_t index) {
+        if (!enabled_) return;
+        enqueue(index);
+        ggml_backend_event_wait(compute_, ready_[index % 2]);
+    }
