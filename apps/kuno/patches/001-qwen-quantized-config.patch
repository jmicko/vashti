diff --git a/src/core/params_buffer_type.h b/src/core/params_buffer_type.h
new file mode 100644
index 0000000..5034739
--- /dev/null
+++ b/src/core/params_buffer_type.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstring>
+
+#include "ggml-backend.h"
+
+// Select storage without allocating it or initializing another backend. Keep
+// this policy separate from operation compatibility and compute staging.
+inline ggml_backend_buffer_type_t sd_params_buffer_type(ggml_backend_t compute_backend,
+                                                       ggml_backend_t params_backend,
+                                                       ggml_backend_buffer_type_t split_buffer_type) {
+    if (params_backend == nullptr) return nullptr;
+
+    ggml_backend_buffer_type_t result = nullptr;
+    if (compute_backend != nullptr && params_backend != compute_backend) {
+        auto compute_device = ggml_backend_get_device(compute_backend);
+        auto params_device = ggml_backend_get_device(params_backend);
+        auto compute_registry = compute_device != nullptr ? ggml_backend_dev_backend_reg(compute_device) : nullptr;
+        const char* compute_registry_name = compute_registry != nullptr ? ggml_backend_reg_name(compute_registry) : nullptr;
+        if (params_device != nullptr && ggml_backend_dev_type(params_device) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+            compute_registry_name != nullptr && std::strcmp(compute_registry_name, "Vulkan") == 0) {
+            // Vulkan_Host uses Vulkan device zero and can select host-visible
+            // device-local memory. CPU params must use ordinary RAM, separate
+            // from the explicitly budgeted Vulkan compute staging buffers.
+            result = ggml_backend_cpu_buffer_type();
+        } else if (compute_device != nullptr) {
+            result = ggml_backend_dev_host_buffer_type(compute_device);
+        }
+    } else if (params_backend == compute_backend) {
+        result = split_buffer_type;
+    }
+    return result != nullptr ? result : ggml_backend_get_default_buffer_type(params_backend);
+}
