diff --git a/src/model_io/int8_dense.h b/src/model_io/int8_dense.h
new file mode 100644
index 0000000..b7a7378
--- /dev/null
+++ b/src/model_io/int8_dense.h
@@ -0,0 +1,80 @@
+#ifndef SD_INT8_DENSE_H
+#define SD_INT8_DENSE_H
+
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "model_io/tensor_storage.h"
+
+// Internal experiment only. Never infer this policy from the global wtype.
+inline bool qwen_mlp_f16_experiment_enabled() {
+    const char* value = std::getenv("KUNO_EXPERIMENTAL_QWEN_MLP_F16");
+    return value != nullptr && std::strcmp(value, "1") == 0;
+}
+
+inline bool qwen_mlp_f16_name(const std::string& name) {
+    const std::string prefix = "model.diffusion_model.transformer_blocks.";
+    if (name.compare(0, prefix.size(), prefix) != 0) return false;
+    size_t i = prefix.size(), begin = i;
+    while (i < name.size() && name[i] >= '0' && name[i] <= '9') ++i;
+    return i > begin && (name.substr(i) == ".img_mlp.gate_up.weight" ||
+                        name.substr(i) == ".img_mlp.out.weight");
+}
+
+inline bool qwen_mlp_f16_selected(const TensorStorage& storage) {
+    return storage.type == GGML_TYPE_I8 && storage.is_int8_tensorwise &&
+           storage.expected_type == GGML_TYPE_F16 && qwen_mlp_f16_name(storage.name);
+}
+
+inline bool int8_dense_shape_valid(const TensorStorage& storage) {
+    if (storage.type != GGML_TYPE_I8 || !storage.is_int8_tensorwise ||
+        !storage.int8_convrot || storage.n_dims != 2 || storage.ne[0] <= 0 || storage.ne[1] <= 0 ||
+        storage.ne[2] != 1 || storage.ne[3] != 1 || storage.ne[4] != 1) return false;
+    int group = storage.int8_convrot_group_size;
+    if (group < 4 || group > storage.ne[0] || storage.ne[0] % group != 0) return false;
+    while (group > 1 && group % 4 == 0) group /= 4;
+    return group == 1 && static_cast<uint64_t>(storage.ne[0]) <=
+                            SIZE_MAX / sizeof(ggml_fp16_t) / static_cast<uint64_t>(storage.ne[1]);
+}
+
+inline bool int8_dense_scales_valid(const std::vector<float>& scales, int64_t rows) {
+    if (rows <= 0 || (scales.size() != 1 && scales.size() != static_cast<uint64_t>(rows))) return false;
+    for (float scale : scales) if (!std::isfinite(scale) || scale < 0.f) return false;
+    return true;
+}
+
+// Fold each row's scale, then invert the symmetric normalized H4 tensor powers.
+// Only one FP32 row is temporary; never expand the complete weight to FP32.
+inline bool dequantize_int8_convrot_f16(const TensorStorage& storage, const int8_t* input,
+                                      ggml_fp16_t* output, const std::vector<float>& scales) {
+    if (!input || !output || !int8_dense_shape_valid(storage) ||
+        !int8_dense_scales_valid(scales, storage.ne[1])) return false;
+    const int64_t columns = storage.ne[0];
+    const int group = storage.int8_convrot_group_size;
+    std::vector<float> row(static_cast<size_t>(columns));
+    for (int64_t r = 0; r < storage.ne[1]; ++r) {
+        const float scale = scales[scales.size() == 1 ? 0 : r];
+        for (int64_t k = 0; k < columns; ++k) row[k] = input[r * columns + k] * scale;
+        for (int64_t base = 0; base < columns; base += group) {
+            for (int64_t stride = 1; stride < group; stride *= 4) {
+                for (int64_t block = 0; block < group; block += 4 * stride) {
+                    for (int64_t k = 0; k < stride; ++k) {
+                        float* v = row.data() + base + block + k;
+                        const float a = v[0], b = v[stride], c = v[2 * stride], d = v[3 * stride];
+                        v[0] = (a + b + c - d) * .5f;
+                        v[stride] = (a + b - c + d) * .5f;
+                        v[2 * stride] = (a - b + c + d) * .5f;
+                        v[3 * stride] = (-a + b + c + d) * .5f;
+                    }
+                }
+            }
+        }
+        for (float value : row) if (!std::isfinite(value) || std::fabs(value) > 65504.f) return false;
+        ggml_fp32_to_fp16_row(row.data(), output + r * columns, columns);
+    }
+    return true;
+}
+
+#endif
