@@ -0,0 +1,544 @@
+// Kuno: exact fusions for MiniMax H3 DiT graph patterns. Included by ggml-sycl.cpp only.
+#pragma once
+
+// ---------------------------------------------------------------------------
+// Partial RoPE: Rope::apply_rope(slice(x, 0, R), pe, interleaved=false) concatenated
+// with attention_layout(slice(x, R, D)) (MiniMax H3 apply_partial_rope). The 29-node
+// chain (VIEW .. CONCAT) becomes one kernel writing the [D, L, H] attention layout:
+//   out[a + k*R/2] = x[a] * pe[k,a,t,0] + x[a + R/2] * pe[k,a,t,1]   (d < R)
+//   out[d]         = x[d]                                            (d >= R)
+// The two products are rounded separately and then added, as in the MUL/MUL/ADD graph.
+// ---------------------------------------------------------------------------
+struct kuno_minimax_rope_match {
+    ggml_tensor * x = nullptr;     // [D, H, L, 1] normalized q or k (contiguous f32)
+    ggml_tensor * pe = nullptr;    // [2, R/2, L, 2] permuted pe view (any strides)
+    ggml_tensor * out = nullptr;   // [D, L, H, 1] contiguous f32 (CONCAT)
+    ggml_tensor * chain[29] = {};  // nodes[i-1 .. i+27]
+    int64_t D = 0, R = 0, H = 0, L = 0;
+};
+
+static bool kuno_minimax_dense_f32(const ggml_tensor * t) {
+    return t && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t);
+}
+
+static bool kuno_minimax_ne(const ggml_tensor * t, int64_t a, int64_t b, int64_t c, int64_t d) {
+    return t && t->ne[0] == a && t->ne[1] == b && t->ne[2] == c && t->ne[3] == d;
+}
+
+static bool kuno_minimax_rope_find(ggml_cgraph * g, int i, kuno_minimax_rope_match & m) {
+    if (i < 1 || i + 27 >= g->n_nodes) return false;
+    ggml_tensor ** c = m.chain;
+    for (int k = 0; k < 29; ++k) c[k] = g->nodes[i - 1 + k];
+    static const ggml_op ops[29] = {
+        GGML_OP_VIEW, GGML_OP_CONT, GGML_OP_PERMUTE, GGML_OP_CONT, GGML_OP_RESHAPE, GGML_OP_PERMUTE, GGML_OP_CONT,
+        GGML_OP_VIEW, GGML_OP_RESHAPE, GGML_OP_REPEAT, GGML_OP_PERMUTE, GGML_OP_CONT, GGML_OP_VIEW, GGML_OP_MUL,
+        GGML_OP_VIEW, GGML_OP_RESHAPE, GGML_OP_REPEAT, GGML_OP_VIEW, GGML_OP_MUL, GGML_OP_ADD, GGML_OP_PERMUTE,
+        GGML_OP_CONT, GGML_OP_RESHAPE, GGML_OP_VIEW, GGML_OP_CONT, GGML_OP_PERMUTE, GGML_OP_CONT, GGML_OP_RESHAPE,
+        GGML_OP_CONCAT };
+    for (int k = 0; k < 29; ++k) {
+        if (!c[k] || c[k]->op != ops[k] || c[k]->type != GGML_TYPE_F32) return false;
+    }
+    ggml_tensor * x = c[0]->src[0];
+    if (!kuno_minimax_dense_f32(x) || x->ne[3] != 1) return false;
+    const int64_t D = x->ne[0], H = x->ne[1], L = x->ne[2], R = c[0]->ne[0];
+    if (R <= 0 || R >= D || R % 2 || D > 1024) return false;
+    const int64_t R2 = R / 2;
+    auto src = [&](int k, int s) { return c[k]->src[s]; };
+    auto only = [&](int k, int n) {  // exactly n sources
+        for (int s = n; s < GGML_MAX_SRC; ++s) if (c[k]->src[s]) return false;
+        return true;
+    };
+    auto axes = [&](int k, int a, int b, int cc, int d) {
+        const int32_t * p = (const int32_t *) c[k]->op_params;
+        return p[0] == a && p[1] == b && p[2] == cc && p[3] == d;
+    };
+    // q/k slice and attention-layout copy of the rotated part.
+    if (!kuno_minimax_ne(c[0], R, H, L, 1) || c[0]->data != x->data || c[0]->nb[1] != x->nb[1] || c[0]->nb[2] != x->nb[2]) return false;
+    if (src(1, 0) != c[0] || !only(1, 1) || !kuno_minimax_ne(c[1], R, H, L, 1) || !ggml_is_contiguous(c[1])) return false;
+    if (src(2, 0) != c[1] || !axes(2, 0, 2, 1, 3) || !kuno_minimax_ne(c[2], R, L, H, 1)) return false;
+    if (src(3, 0) != c[2] || !only(3, 1) || !kuno_minimax_ne(c[3], R, L, H, 1) || !ggml_is_contiguous(c[3])) return false;
+    if (src(4, 0) != c[3] || !kuno_minimax_ne(c[4], R2, 2, L, H)) return false;
+    if (src(5, 0) != c[4] || !kuno_minimax_ne(c[5], R2, L, H, 2) || c[5]->nb[0] != c[4]->nb[0] || c[5]->nb[1] != c[4]->nb[2] ||
+        c[5]->nb[2] != c[4]->nb[3] || c[5]->nb[3] != c[4]->nb[1]) return false;
+    if (src(6, 0) != c[5] || !only(6, 1) || !kuno_minimax_ne(c[6], R2, L, H, 2) || !ggml_is_contiguous(c[6])) return false;
+    // x0 / x1 halves broadcast to [2, R/2, L, H].
+    if (src(7, 0) != c[6] || !kuno_minimax_ne(c[7], R2, L, H, 1) || c[7]->data != c[6]->data) return false;
+    if (src(8, 0) != c[7] || !kuno_minimax_ne(c[8], 1, R2, L, H)) return false;
+    if (src(9, 0) != c[8] || !only(9, 1) || !kuno_minimax_ne(c[9], 2, R2, L, H) || !ggml_is_contiguous(c[9])) return false;
+    if (src(14, 0) != c[6] || !kuno_minimax_ne(c[14], R2, L, H, 1) || (char *) c[14]->data != (char *) c[6]->data + c[6]->nb[3]) return false;
+    if (src(15, 0) != c[14] || !kuno_minimax_ne(c[15], 1, R2, L, H)) return false;
+    if (src(16, 0) != c[15] || !only(16, 1) || !kuno_minimax_ne(c[16], 2, R2, L, H) || !ggml_is_contiguous(c[16])) return false;
+    // pe: PERMUTE (external source) -> CONT -> two views.
+    ggml_tensor * pe = c[10];
+    if (!kuno_minimax_ne(pe, 2, R2, L, 2) || !pe->src[0]) return false;
+    if (src(11, 0) != c[10] || !only(11, 1) || !kuno_minimax_ne(c[11], 2, R2, L, 2) || !ggml_is_contiguous(c[11])) return false;
+    if (src(12, 0) != c[11] || !kuno_minimax_ne(c[12], 2, R2, L, 1) || c[12]->data != c[11]->data) return false;
+    if (src(17, 0) != c[11] || !kuno_minimax_ne(c[17], 2, R2, L, 1) || (char *) c[17]->data != (char *) c[11]->data + c[11]->nb[3]) return false;
+    // products and sum
+    if (src(13, 0) != c[9] || src(13, 1) != c[12] || !only(13, 2) || !kuno_minimax_ne(c[13], 2, R2, L, H)) return false;
+    if (src(18, 0) != c[16] || src(18, 1) != c[17] || !only(18, 2) || !kuno_minimax_ne(c[18], 2, R2, L, H)) return false;
+    if (src(19, 0) != c[13] || src(19, 1) != c[18] || !only(19, 2) || !kuno_minimax_ne(c[19], 2, R2, L, H)) return false;
+    if (src(20, 0) != c[19] || !kuno_minimax_ne(c[20], R2, 2, L, H) || c[20]->nb[0] != c[19]->nb[1] || c[20]->nb[1] != c[19]->nb[0] ||
+        c[20]->nb[2] != c[19]->nb[2] || c[20]->nb[3] != c[19]->nb[3]) return false;
+    if (src(21, 0) != c[20] || !only(21, 1) || !kuno_minimax_ne(c[21], R2, 2, L, H) || !ggml_is_contiguous(c[21])) return false;
+    if (src(22, 0) != c[21] || !kuno_minimax_ne(c[22], R, L, H, 1)) return false;
+    // tail
+    if (src(23, 0) != x || !kuno_minimax_ne(c[23], D - R, H, L, 1) || (char *) c[23]->data != (char *) x->data + R * sizeof(float) ||
+        c[23]->nb[1] != x->nb[1] || c[23]->nb[2] != x->nb[2]) return false;
+    if (src(24, 0) != c[23] || !only(24, 1) || !kuno_minimax_ne(c[24], D - R, H, L, 1) || !ggml_is_contiguous(c[24])) return false;
+    if (src(25, 0) != c[24] || !axes(25, 0, 2, 1, 3) || !kuno_minimax_ne(c[25], D - R, L, H, 1)) return false;
+    if (src(26, 0) != c[25] || !only(26, 1) || !kuno_minimax_ne(c[26], D - R, L, H, 1) || !ggml_is_contiguous(c[26])) return false;
+    if (src(27, 0) != c[26] || !kuno_minimax_ne(c[27], D - R, L, H, 1)) return false;
+    ggml_tensor * out = c[28];
+    if (src(28, 0) != c[22] || src(28, 1) != c[27] || !only(28, 2) || ((const int32_t *) out->op_params)[0] != 0 ||
+        !kuno_minimax_ne(out, D, L, H, 1) || !kuno_minimax_dense_f32(out)) return false;
+    // Intermediates must be private to the chain and every computed member must be scheduled.
+    for (int k = 0; k < 28; ++k) if (c[k]->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+    for (int k = 0; k < 29; ++k) {
+        if (ggml_op_is_empty(c[k]->op)) continue;
+        if (!(c[k]->flags & GGML_TENSOR_FLAG_COMPUTE)) return false;
+    }
+    for (int n = 0; n < g->n_nodes; ++n) {
+        if (n >= i - 1 && n <= i + 27) continue;
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * t = g->nodes[n]->src[s];
+            if (!t) continue;
+            for (int k = 0; k < 28; ++k) if (t == c[k]) return false;
+        }
+        const ggml_tensor * v = g->nodes[n]->view_src;
+        for (int k = 0; k < 28 && v; ++k) if (v == c[k]) return false;
+    }
+    // pe's source must already be computed (an earlier node or a leaf).
+    for (int n = i - 1; n < g->n_nodes; ++n) if (g->nodes[n] == pe->src[0] || (pe->view_src && g->nodes[n] == pe->view_src)) return false;
+    // ggml-alloc may place the output in x's (now dead) buffer; run() then stages through scratch.
+    m.x = x; m.pe = pe; m.out = out; m.D = D; m.R = R; m.H = H; m.L = L;
+    return true;
+}
+
+static void kuno_minimax_rope_run(ggml_backend_sycl_context & ctx, const kuno_minimax_rope_match & m) {
+    const float * x = (const float *) m.x->data;
+    const char * pe = (const char *) m.pe->data;
+    const int64_t D = m.D, R = m.R, R2 = m.R / 2, H = m.H, L = m.L;
+    const bool staged = kuno_overlap(m.out, m.x) || kuno_overlap(m.out, m.pe);
+    ggml_sycl_pool_alloc<float> scratch(ctx.pool());
+    float * out = staged ? scratch.alloc(size_t(D) * L * H) : (float *) m.out->data;
+    const size_t xh = m.x->nb[1] / sizeof(float), xt = m.x->nb[2] / sizeof(float);
+    const size_t p0 = m.pe->nb[0], p1 = m.pe->nb[1], p2 = m.pe->nb[2], p3 = m.pe->nb[3];
+    const size_t total = size_t(D) * L * H;
+    ctx.stream()->parallel_for(sycl::range<1>(total), [=](sycl::id<1> id) {
+        const size_t e = id[0];
+        const int64_t d = e % D;
+        const int64_t t = (e / D) % L;
+        const int64_t h = e / (size_t(D) * L);
+        const float * row = x + h * xh + t * xt;
+        float v;
+        if (d < R) {
+            const int64_t k = d / R2, a = d % R2;
+            const char * pp = pe + k * p0 + a * p1 + t * p2;
+            const float c0 = *(const float *) pp, c1 = *(const float *) (pp + p3);
+            const float x0 = row[a], x1 = row[a + R2];
+            {
+#pragma clang fp contract(off)
+                const float m0 = x0 * c0;
+                const float m1 = x1 * c1;
+                v = m0 + m1;
+            }
+        } else {
+            v = row[d];
+        }
+        out[e] = v;
+    });
+    if (staged) ctx.stream()->memcpy(m.out->data, out, ggml_nbytes(m.out));
+}
+
+// ---------------------------------------------------------------------------
+// Attention inputs: qkv MUL_MAT(i8) -> {q: VIEW/CONT/RESHAPE/RMS_NORM/MUL/partial RoPE},
+// {k: same + SCALE + CPY F16}, {v: VIEW/CONT/RESHAPE/PERMUTE/CONT/RESHAPE/SCALE/CPY F16}
+// (79 nodes, mm .. v16) -> ggml_sycl_mul_mat_i8_convrot_minimax_qkv.
+// ---------------------------------------------------------------------------
+struct kuno_minimax_qkv_match {
+    kuno_minimax_qkv_args args;
+    kuno_minimax_rope_match rq, rk;
+    int first = -1, last = -1;
+};
+
+static bool kuno_minimax_qkv_find(ggml_cgraph * g, int i, kuno_minimax_qkv_match & m) {
+    if (i + 79 >= g->n_nodes) return false;
+    ggml_tensor ** n = g->nodes + i;
+    ggml_tensor * mm = n[0];
+    if (mm->op != GGML_OP_MUL_MAT || mm->src[0]->type != GGML_TYPE_I8 || mm->type != GGML_TYPE_F32 ||
+        ggml_node_get_use_count(g, i) != 3) return false;
+    const int64_t L = mm->ne[1];
+    if (mm->ne[0] % (3 * 128) || mm->ne[2] != 1 || mm->ne[3] != 1) return false;
+    const int64_t inner = mm->ne[0] / 3, H = inner / 128;
+    // q / k front: VIEW(mm, off) -> CONT -> RESHAPE [128,H,L] -> RMS_NORM -> MUL(w)
+    auto front = [&](int b, size_t off, const ggml_tensor *& w, float & eps) {
+        ggml_tensor * v = n[b], * c = n[b + 1], * r = n[b + 2], * rms = n[b + 3], * mul = n[b + 4];
+        if (v->op != GGML_OP_VIEW || v->src[0] != mm || v->view_src != mm || v->view_offs != off || v->ne[0] != inner ||
+            v->ne[1] != L || v->nb[1] != mm->nb[1]) return false;
+        if (c->op != GGML_OP_CONT || c->src[0] != v || !ggml_is_contiguous(c)) return false;
+        if (r->op != GGML_OP_RESHAPE || r->src[0] != c || !kuno_minimax_ne(r, 128, H, L, 1)) return false;
+        if (rms->op != GGML_OP_RMS_NORM || rms->src[0] != r || !kuno_minimax_ne(rms, 128, H, L, 1)) return false;
+        if (mul->op != GGML_OP_MUL || mul->src[0] != rms || !mul->src[1] || mul->src[2] || ggml_nelements(mul->src[1]) != 128 ||
+            ggml_node_get_use_count(g, i + b + 4) != 2) return false;
+        memcpy(&eps, rms->op_params, sizeof(float));
+        w = mul->src[1];
+        return true;
+    };
+    auto& a = m.args;
+    if (!front(1, 0, a.wq, a.eps_q)) return false;
+    if (!kuno_minimax_rope_find(g, i + 7, m.rq) || m.rq.x != n[5]) return false;          // q rope: nodes i+6 .. i+34
+    if (!front(35, size_t(inner) * sizeof(float), a.wk, a.eps_k)) return false;
+    if (!kuno_minimax_rope_find(g, i + 41, m.rk) || m.rk.x != n[39]) return false;         // k rope: nodes i+40 .. i+68
+    if (m.rq.R != m.rk.R || m.rq.pe->data != m.rk.pe->data || memcmp(m.rq.pe->nb, m.rk.pe->nb, sizeof(m.rq.pe->nb)) ||
+        m.rq.H != H || m.rq.L != L || m.rq.D != 128) return false;
+    // k: SCALE -> CPY F16
+    ggml_tensor * ks = n[69], * k16 = n[70];
+    if (ks->op != GGML_OP_SCALE || ks->src[0] != m.rk.out || k16->op != GGML_OP_CPY || k16->src[0] != ks || k16->type != GGML_TYPE_F16) return false;
+    // v: VIEW -> CONT -> RESHAPE -> PERMUTE(0,2,1,3) -> CONT -> RESHAPE -> SCALE -> CPY F16
+    ggml_tensor * vv = n[71], * vc = n[72], * vr = n[73], * vp = n[74], * vc2 = n[75], * vr2 = n[76], * vs = n[77], * v16 = n[78];
+    if (vv->op != GGML_OP_VIEW || vv->src[0] != mm || vv->view_src != mm || vv->view_offs != size_t(2 * inner) * sizeof(float) ||
+        vv->ne[0] != inner || vv->ne[1] != L || vv->nb[1] != mm->nb[1]) return false;
+    if (vc->op != GGML_OP_CONT || vc->src[0] != vv || !ggml_is_contiguous(vc)) return false;
+    if (vr->op != GGML_OP_RESHAPE || vr->src[0] != vc || !kuno_minimax_ne(vr, 128, H, L, 1)) return false;
+    const int32_t * pax = (const int32_t *) vp->op_params;
+    if (vp->op != GGML_OP_PERMUTE || vp->src[0] != vr || pax[0] != 0 || pax[1] != 2 || pax[2] != 1 || pax[3] != 3) return false;
+    if (vc2->op != GGML_OP_CONT || vc2->src[0] != vp || !ggml_is_contiguous(vc2) || !kuno_minimax_ne(vc2, 128, L, H, 1)) return false;
+    if (vr2->op != GGML_OP_RESHAPE || vr2->src[0] != vc2 || !kuno_minimax_ne(vr2, 128, L, H, 1)) return false;
+    if (vs->op != GGML_OP_SCALE || vs->src[0] != vr2 || v16->op != GGML_OP_CPY || v16->src[0] != vs || v16->type != GGML_TYPE_F16) return false;
+    for (ggml_tensor * t : {ks, k16, vs, v16}) if (!kuno_minimax_ne(t, 128, L, H, 1) || !ggml_is_contiguous(t)) return false;
+    // Everything in [i, i+78] except q, k16 and v16 is private; all computed nodes are scheduled.
+    const ggml_tensor * outs[3] = {m.rq.out, k16, v16};
+    for (int k = 0; k <= 78; ++k) {
+        ggml_tensor * t = n[k];
+        if (!ggml_op_is_empty(t->op) && !(t->flags & GGML_TENSOR_FLAG_COMPUTE)) return false;
+        if (t != outs[0] && t != outs[1] && t != outs[2] && (t->flags & GGML_TENSOR_FLAG_OUTPUT)) return false;
+    }
+    for (int k = 0; k < g->n_nodes; ++k) {
+        if (k >= i && k <= i + 78) continue;
+        const ggml_tensor * node = g->nodes[k];
+        for (int s = 0; s <= GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = s < GGML_MAX_SRC ? node->src[s] : node->view_src;
+            if (!src || src == outs[0] || src == outs[1] || src == outs[2]) continue;
+            for (int j = 0; j <= 78; ++j) if (src == n[j]) return false;
+        }
+    }
+    memcpy(&a.k_scale, (const float *) ks->op_params + 0, sizeof(float)); memcpy(&a.k_bias, (const float *) ks->op_params + 1, sizeof(float));
+    memcpy(&a.v_scale, (const float *) vs->op_params + 0, sizeof(float)); memcpy(&a.v_bias, (const float *) vs->op_params + 1, sizeof(float));
+    a.heads = H; a.rot = m.rq.R; a.pe = m.rq.pe; a.q = m.rq.out; a.k16 = k16; a.v16 = v16;
+    m.first = i; m.last = i + 78;
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// Segmented AdaLN chains (MiniMax H3 token segments, left-deep CONCAT along rows):
+//   gate: out_k = A_k + (B_k * g_k)                        -> materialized residual [C, L]
+//   mod:  v_k   = (X_k + X_k * s_k) + t_k  [-> SCALE]      -> QUANTIZE (fused loader)
+// Inputs are read where their values live (CONT copies and views resolved), so the
+// graph's per-segment CONT/MUL/ADD/CONCAT nodes and parameter-row copies are skipped.
+// The fused op runs at the chain's last node; nodes still executed inside the window
+// must not overlap any input (ggml-alloc plans reuse around the original order).
+// ---------------------------------------------------------------------------
+#include <unordered_map>
+
+struct kuno_minimax_seg_job {
+    bool gate = false, staged = false;
+    ggml_tensor * out = nullptr;       // gate: final CONCAT; mod: QUANTIZE
+    kuno_minimax_seg_desc d;
+    std::vector<int> nodes;            // skipped nodes + run node, ascending (dev check)
+    std::vector<std::pair<const char *, size_t>> inputs;
+    std::vector<const ggml_tensor *> input_roots;   // producer of each input range
+};
+struct kuno_minimax_seg_plan {
+    std::vector<uint8_t> skip, plain;  // plain: execute without other fusions (folded producer)
+    std::unordered_map<int, kuno_minimax_seg_job> jobs;
+};
+
+// Address of t's values in the tensor that actually holds them (through exact copies and views).
+static const char * kuno_seg_resolve(const ggml_tensor * t, const ggml_tensor *& root, std::vector<const ggml_tensor *> & path) {
+    for (int depth = 0; depth < 24; ++depth) {
+        if (t->op == GGML_OP_CONT && t->src[0] && t->src[0]->type == t->type && ggml_is_contiguous(t->src[0]) &&
+            ggml_is_contiguous(t) && ggml_nelements(t->src[0]) == ggml_nelements(t)) {
+            path.push_back(t);
+            t = t->src[0];
+            continue;
+        }
+        if (t->view_src && ggml_is_contiguous(t) && ggml_is_contiguous(t->view_src) && t->type == t->view_src->type) {
+            path.push_back(t);
+            const ggml_tensor * base_root = nullptr;
+            const char * base = kuno_seg_resolve(t->view_src, base_root, path);
+            if (!base) return nullptr;
+            root = base_root;
+            return base + t->view_offs;
+        }
+        root = t->view_src ? t->view_src : t;
+        return (const char *) t->data;
+    }
+    return nullptr;
+}
+
+static bool kuno_seg_overlaps(const char * a, size_t an, const char * b, size_t bn) { return a < b + bn && b < a + an; }
+
+static bool kuno_minimax_seg_match(ggml_cgraph * g, int fi, const std::unordered_map<const ggml_tensor *, int> & index,
+                                   kuno_minimax_seg_plan & plan, kuno_minimax_seg_job & job) {
+    ggml_tensor * F = g->nodes[fi];
+    if (F->op != GGML_OP_CONCAT || ((const int32_t *) F->op_params)[0] != 1 || F->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(F) || F->ne[2] != 1 || F->ne[3] != 1) return false;
+    const int64_t C = F->ne[0], L = F->ne[1];
+    std::vector<ggml_tensor *> vals, concats;
+    ggml_tensor * t = F;
+    while (t->op == GGML_OP_CONCAT && ((const int32_t *) t->op_params)[0] == 1 && t->ne[0] == C) {
+        concats.push_back(t); vals.push_back(t->src[1]); t = t->src[0];
+        if ((int) vals.size() > kuno_minimax_seg_desc::max_segs) return false;
+    }
+    vals.push_back(t);
+    std::reverse(vals.begin(), vals.end());
+    const int nseg = (int) vals.size();
+    if (nseg < 2) return false;
+    auto & d = job.d;
+    d.nseg = nseg; d.C = C; d.L = L;
+    std::vector<const ggml_tensor *> skipped(concats.begin(), concats.end()), path;
+    std::vector<const ggml_tensor *> roots;
+    auto row_param = [&](const ggml_tensor * p, const float *& dst) {
+        if (!p || p->type != GGML_TYPE_F32 || p->ne[0] != C || ggml_nelements(p) != C || !ggml_is_contiguous(p)) return false;
+        const ggml_tensor * root = nullptr; path.clear();
+        const char * a = kuno_seg_resolve(p, root, path);
+        if (!a || !root) return false;
+        skipped.insert(skipped.end(), path.begin(), path.end());
+        roots.push_back(root);
+        dst = (const float *) a; job.inputs.push_back({a, size_t(C) * sizeof(float)}); job.input_roots.push_back(root);
+        return true;
+    };
+    auto slice = [&](const ggml_tensor * x, int64_t rows, const float *& dst, const ggml_tensor *& root, bool add_path) {
+        if (!x || x->type != GGML_TYPE_F32 || x->ne[0] != C || x->ne[1] != rows || !ggml_is_contiguous(x)) return false;
+        path.clear(); root = nullptr;
+        const char * a = kuno_seg_resolve(x, root, path);
+        if (!a || !root) return false;
+        if (add_path) skipped.insert(skipped.end(), path.begin(), path.end());
+        dst = (const float *) a; job.inputs.push_back({a, size_t(C) * rows * sizeof(float)}); job.input_roots.push_back(root);
+        return true;
+    };
+    const ggml_tensor * last_v = vals.back();
+    const bool gate = last_v->op == GGML_OP_ADD && last_v->src[1] && last_v->src[1]->op == GGML_OP_MUL;
+    job.gate = gate;
+    const ggml_tensor * shared_b = nullptr;
+    int64_t row0 = 0;
+    for (int k = 0; k < nseg; ++k) {
+        ggml_tensor * v = vals[k];
+        const int64_t rows = v->ne[1];
+        auto & s = d.seg[k];
+        s.row0 = row0; s.rows = rows;
+        if (v->op != GGML_OP_ADD || v->type != GGML_TYPE_F32 || v->ne[0] != C || !ggml_is_contiguous(v) || v->src[2]) return false;
+        skipped.push_back(v);
+        if (gate) {
+            const ggml_tensor * A = v->src[0], * M = v->src[1];
+            if (M->op != GGML_OP_MUL || M->src[2] || M->ne[0] != C || M->ne[1] != rows) return false;
+            skipped.push_back(M);
+            const ggml_tensor * ra = nullptr, * rb = nullptr;
+            // A: an exact copy (resolved) or any finished [C, rows] tensor, read in place.
+            const bool a_copy = A->op == GGML_OP_CONT;
+            if (!slice(A, rows, s.a, ra, a_copy)) return false;
+            if (!slice(M->src[0], rows, s.b, rb, true)) return false;
+            if (M->src[0]->op != GGML_OP_CONT) return false;
+            if (shared_b && rb != shared_b) return false;
+            shared_b = rb;
+            if ((const char *) s.b != (const char *) rb->data + size_t(row0) * C * sizeof(float)) return false;
+            roots.push_back(ra); roots.push_back(rb);
+            if (!row_param(M->src[1], s.p)) return false;
+        } else {
+            const ggml_tensor * inner = v->src[0], * M = inner ? inner->src[1] : nullptr;
+            if (!inner || inner->op != GGML_OP_ADD || inner->src[2] || !M || M->op != GGML_OP_MUL || M->src[2] ||
+                M->src[0] != inner->src[0] || inner->ne[1] != rows || M->ne[1] != rows) return false;
+            skipped.push_back(inner); skipped.push_back(M);
+            const ggml_tensor * rx = nullptr;
+            if (inner->src[0]->op != GGML_OP_CONT || !slice(inner->src[0], rows, s.a, rx, true)) return false;
+            if (shared_b && rx != shared_b) return false;
+            shared_b = rx;
+            if ((const char *) s.a != (const char *) rx->data + size_t(row0) * C * sizeof(float)) return false;
+            roots.push_back(rx);
+            if (!row_param(M->src[1], s.p) || !row_param(v->src[1], s.q)) return false;
+        }
+        row0 += rows;
+    }
+    if (row0 != L) return false;
+    int run_at = fi;
+    if (gate) {
+        // Fold a private SCALE producer of the gated output into the read.
+        const ggml_tensor * O = shared_b;
+        auto it = index.find(O);
+        if (O->op == GGML_OP_SCALE && it != index.end() && O->src[0] && O->src[0]->type == GGML_TYPE_F32 &&
+            ggml_is_contiguous(O->src[0]) && ggml_are_same_shape(O, O->src[0])) {
+            bool private_use = true;
+            for (int n = 0; n < g->n_nodes && private_use; ++n) {
+                const ggml_tensor * node = g->nodes[n];
+                for (int s = 0; s <= GGML_MAX_SRC; ++s) {
+                    const ggml_tensor * src = s < GGML_MAX_SRC ? node->src[s] : node->view_src;
+                    if (src == O && std::find(skipped.begin(), skipped.end(), node) == skipped.end()) { private_use = false; break; }
+                }
+            }
+            auto pit = index.find(O->src[0]);
+            if (private_use && pit != index.end()) {
+                d.o_scaled = true;
+                memcpy(&d.o_scale, (const float *) O->op_params + 0, sizeof(float));
+                memcpy(&d.o_bias, (const float *) O->op_params + 1, sizeof(float));
+                const ptrdiff_t delta = (const char *) O->src[0]->data - (const char *) O->data;
+                for (int k = 0; k < nseg; ++k) d.seg[k].b = (const float *) ((const char *) d.seg[k].b + delta);
+                for (size_t k = 0; k < job.inputs.size(); ++k) {
+                    auto & in = job.inputs[k];
+                    if (in.first >= (const char *) O->data && in.first < (const char *) O->data + ggml_nbytes(O)) { in.first += delta; job.input_roots[k] = O->src[0]; }
+                }
+                skipped.push_back(O);
+                roots.erase(std::remove(roots.begin(), roots.end(), O), roots.end());
+                roots.push_back(O->src[0]);
+                plan.plain[pit->second] = 1;
+            }
+        }
+        job.out = F;
+        skipped.erase(std::remove(skipped.begin(), skipped.end(), (const ggml_tensor *) F), skipped.end());  // written by the run
+    } else {
+        // CONCAT -> [SCALE ->] QUANTIZE, each single-use; the fast quantizer covers this width.
+        if (C % 256 || C / 256 > 64) return false;
+        auto fit = index.find(F);
+        if (fit == index.end() || ggml_node_get_use_count(g, fit->second) != 1) return false;
+        int next = -1;
+        for (int n = fi + 1; n < g->n_nodes; ++n) if (g->nodes[n]->src[0] == F) { next = n; break; }
+        if (next < 0) return false;
+        ggml_tensor * nn = g->nodes[next];
+        skipped.push_back(F);
+        if (nn->op == GGML_OP_SCALE) {
+            if (ggml_node_get_use_count(g, next) != 1 || next + 1 >= g->n_nodes) return false;
+            d.q_scaled = true;
+            memcpy(&d.q_scale, (const float *) nn->op_params + 0, sizeof(float));
+            memcpy(&d.q_bias, (const float *) nn->op_params + 1, sizeof(float));
+            skipped.push_back(nn);
+            int q = -1;
+            for (int n = next + 1; n < g->n_nodes; ++n) if (g->nodes[n]->src[0] == nn) { q = n; break; }
+            if (q < 0) return false;
+            next = q; nn = g->nodes[q];
+        }
+        if (nn->op != GGML_OP_QUANTIZE_I8_CONVROT || (nn->flags & GGML_TENSOR_FLAG_OUTPUT)) return false;
+        job.out = nn; run_at = next;
+    }
+    // Skipped nodes: indices, privacy, scheduling.
+    std::vector<int> idx;
+    for (const ggml_tensor * s : skipped) {
+        auto it = index.find(s);
+        if (it == index.end()) continue;                     // leaf or view outside the graph's node list
+        idx.push_back(it->second);
+    }
+    std::sort(idx.begin(), idx.end()); idx.erase(std::unique(idx.begin(), idx.end()), idx.end());
+    if (idx.empty() || idx.back() > run_at) return false;
+    for (int n : idx) {
+        if (plan.skip[n] || g->nodes[n]->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+        if (n == run_at) return false;
+    }
+    std::vector<uint8_t> mine(g->n_nodes, 0);
+    for (int n : idx) mine[n] = 1;
+    for (int n = 0; n < g->n_nodes; ++n) {
+        if (mine[n] || n == run_at) continue;
+        const ggml_tensor * node = g->nodes[n];
+        for (int s = 0; s <= GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = s < GGML_MAX_SRC ? node->src[s] : node->view_src;
+            if (!src) continue;
+            auto it = index.find(src);
+            if (it != index.end() && mine[it->second]) return false;
+        }
+    }
+    // Roots must be finished before the run and stay intact through it.
+    const int first = idx.front();
+    for (const ggml_tensor * r : roots) {
+        auto it = index.find(r);
+        if (it != index.end() && (mine[it->second] || it->second >= run_at)) return false;
+    }
+    for (int n = first; n < run_at; ++n) {
+        if (mine[n]) continue;
+        const ggml_tensor * node = g->nodes[n];
+        if (ggml_op_is_empty(node->op) || !(node->flags & GGML_TENSOR_FLAG_COMPUTE) || !node->data) continue;
+        // Producers of an input (the root itself or an in-place op on it) are expected to write it.
+        bool producer = false;
+        for (const ggml_tensor * r : roots) producer |= node == r || (node->view_src && node->view_src == r);
+        if (producer) continue;
+        for (size_t k = 0; k < job.inputs.size(); ++k) {
+            const auto & in = job.inputs[k];
+            auto rit = index.find(job.input_roots[k]);
+            if (rit != index.end() && n <= rit->second) continue;   // runs before the input is produced
+            if (kuno_seg_overlaps((const char *) node->data, ggml_nbytes(node), in.first, in.second)) return false;
+        }
+    }
+    std::vector<const char *> same_rows;   // gate inputs addressing the output's own element (safe in place)
+    if (gate) {
+        for (int k = 0; k < nseg; ++k) {
+            const char * own = (const char *) F->data + size_t(d.seg[k].row0) * C * sizeof(float);
+            if ((const char *) d.seg[k].a == own) same_rows.push_back((const char *) d.seg[k].a);
+            if ((const char *) d.seg[k].b == own) same_rows.push_back((const char *) d.seg[k].b);
+        }
+    }
+    for (const auto & in : job.inputs) {
+        if (!kuno_seg_overlaps((const char *) job.out->data, ggml_nbytes(job.out), in.first, in.second)) continue;
+        if (std::find(same_rows.begin(), same_rows.end(), in.first) == same_rows.end()) job.staged = true;
+    }
+    for (int n : idx) plan.skip[n] = 1;
+    job.nodes = idx; job.nodes.push_back(run_at);
+    plan.jobs[run_at] = job;
+    return true;
+}
+
+static kuno_minimax_seg_plan kuno_minimax_seg_prepare(ggml_cgraph * g) {
+    kuno_minimax_seg_plan plan;
+    plan.skip.assign(g->n_nodes, 0); plan.plain.assign(g->n_nodes, 0);
+    std::unordered_map<const ggml_tensor *, int> index;
+    index.reserve(g->n_nodes * 2);
+    std::vector<uint8_t> inner(g->n_nodes, 0);
+    bool any = false;
+    for (int n = 0; n < g->n_nodes; ++n) index[g->nodes[n]] = n;
+    for (int n = 0; n < g->n_nodes; ++n) {
+        const ggml_tensor * t = g->nodes[n];
+        if (t->op == GGML_OP_CONCAT && t->src[0] && t->src[0]->op == GGML_OP_CONCAT) {
+            any = true;
+            auto it = index.find(t->src[0]);
+            if (it != index.end()) inner[it->second] = 1;   // not a final CONCAT
+        }
+    }
+    if (!any) return plan;
+    for (int n = 0; n < g->n_nodes; ++n) {
+        ggml_tensor * t = g->nodes[n];
+        if (t->op != GGML_OP_CONCAT || plan.skip[n] || inner[n] || !t->src[0] || t->src[0]->op != GGML_OP_CONCAT) continue;
+        kuno_minimax_seg_job job;
+        kuno_minimax_seg_match(g, n, index, plan, job);
+    }
+    return plan;
+}
+
+static void kuno_minimax_seg_run(ggml_backend_sycl_context & ctx, const kuno_minimax_seg_job & job) {
+    const kuno_minimax_seg_desc d = job.d;
+    if (job.gate) {
+        ggml_sycl_pool_alloc<float> scratch(ctx.pool());
+        float * out = job.staged ? scratch.alloc(size_t(d.C) * d.L) : (float *) job.out->data;
+        for (int k = 0; k < d.nseg; ++k) {
+            const kuno_minimax_seg sg = d.seg[k];
+            float * o = out + size_t(sg.row0) * d.C;
+            const int64_t C = d.C;
+            const bool os = d.o_scaled; const float osc = d.o_scale, ob = d.o_bias;
+            ctx.stream()->parallel_for(sycl::range<2>(sg.rows, C), [=](sycl::id<2> id) {
+#pragma clang fp contract(off) reassociate(off)
+                const size_t off = id[0] * C + id[1];
+                float b = sg.b[off];
+                if (os) b = osc * b + ob;
+                const float product = b * sg.p[id[1]];
+                o[off] = sg.a[off] + product;
+            });
+        }
+        if (job.staged) ctx.stream()->memcpy(job.out->data, out, ggml_nbytes(job.out));
+    } else {
+        ggml_tensor * q = job.out;
+        if (job.staged) {
+            ggml_sycl_pool_alloc<int8_t> scratch(ctx.pool());
+            ggml_tensor tmp = *q;
+            tmp.data = scratch.alloc(ggml_nbytes(q));
+            GGML_ASSERT(ggml_sycl_quantize_i8_convrot_minimax_mod(ctx, &tmp, d));
+            ctx.stream()->memcpy(q->data, tmp.data, ggml_nbytes(q));
+        } else {
+            GGML_ASSERT(ggml_sycl_quantize_i8_convrot_minimax_mod(ctx, q, d));
+        }
+    }
+}
diff --git a/src/ggml-sycl/mul-add-policy.hpp b/src/ggml-sycl/mul-add-policy.hpp
new file mode 100644
index 0000000..8e833d6
--- /dev/null
+++ b/src/ggml-sycl/mul-add-policy.hpp
@@ -0,0 +1,78 @@
+// Narrow, allocation-free policy for materialized-F32 MUL followed by ADD.
+#pragma once
+#include "ggml.h"
+#include "ggml-impl.h"
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <limits>
+
+inline bool ggml_sycl_mul_add_geometry(const ggml_tensor * mul, const ggml_tensor * add) {
+    if (!mul || !add || mul->op != GGML_OP_MUL || add->op != GGML_OP_ADD ||
+        mul->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 ||
+        !mul->src[0] || !mul->src[1] ||
+        add->src[1] != mul || add->src[0] == mul) return false;
+    // Qwen21 uses ADD(residual, MUL(activation, gate)). Reversed ADD operands
+    // retain the legacy path: their device NaN payload/sign propagation differs.
+    const auto activation = mul->src[0], gate = mul->src[1];
+    const auto residual = add->src[0];
+    if (!residual || activation->type != GGML_TYPE_F32 || gate->type != GGML_TYPE_F32 ||
+        residual->type != GGML_TYPE_F32 || !ggml_are_same_shape(mul, activation) ||
+        !ggml_are_same_shape(mul, add) || !ggml_are_same_shape(mul, residual)) return false;
+    if (mul->ne[0] <= 0 || mul->ne[1] <= 0 || mul->ne[2] != 1 || mul->ne[3] != 1 ||
+        gate->ne[0] != mul->ne[0] || gate->ne[1] != 1 || gate->ne[2] != 1 || gate->ne[3] != 1)
+        return false;
+    const uint64_t columns = uint64_t(mul->ne[0]), rows = uint64_t(mul->ne[1]);
+    if (columns > std::numeric_limits<size_t>::max() / sizeof(float) / rows) return false;
+    // Full arrays cannot be views. The per-channel coefficient may be a view.
+    const ggml_tensor * arrays[] = {activation, residual, mul, add};
+    for (const auto tensor : arrays) {
+        if (tensor->view_src || !ggml_is_contiguous(tensor)) return false;
+    }
+    if (!ggml_is_contiguous(gate)) return false;
+    return true;
+}
+
+inline bool ggml_sycl_mul_add_graph_safe(const ggml_cgraph * graph, int index) {
+    if (!graph || index < 0 || index >= graph->n_nodes - 1 ||
+        !ggml_can_fuse(graph, index, {GGML_OP_MUL, GGML_OP_ADD}) ||
+        !ggml_sycl_mul_add_geometry(graph->nodes[index], graph->nodes[index + 1])) return false;
+    const auto mul = graph->nodes[index];
+    // GGML's direct use count excludes view-only escapes. A view of this
+    // intermediate still needs its materialized value after the fused ADD.
+    auto escapes = [&](const ggml_tensor * tensor) {
+        for (auto source = tensor->view_src; source; source = source->view_src) {
+            if (source == mul) return true;
+        }
+        return false;
+    };
+    for (int i = 0; i < graph->n_nodes; ++i) if (escapes(graph->nodes[i])) return false;
+    for (int i = 0; i < graph->n_leafs; ++i) if (escapes(graph->leafs[i])) return false;
+    return true;
+}
+
+inline bool ggml_sycl_mul_add_memory_safe(const ggml_tensor * mul, const ggml_tensor * add) {
+    if (!ggml_sycl_mul_add_geometry(mul, add)) return false;
+    const auto activation = mul->src[0], gate = mul->src[1];
+    const auto residual = add->src[0];
+    const size_t bytes = size_t(mul->ne[0]) * size_t(mul->ne[1]) * sizeof(float);
+    const size_t gate_bytes = size_t(mul->ne[0]) * sizeof(float);
+    auto valid_range = [](const void * pointer, size_t size) {
+        const auto start = reinterpret_cast<uintptr_t>(pointer);
+        return start != 0 && start % alignof(float) == 0 &&
+               size <= std::numeric_limits<uintptr_t>::max() - start;
+    };
+    if (!valid_range(add->data, bytes) || !valid_range(activation->data, bytes) ||
+        !valid_range(residual->data, bytes) || !valid_range(gate->data, gate_bytes)) return false;
+    const auto destination = reinterpret_cast<uintptr_t>(add->data);
+    auto overlaps = [&](const void * pointer, size_t size) {
+        const auto start = reinterpret_cast<uintptr_t>(pointer);
+        return destination < start + size && start < destination + bytes;
+    };
+    // Exact full-array aliases are elementwise safe. Partial aliases and a
+    // coefficient/output overlap would race between work items.
+    for (const auto tensor : {activation, residual}) {
+        if (tensor->data != add->data && overlaps(tensor->data, bytes)) return false;
+    }
+    return !overlaps(gate->data, gate_bytes);
+}
diff --git a/src/ggml-sycl/pci-address.hpp b/src/ggml-sycl/pci-address.hpp
new file mode 100644
index 0000000..9907438
--- /dev/null
+++ b/src/ggml-sycl/pci-address.hpp
@@ -0,0 +1,14 @@
+#pragma once
+#include <string>
+
+// The device extension must supply an exact conventional domain:bus:slot.func.
+inline std::string ggml_sycl_canonical_pci_address(std::string pci) {
+    if (pci.size() != 12 || pci[4] != ':' || pci[7] != ':' || pci[10] != '.') return {};
+    for (size_t at = 0; at < pci.size(); ++at) {
+        if (at == 4 || at == 7 || at == 10) continue;
+        if (pci[at] >= 'A' && pci[at] <= 'F') pci[at] += 'a' - 'A';
+        if (!((pci[at] >= '0' && pci[at] <= '9') || (pci[at] >= 'a' && pci[at] <= 'f'))) return {};
+    }
+    if (pci[8] > '1' || pci[11] > '7') return {}; // PCI slot <=31, function <=7.
+    return pci;
+}
diff --git a/src/ggml-sycl/repeat-mul-policy.hpp b/src/ggml-sycl/repeat-mul-policy.hpp
new file mode 100644
index 0000000..b6d615c
--- /dev/null
+++ b/src/ggml-sycl/repeat-mul-policy.hpp
@@ -0,0 +1,124 @@
+#pragma once
+#include <climits>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include "ggml-impl.h"
+
+namespace ggml_sycl_repeat_mul_policy {
+constexpr int max_metadata_nodes = 4;
+constexpr int max_graph_nodes = 16384;
+constexpr int max_view_depth = 8;
+enum class Reason : unsigned { eligible, shape, use, overlap, graph };
+struct Plan {
+    const ggml_tensor * source = nullptr;
+    const ggml_tensor * coefficient = nullptr;
+    int mul_index = -1;
+    Reason reason = Reason::graph;
+    explicit operator bool() const noexcept { return reason == Reason::eligible; }
+};
+struct Span { uintptr_t first = 0, last = 0; };
+inline bool checked_add(size_t a, size_t b, size_t & out) noexcept {
+    if (b > std::numeric_limits<size_t>::max() - a) return false;
+    out = a + b; return true;
+}
+inline bool checked_mul(size_t a, size_t b, size_t & out) noexcept {
+    if (a && b > std::numeric_limits<size_t>::max() / a) return false;
+    out = a * b; return true;
+}
+inline bool span(const ggml_tensor * tensor, Span & out) noexcept {
+    if (!tensor || !tensor->data || tensor->type != GGML_TYPE_F32) return false;
+    size_t bytes = sizeof(float);
+    for (unsigned i = 0; i < 4; ++i) {
+        if (tensor->ne[i] <= 0) return false;
+        size_t term = 0;
+        if (!checked_mul(size_t(tensor->ne[i] - 1), tensor->nb[i], term) || !checked_add(bytes, term, bytes)) return false;
+    }
+    const auto first = reinterpret_cast<uintptr_t>(tensor->data);
+    if (bytes > std::numeric_limits<uintptr_t>::max() - first) return false;
+    out = {first, first + bytes}; return true;
+}
+inline bool overlaps(const Span & a, const Span & b) noexcept { return a.first < b.last && b.first < a.last; }
+inline bool dense(const ggml_tensor * tensor, int64_t n0, int64_t n1, int64_t n2, int64_t n3) noexcept {
+    if (!tensor || tensor->type != GGML_TYPE_F32) return false;
+    const int64_t shape[] = {n0,n1,n2,n3};
+    size_t stride = sizeof(float);
+    for (unsigned i = 0; i < 4; ++i) {
+        if (tensor->ne[i] != shape[i] || shape[i] <= 0 || tensor->nb[i] != stride) return false;
+        if (!checked_mul(stride,size_t(shape[i]),stride)) return false;
+    }
+    return true;
+}
+inline bool metadata(enum ggml_op op) noexcept {
+    return op == GGML_OP_VIEW || op == GGML_OP_RESHAPE || op == GGML_OP_TRANSPOSE || op == GGML_OP_PERMUTE || op == GGML_OP_NONE;
+}
+inline bool protected_output(const ggml_tensor * tensor) noexcept {
+    // Runner cut/cache outputs carry OUTPUT in executable segment graphs. The
+    // fixed cut prefix also protects monolithic graphs; it is never printed.
+    constexpr char cut_prefix[] = "ggml_runner_cut:";
+    return (tensor->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+        std::memcmp(tensor->name,cut_prefix,sizeof(cut_prefix)-1) == 0;
+}
+inline bool read_chain(const ggml_tensor * tensor, const Span & destination, size_t alignment) noexcept {
+    if (!alignment || (alignment & (alignment-1))) return false;
+    const ggml_tensor * seen[max_view_depth]{};
+    Span child{};
+    bool have_child = false;
+    int depth = 0;
+    for (; tensor; tensor = tensor->view_src) {
+        if (depth == max_view_depth) return false;
+        for (int i = 0; i < depth; ++i) if (seen[i] == tensor) return false;
+        seen[depth++] = tensor;
+        Span current{};
+        if (!span(tensor,current) || current.first % alignment || overlaps(current,destination)) return false;
+        if (have_child && (child.first < current.first || child.last > current.last)) return false;
+        child = current; have_child = true;
+    }
+    return true;
+}
+inline Plan find(const ggml_cgraph * graph, int index, size_t alignment) noexcept {
+    Plan result;
+    if (!graph || !graph->nodes || graph->n_nodes <= 0 || graph->n_nodes > max_graph_nodes ||
+        index < 0 || index >= graph->n_nodes || !alignment || (alignment & (alignment-1))) return result;
+    const auto * repeat = graph->nodes[index];
+    result.reason = Reason::shape;
+    if (!repeat || repeat->op != GGML_OP_REPEAT || repeat->view_src || protected_output(repeat) ||
+        !(repeat->flags & GGML_TENSOR_FLAG_COMPUTE) || !repeat->src[0]) return result;
+    const int64_t length = repeat->ne[2];
+    if (length <= 0 || length > INT_MAX / 4096 ||
+        !dense(repeat,2,64,length,32) || !dense(repeat->src[0],1,64,length,32)) return result;
+    int next = index + 1, skipped = 0;
+    while (next < graph->n_nodes && graph->nodes[next] && metadata(graph->nodes[next]->op)) {
+        if (++skipped > max_metadata_nodes) return result;
+        ++next;
+    }
+    if (next >= graph->n_nodes) return result;
+    const auto * mul = graph->nodes[next];
+    if (!mul || mul->op != GGML_OP_MUL || mul->src[0] != repeat ||
+        !(mul->flags & GGML_TENSOR_FLAG_COMPUTE) || !dense(mul,2,64,length,32) ||
+        !dense(mul->src[1],2,64,length,1)) return result;
+    result.reason = Reason::use;
+    unsigned uses = 0;
+    for (int j = 0; j < graph->n_nodes; ++j) {
+        const auto * node = graph->nodes[j];
+        if (!node) return result;
+        if (node->view_src == repeat) return result;
+        for (unsigned k = 0; k < GGML_MAX_SRC; ++k) if (node->src[k] == repeat) {
+            if (node != mul || k != 0 || ++uses != 1) return result;
+        }
+    }
+    if (uses != 1) return result;
+    result.reason = Reason::overlap;
+    Span destination{}, repeated{};
+    if (!span(mul,destination) || !span(repeat,repeated) ||
+        destination.first % alignment || repeated.first % alignment) return result;
+    // Gallocr may reuse the dead repeated intermediate as MUL's destination.
+    // Exact reuse is safe; partial overlap is never accepted. Actual inputs and
+    // all view ancestors (including both halves/PE components) stay disjoint.
+    if (overlaps(destination,repeated) && (destination.first != repeated.first || destination.last != repeated.last)) return result;
+    if (!read_chain(repeat->src[0],destination,alignment) || !read_chain(mul->src[1],destination,alignment)) return result;
+    result = {repeat->src[0],mul->src[1],next,Reason::eligible};
+    return result;
+}
+}
diff --git a/src/ggml-sycl/whole-rope-dispatch.hpp b/src/ggml-sycl/whole-rope-dispatch.hpp
new file mode 100644
index 0000000..6326774
--- /dev/null
+++ b/src/ggml-sycl/whole-rope-dispatch.hpp
@@ -0,0 +1,101 @@
+#pragma once
+// Included only inside the SYCL backend TU, after its normal buffer context.
+#include "whole-rope-policy.hpp"
+#include "whole-rope-test.h"
+#include "whole-rope.hpp"
+
+namespace {
+using KunoWholeRopePlans=ggml_sycl_whole_rope_policy::Plans;
+#ifdef KUNO_SYCL_WHOLE_ROPE_TEST
+thread_local bool kuno_whole_rope_enabled=true;
+thread_local unsigned long long kuno_whole_rope_counts[9]{};
+inline void kuno_whole_rope_count(unsigned bucket) noexcept { ++kuno_whole_rope_counts[bucket]; }
+#else
+inline void kuno_whole_rope_count(unsigned) noexcept {}
+#endif
+bool kuno_whole_rope_device_chain(const ggml_tensor* tensor,int device) noexcept {
+    unsigned depth=0;
+    for(;tensor;tensor=tensor->view_src) {
+        if(++depth>ggml_sycl_whole_rope_policy::max_view_depth||!tensor->buffer||
+           !ggml_backend_buffer_is_sycl(tensor->buffer)) return false;
+        const auto* context=static_cast<ggml_backend_sycl_buffer_context*>(tensor->buffer->context);
+        if(!context||context->device!=device) return false;
+        const uintptr_t base=reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(tensor->buffer));
+        const size_t size=ggml_backend_buffer_get_size(tensor->buffer);
+        ggml_sycl_repeat_mul_policy::Span span{};
+        if(!base||size>UINTPTR_MAX-base||!ggml_sycl_repeat_mul_policy::span(tensor,span)||
+           span.first<base||span.last>base+size) return false;
+    }
+    return true;
+}
+KunoWholeRopePlans kuno_whole_rope_prepare(ggml_backend_sycl_context& context,const ggml_cgraph* graph) {
+    KunoWholeRopePlans result;
+#ifdef KUNO_SYCL_WHOLE_ROPE_TEST
+    if(!kuno_whole_rope_enabled) return result;
+#endif
+    if(!g_ggml_sycl_enable_fusion||!graph||!graph->nodes||graph->n_nodes<0||
+       graph->n_nodes>ggml_sycl_whole_rope_policy::max_graph_nodes) return result;
+    if(context.device<0||context.device>=GGML_SYCL_MAX_DEVICES||
+       !ggml_sycl_whole_rope_policy::capable(ggml_sycl_info().max_work_group_sizes[context.device],
+           g_kuno_whole_rope_max_work_item_1d[context.device])) {
+        kuno_whole_rope_count(8);
+        return result;
+    }
+#ifdef GGML_SYCL_GRAPH
+    // This initial prototype always declines a graph-capture-enabled build.
+    kuno_whole_rope_count(8);
+    return result;
+#else
+    for(int i=0;i<graph->n_nodes;++i) {
+        const auto* node=graph->nodes[i];
+        if(!node||node->op!=GGML_OP_ADD) continue;
+        kuno_whole_rope_count(0);
+        const auto plan=ggml_sycl_whole_rope_policy::find(graph,i,SYCL_BUFFER_ALIGNMENT);
+        if(!plan) {
+            const unsigned bucket=unsigned(plan.reason)+2;
+            kuno_whole_rope_count(bucket);
+            continue;
+        }
+        bool device_ok=kuno_whole_rope_device_chain(plan.source,context.device)&&
+            kuno_whole_rope_device_chain(plan.coefficient,context.device)&&
+            kuno_whole_rope_device_chain(plan.output,context.device);
+        for(int j=plan.begin;device_ok&&j<=plan.end;++j)
+            device_ok=kuno_whole_rope_device_chain(graph->nodes[j],context.device);
+        if(!device_ok) { kuno_whole_rope_count(8);continue; }
+        if(!result.append(plan)) {
+            // A capacity or interleaving ambiguity discards all plans before
+            // any submission, preserving the complete normal graph path.
+            kuno_whole_rope_count(8);
+            return result;
+        }
+    }
+    for(unsigned i=0;i<result.count;++i) kuno_whole_rope_count(1);
+    return result;
+#endif
+}
+bool kuno_whole_rope_step(ggml_backend_sycl_context& context,KunoWholeRopePlans& plans,int index) {
+    while(plans.current<plans.count&&index>plans.values[plans.current].end) ++plans.current;
+    if(plans.current==plans.count) return false;
+    const auto& plan=plans.values[plans.current];
+    if(index<plan.begin) return false;
+    if(index==plan.end) {
+        // Terminal ADD is the only submission point. Every skipped compute is
+        // in the proven closed window; earlier source storage remains intact.
+        // An uncertain submission never invokes the normal path afterwards.
+        ggml_sycl_whole_rope(context,plan.source,plan.coefficient,plan.destination);
+        kuno_whole_rope_count(2);
+        ++plans.current;
+    }
+    return true;
+}
+} // namespace
+
+#ifdef KUNO_SYCL_WHOLE_ROPE_TEST
+extern "C" void kuno_sycl_whole_rope_test_enable(bool enabled) noexcept {
+    kuno_whole_rope_enabled=enabled;
+    for(auto& count:kuno_whole_rope_counts) count=0;
+}
+extern "C" void kuno_sycl_whole_rope_test_counts(unsigned long long out[9]) noexcept {
+    if(out) for(unsigned i=0;i<9;++i) out[i]=kuno_whole_rope_counts[i];
+}
+#endif
diff --git a/src/ggml-sycl/whole-rope-policy.hpp b/src/ggml-sycl/whole-rope-policy.hpp
new file mode 100644
index 0000000..99eefeb
--- /dev/null
+++ b/src/ggml-sycl/whole-rope-policy.hpp
@@ -0,0 +1,228 @@
+#pragma once
+#include <array>
+#include "repeat-mul-policy.hpp"
+
+namespace ggml_sycl_whole_rope_policy {
+namespace bytes = ggml_sycl_repeat_mul_policy;
+constexpr int max_graph_nodes=16384;
+constexpr int max_window_nodes=32;
+constexpr int max_view_depth=8;
+constexpr int max_length=16384;
+inline bool capable(size_t max_work_group,size_t max_work_item_1d) noexcept {
+    return max_work_group>=128&&max_work_item_1d>=128;
+}
+enum class Reason:unsigned { eligible,shape,edges,use,window,overlap,graph };
+struct Plan {
+    const ggml_tensor* source=nullptr;
+    const ggml_tensor* coefficient=nullptr;
+    ggml_tensor* destination=nullptr;
+    const ggml_tensor* output=nullptr;
+    int begin=-1,end=-1;
+    Reason reason=Reason::graph;
+    explicit operator bool() const noexcept { return reason==Reason::eligible; }
+};
+constexpr unsigned max_plans=64;
+struct Plans {
+    std::array<Plan,max_plans> values{};
+    unsigned count=0,current=0;
+    bool discarded=false;
+    bool append(const Plan& plan) noexcept {
+        if(discarded||!plan||plan.begin<0||plan.end<plan.begin||plan.end>=max_graph_nodes||
+           plan.end-plan.begin>=max_window_nodes||count==max_plans||
+           (count&&plan.begin<=values[count-1].end)) {
+            discarded=true;count=0;current=0;return false;
+        }
+        values[count++]=plan;return true;
+    }
+};
+static_assert(sizeof(Plans)<=4096,"whole_rope_bounded_stack_plan");
+inline bool shape(const ggml_tensor* t,int64_t a,int64_t b,int64_t c,int64_t d) noexcept {
+    return t&&t->type==GGML_TYPE_F32&&t->ne[0]==a&&t->ne[1]==b&&t->ne[2]==c&&t->ne[3]==d;
+}
+inline bool sources(const ggml_tensor* t,ggml_op op,const ggml_tensor* a,const ggml_tensor* b=nullptr) noexcept {
+    if(!t||t->op!=op||t->src[0]!=a||t->src[1]!=b) return false;
+    for(unsigned i=2;i<GGML_MAX_SRC;++i) if(t->src[i]) return false;
+    return true;
+}
+inline bool axes(const ggml_tensor* t,int a,int b,int c,int d) noexcept {
+    const int32_t expected[]={a,b,c,d};
+    return t&&std::memcmp(t->op_params,expected,sizeof(expected))==0;
+}
+inline bool strides(const ggml_tensor* t,size_t a,size_t b,size_t c,size_t d) noexcept {
+    return t&&t->nb[0]==a&&t->nb[1]==b&&t->nb[2]==c&&t->nb[3]==d;
+}
+inline bool protected_intermediate(const ggml_tensor* t) noexcept {
+    if(t->flags&GGML_TENSOR_FLAG_OUTPUT) return true;
+    // Match the engine's complete cut marker. VIEW names inherit the cut
+    // prefix plus " (view)" and are not themselves cached segment outputs.
+    constexpr char prefix[]="ggml_runner_cut:";
+    if(std::memcmp(t->name,prefix,sizeof(prefix)-1)) return false;
+    size_t length=0;
+    while(length<sizeof(t->name)&&t->name[length]) ++length;
+    return length==sizeof(t->name)||(length&&t->name[length-1]=='|');
+}
+inline bool alias(const ggml_tensor* child,const ggml_tensor* parent,size_t offset=0) noexcept {
+    if(!child||!parent||!child->data||!parent->data) return false;
+    const auto* root=parent->view_src?parent->view_src:parent;
+    if(!root->data||root->view_src||child->view_src!=root) return false;
+    const uintptr_t base=reinterpret_cast<uintptr_t>(parent->data);
+    const uintptr_t owner=reinterpret_cast<uintptr_t>(root->data);
+    size_t absolute=0;
+    return base>=owner&&bytes::checked_add(size_t(base-owner),offset,absolute)&&
+        offset<=UINTPTR_MAX-base&&reinterpret_cast<uintptr_t>(child->data)==base+offset&&
+        child->view_offs==absolute;
+}
+inline int index_of(const ggml_cgraph* graph,const ggml_tensor* tensor) noexcept {
+    for(int i=0;i<graph->n_nodes;++i) if(graph->nodes[i]==tensor) return i;
+    return -1;
+}
+inline bool ready_chain(const ggml_cgraph* graph,const ggml_tensor* t,int before) noexcept {
+    const ggml_tensor* seen[max_view_depth]{};
+    unsigned depth=0;
+    for(;t;t=t->view_src) {
+        if(depth==max_view_depth) return false;
+        for(unsigned i=0;i<depth;++i) if(seen[i]==t) return false;
+        seen[depth++]=t;
+        const int index=index_of(graph,t);
+        if(index>=before) return false;
+        if(index<0) {
+            if(t->op!=GGML_OP_NONE) return false;
+            for(auto* source:t->src) if(source) return false;
+        }
+    }
+    return true;
+}
+inline bool output_descendant(const ggml_tensor* t,const ggml_tensor* output,const bytes::Span& extent) noexcept {
+    const ggml_tensor* seen[max_view_depth]{};
+    for(unsigned depth=0;depth<max_view_depth;++depth) {
+        if(t==output) return true;
+        if(!t||!bytes::metadata(t->op)||t->op==GGML_OP_NONE) return false;
+        for(unsigned i=0;i<depth;++i) if(seen[i]==t) return false;
+        seen[depth]=t;
+        for(unsigned i=1;i<GGML_MAX_SRC;++i) if(t->src[i]) return false;
+        bytes::Span current{};
+        const auto* source=t->src[0];
+        if(!source||!source->data||!t->data) return false;
+        const uintptr_t child=reinterpret_cast<uintptr_t>(t->data);
+        const uintptr_t parent=reinterpret_cast<uintptr_t>(source->data);
+        if(child<parent||!bytes::span(t,current)||current.first<extent.first||current.last>extent.last||
+           !alias(t,source,size_t(child-parent))) return false;
+        t=t->src[0];
+    }
+    return false;
+}
+inline Plan find(const ggml_cgraph* graph,int terminal,size_t alignment) noexcept {
+    Plan plan;
+    if(!graph||!graph->nodes||graph->n_nodes<=0||graph->n_nodes>max_graph_nodes||
+       graph->n_leafs<0||graph->n_leafs>max_graph_nodes||(graph->n_leafs&&!graph->leafs)||
+       graph->grads||graph->grad_accs||graph->order!=GGML_CGRAPH_EVAL_ORDER_LEFT_TO_RIGHT||
+       terminal<0||terminal>=graph->n_nodes||!alignment||(alignment&(alignment-1))) return plan;
+    auto* add=graph->nodes[terminal];
+    plan.reason=Reason::shape;
+    if(!add||add->op!=GGML_OP_ADD) return plan;
+    const int64_t length=add->ne[2];
+    if(length<=0||length>max_length||!bytes::dense(add,2,64,length,32)) return plan;
+    const auto* mul0=add->src[0];const auto* mul1=add->src[1];
+    const auto* repeat0=mul0?mul0->src[0]:nullptr;const auto* repeat1=mul1?mul1->src[0]:nullptr;
+    const auto* half0=repeat0?repeat0->src[0]:nullptr;const auto* half1=repeat1?repeat1->src[0]:nullptr;
+    const auto* view0=half0?half0->src[0]:nullptr;const auto* view1=half1?half1->src[0]:nullptr;
+    const auto* split=view0?view0->src[0]:nullptr;
+    const auto* perm2=split?split->src[0]:nullptr;
+    const auto* reshape=perm2?perm2->src[0]:nullptr;
+    const auto* cont=reshape?reshape->src[0]:nullptr;
+    const auto* perm1=cont?cont->src[0]:nullptr;
+    const auto* input=perm1?perm1->src[0]:nullptr;
+    const auto* pe0=mul0?mul0->src[1]:nullptr;const auto* pe1=mul1?mul1->src[1]:nullptr;
+    const auto* pe=pe0?pe0->src[0]:nullptr;
+    if(!shape(input,128,32,length,1)||input->nb[0]!=4||input->nb[1]<512||input->nb[1]%4||input->nb[2]%4||
+       input->nb[1]>SIZE_MAX/32||input->nb[2]<32*input->nb[1]||
+       !bytes::dense(pe,2,64,length,2)||!bytes::dense(cont,128,length,32,1)||
+       !bytes::dense(split,64,length,32,2)||!bytes::dense(reshape,2,64,length,32)||
+       !bytes::dense(half0,1,64,length,32)||!bytes::dense(half1,1,64,length,32)||
+       !bytes::dense(repeat0,2,64,length,32)||!bytes::dense(repeat1,2,64,length,32)||
+       !bytes::dense(mul0,2,64,length,32)||!bytes::dense(mul1,2,64,length,32)||
+       !bytes::dense(pe0,2,64,length,1)||!bytes::dense(pe1,2,64,length,1)||
+       !shape(view0,64,length,32,1)||!shape(view1,64,length,32,1)||
+       !strides(view0,4,256,256*size_t(length),8192*size_t(length))||
+       !strides(view1,4,256,256*size_t(length),8192*size_t(length))||
+       !shape(perm1,128,length,32,1)||!strides(perm1,input->nb[0],input->nb[2],input->nb[1],input->nb[3])||
+       !shape(perm2,64,length,32,2)||!strides(perm2,8,512,512*size_t(length),4)) return plan;
+    plan.reason=Reason::edges;
+    if(!sources(perm1,GGML_OP_PERMUTE,input)||!axes(perm1,0,2,1,3)||!alias(perm1,input)||
+       !sources(cont,GGML_OP_CONT,perm1)||cont->view_src||
+       !sources(reshape,GGML_OP_RESHAPE,cont)||!alias(reshape,cont)||
+       !sources(perm2,GGML_OP_PERMUTE,reshape)||!axes(perm2,3,0,1,2)||!alias(perm2,reshape)||
+       !sources(split,GGML_OP_CONT,perm2)||split->view_src||
+       !sources(view0,GGML_OP_VIEW,split)||!alias(view0,split)||
+       !sources(view1,GGML_OP_VIEW,split)||!alias(view1,split,8192*size_t(length))||
+       !sources(half0,GGML_OP_RESHAPE,view0)||!alias(half0,view0)||
+       !sources(half1,GGML_OP_RESHAPE,view1)||!alias(half1,view1)||
+       !sources(repeat0,GGML_OP_REPEAT,half0)||repeat0->view_src||
+       !sources(repeat1,GGML_OP_REPEAT,half1)||repeat1->view_src||
+       !sources(pe0,GGML_OP_VIEW,pe)||!alias(pe0,pe)||
+       !sources(pe1,GGML_OP_VIEW,pe)||!alias(pe1,pe,512*size_t(length))||
+       !sources(mul0,GGML_OP_MUL,repeat0,pe0)||mul0->view_src||
+       !sources(mul1,GGML_OP_MUL,repeat1,pe1)||mul1->view_src||
+       !sources(add,GGML_OP_ADD,mul0,mul1)||!alias(add,mul0)) return plan;
+    const ggml_tensor* output=nullptr;
+    for(int i=0;i<graph->n_nodes;++i) {
+        const auto* node=graph->nodes[i];if(!node) return plan;
+        if(node->src[0]==add) {
+            if(output||!sources(node,GGML_OP_RESHAPE,add)||!bytes::dense(node,128,length,32,1)||!alias(node,add)) return plan;
+            output=node;
+        }
+    }
+    if(!output) return plan;
+    const std::array<const ggml_tensor*,17> chain={perm1,cont,reshape,perm2,split,view0,half0,repeat0,pe0,mul0,view1,half1,repeat1,pe1,mul1,add,output};
+    for(unsigned i=0;i<chain.size();++i) for(unsigned j=0;j<i;++j) if(chain[i]==chain[j]) return plan;
+    // Require this exact subtree to be present once in the executable graph.
+    // Source edges, rather than flattened view_src owners, define topology.
+    std::array<int,17> positions{};
+    positions.fill(-1);
+    for(int i=0;i<graph->n_nodes;++i) for(unsigned c=0;c<chain.size();++c) if(graph->nodes[i]==chain[c]) {
+        if(positions[c]!=-1) return plan;
+        positions[c]=i;
+    }
+    for(unsigned c=0;c<chain.size();++c) {
+        if(positions[c]<0) return plan;
+        for(const auto* source:chain[c]->src) for(unsigned s=0;s<chain.size();++s)
+            if(source==chain[s]&&positions[s]>=positions[c]) return plan;
+    }
+    plan.reason=Reason::use;
+    bytes::Span output_extent{};
+    if(!bytes::span(output,output_extent)) return plan;
+    for(unsigned c=0;c+1<chain.size();++c) if(protected_intermediate(chain[c])) return plan;
+    auto check_uses=[&](const ggml_tensor* node) {
+        if(!node) return false;
+        bool internal=false;
+        for(const auto* part:chain) internal|=node==part;
+        if(internal) return true; // All source/root edges were verified above.
+        for(const auto* source:node->src) for(unsigned c=0;c+1<chain.size();++c) if(source==chain[c]) return false;
+        for(unsigned c=0;c+1<chain.size();++c) if(node->view_src==chain[c]) {
+            if(chain[c]!=mul0||!output_descendant(node,output,output_extent)) return false;
+        }
+        return true;
+    };
+    for(int i=0;i<graph->n_nodes;++i) if(!check_uses(graph->nodes[i])) return plan;
+    for(int i=0;i<graph->n_leafs;++i) if(!check_uses(graph->leafs[i])) return plan;
+    plan.reason=Reason::window;
+    const int begin=index_of(graph,cont);
+    if(begin<0||terminal<begin||terminal-begin>=max_window_nodes||positions[0]>=begin||positions[16]<=terminal||
+       !ready_chain(graph,input,begin)||!ready_chain(graph,pe,begin)) return plan;
+    const std::array<const ggml_tensor*,7> compute={cont,split,repeat0,mul0,repeat1,mul1,add};
+    unsigned found=0;
+    for(int i=begin;i<=terminal;++i) {
+        const auto* node=graph->nodes[i];bool internal=false;
+        for(const auto* part:chain) internal|=node==part;
+        if(!internal) return plan;
+        if(bytes::metadata(node->op)) continue;
+        if(found==compute.size()||node!=compute[found++]||!(node->flags&GGML_TENSOR_FLAG_COMPUTE)) return plan;
+    }
+    if(found!=compute.size()) return plan;
+    plan.reason=Reason::overlap;
+    bytes::Span written{};
+    if(!bytes::span(add,written)||written.first%alignment||written.first!=output_extent.first||written.last!=output_extent.last||
+       !bytes::read_chain(input,written,alignment)||!bytes::read_chain(pe,written,alignment)) return plan;
+    plan={input,pe,add,output,begin,terminal,Reason::eligible};return plan;
+}
+} // namespace ggml_sycl_whole_rope_policy
