+// KUNO_DEV_OP_PROFILE: development-only synchronous per-op timing (shapes only).
+#include <chrono>
+#include <map>
+#include <string>
+namespace {
+struct kuno_dev_prof {
+    bool on = getenv("KUNO_DEV_OP_PROFILE") != nullptr;
+    struct row { int64_t n = 0; double sum = 0, mn = 1e30; };
+    std::map<std::string, row> rows;
+    std::string key; std::chrono::steady_clock::time_point t;
+    void begin(ggml_backend_sycl_context & ctx, const ggml_tensor * n) {
+        end(ctx);
+        char b[256];
+        snprintf(b, sizeof b, "%s %s<-%s [%lld,%lld,%lld,%lld]", ggml_op_desc(n), ggml_type_name(n->type),
+                 n->src[0] ? ggml_type_name(n->src[0]->type) : "-", (long long) n->ne[0], (long long) n->ne[1],
+                 (long long) n->ne[2], (long long) n->ne[3]);
+        key = b; t = std::chrono::steady_clock::now();
+    }
+    void end(ggml_backend_sycl_context & ctx) {
+        if (key.empty()) return;
+        ctx.stream()->wait();
+        auto & r = rows[key]; r.n++;
+        const double d = std::chrono::duration<double>(std::chrono::steady_clock::now() - t).count();
+        r.sum += d; r.mn = std::min(r.mn, d);
+        static const char * trace = getenv("KUNO_DEV_OP_TRACE");
+        if (trace && key.find(trace) != std::string::npos) fprintf(stderr, "KUNO_DEV_TRACE %.3f ms %s\n", d * 1e3, key.c_str());
+        key.clear();
+    }
+    ~kuno_dev_prof() { dump(); }
+    void dump() {
+        if (!on || rows.empty()) return;
+        std::vector<std::pair<double, std::string>> v; double total = 0;
+        for (auto & [k, r] : rows) {
+            char b[96]; snprintf(b, sizeof b, " n=%lld min=%.3fms", (long long) r.n, r.mn * 1e3);
+            v.push_back({r.sum, k + b}); total += r.sum;
+        }
+        std::sort(v.rbegin(), v.rend());
+        fprintf(stderr, "KUNO_DEV_PROF total %.3f s\n", total);
+        for (auto & [sec, k] : v) fprintf(stderr, "KUNO_DEV_PROF %9.3f ms %5.1f%% %s\n", sec * 1e3, 100 * sec / total, k.c_str());
+    }
+};
+kuno_dev_prof g_kuno_dev_prof;
+}
+// Called by the dev shim's progress callback: reset after step 2, dump at the last step.
+extern "C" void kuno_dev_prof_mark(int step, int steps) {
+    if (!g_kuno_dev_prof.on) return;
+    if (step == 2) { g_kuno_dev_prof.rows.clear(); g_kuno_dev_prof.key.clear(); }
+    if (step == steps) {
+        fprintf(stderr, "KUNO_DEV_PROF steps %d\n", steps - 2);
+        g_kuno_dev_prof.dump(); g_kuno_dev_prof.rows.clear(); g_kuno_dev_prof.key.clear();
+    }
+}
