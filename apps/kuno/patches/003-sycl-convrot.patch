index 0000000..7899841
--- /dev/null
+++ b/src/ggml-sycl/convrot-policy.hpp
@@ -0,0 +1,44 @@
+// Experimental ConvRot geometry shared by the SYCL dispatcher and CPU tests.
+#pragma once
+#include "ggml.h"
+#include "ggml-impl.h"
+#include <limits>
+
+inline bool ggml_sycl_convrot_geometry(const ggml_tensor * dst, bool matmul) {
+    if (!dst || !ggml_is_contiguous(dst)) return false;
+    const ggml_tensor * weight = matmul ? dst->src[0] : nullptr;
+    const ggml_tensor * input = matmul ? dst->src[1] : dst->src[0];
+    if (!input || !ggml_is_contiguous(input)) return false;
+    const bool packed = input->type == GGML_TYPE_I8;
+    const ggml_tensor * logical = packed ? input->src[0] : input;
+    if (!logical || logical->type != GGML_TYPE_F32 || !ggml_is_contiguous(logical)) return false;
+    const int64_t k = logical->ne[0], rows = ggml_nrows(logical);
+    // Signed INT8 weights include -128, activations are in [-127,127].
+    // Bound the worst possible dot product before selecting I32 accumulation.
+    if (k <= 0 || k > std::numeric_limits<int32_t>::max() / (128 * 127) ||
+        k % 4 != 0 || rows <= 0 || rows > std::numeric_limits<int32_t>::max() - 3) return false;
+    const int group = ggml_get_op_params_i32(dst, matmul ? 2 : 0);
+    if ((group != 0 && group != 256) || (group == 256 && k % 256 != 0)) return false;
+    if (!matmul && (group != 256 || packed || dst->type != GGML_TYPE_I8)) return false;
+    const int64_t padded = (rows + 3) / 4 * 4;
+    const int64_t scale_rows = (rows * sizeof(float) + k - 1) / k;
+    const ggml_tensor * packed_tensor = matmul ? input : dst;
+    if (packed || !matmul) {
+        if (packed_tensor->op != GGML_OP_QUANTIZE_I8_CONVROT ||
+            ggml_get_op_params_i32(packed_tensor, 0) != 256 || group != 256 ||
+            packed_tensor->ne[0] != k || packed_tensor->ne[1] != padded + scale_rows ||
+            packed_tensor->ne[2] != 1 || packed_tensor->ne[3] != 1) return false;
+    }
+    if (!matmul) return true;
+    const ggml_tensor * scales = dst->src[2], * bias = dst->src[3];
+    if (!weight || weight->type != GGML_TYPE_I8 || !ggml_is_contiguous(weight) ||
+        weight->ne[0] != k || weight->ne[1] <= 0 || weight->ne[1] > std::numeric_limits<int32_t>::max() ||
+        weight->ne[2] != 1 || weight->ne[3] != 1 || dst->type != GGML_TYPE_F32 ||
+        dst->ne[0] != weight->ne[1] || dst->ne[1] != logical->ne[1] ||
+        dst->ne[2] != logical->ne[2] || dst->ne[3] != logical->ne[3] ||
+        !scales || scales->type != GGML_TYPE_F32 || !ggml_is_contiguous(scales) ||
+        ggml_nelements(scales) != weight->ne[1] ||
+        (bias && (bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) ||
+                  ggml_nelements(bias) != weight->ne[1]))) return false;
+    return uint64_t(weight->ne[1]) * uint64_t(padded) <= std::numeric_limits<size_t>::max() / sizeof(int32_t);
+}
diff --git a/src/ggml-sycl/convrot.cpp b/src/ggml-sycl/convrot.cpp
new file mode 100644
index 0000000..96f7ed5
--- /dev/null
+++ b/src/ggml-sycl/convrot.cpp
@@ -0,0 +1,121 @@
+// Experimental native signed INT8 tensorwise GEMM for Qwen ConvRot weights.
+#include "convrot.hpp"
+#include <oneapi/mkl/blas.hpp>
+
+bool ggml_sycl_convrot_device_supported(const sycl::device & d) {
+    return d.is_gpu() && d.get_backend() == sycl::backend::ext_oneapi_level_zero &&
+           d.get_info<sycl::info::device::vendor_id>() == 0x8086 &&
+           d.get_info<sycl::info::device::max_work_group_size>() >= 64 &&
+           d.get_info<sycl::info::device::local_mem_size>() >= 320 * sizeof(float);
+}
+
+static void quantize(ggml_backend_sycl_context & ctx, const float * x, int8_t * q,
+                     float * scales, int64_t k, int64_t rows, int group_size) {
+    auto queue = ctx.stream();
+    GGML_ASSERT(queue->has_property<sycl::property::queue::in_order>());
+    const int64_t padded = (rows + 3) / 4 * 4;
+    if (padded > rows) queue->memset(q + rows * k, 0, (padded - rows) * k);
+    queue->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> values(256, h), maxima(64, h);
+        h.parallel_for(sycl::nd_range<1>(rows * 64, 64), [=](sycl::nd_item<1> it) {
+            const int64_t row = it.get_group(0), tid = it.get_local_id(0);
+            auto transform = [&](int64_t group) {
+                for (int i = 0; i < 4; ++i) values[tid + i * 64] = x[row*k + group*256 + tid+i*64] / 16.f;
+                it.barrier(sycl::access::fence_space::local_space);
+                for (int stride = 1; stride < 256; stride *= 4) {
+                    const int at = (tid / stride) * 4 * stride + tid % stride;
+                    const float a = values[at], b = values[at+stride], c = values[at+2*stride], d = values[at+3*stride];
+                    values[at] = a+b+c-d; values[at+stride] = a+b-c+d;
+                    values[at+2*stride] = a-b+c+d; values[at+3*stride] = -a+b+c+d;
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            };
+            float maximum = 0.f;
+            if (group_size == 256) {
+                for (int64_t group = 0; group < k / 256; ++group) {
+                    transform(group);
+                    for (int i = 0; i < 4; ++i) maximum = sycl::fmax(maximum, sycl::fabs(values[tid+i*64]));
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            } else {
+                for (int64_t col = tid; col < k; col += 64) maximum = sycl::fmax(maximum, sycl::fabs(x[row*k+col]));
+            }
+            maxima[tid] = maximum;
+            it.barrier(sycl::access::fence_space::local_space);
+            for (int stride = 32; stride > 0; stride /= 2) {
+                if (tid < stride) maxima[tid] = sycl::fmax(maxima[tid], maxima[tid+stride]);
+                it.barrier(sycl::access::fence_space::local_space);
+            }
+            const float scale = maxima[0] / 127.f;
+            if (tid == 0) scales[row] = scale;
+            const float inverse = scale == 0.f ? 0.f : 1.f / scale;
+            auto rounded = [&](float value) {
+                if (scale == 0.f) return int8_t(0);
+                const float scaled = value * inverse;
+                // Nonfinite activations have no usable row scale. Avoid a
+                // float-to-integer UB; ordinary finite rows retain ties-even.
+                if (!sycl::isfinite(scaled)) return int8_t(0);
+                return int8_t(sycl::clamp(sycl::rint(scaled), -127.f, 127.f));
+            };
+            if (group_size == 256) {
+                for (int64_t group = 0; group < k / 256; ++group) {
+                    transform(group);
+                    for (int i = 0; i < 4; ++i) q[row*k + group*256 + tid+i*64] = rounded(values[tid+i*64]);
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            } else {
+                for (int64_t col = tid; col < k; col += 64) q[row*k+col] = rounded(x[row*k+col]);
+            }
+        });
+    });
+}
+
+void ggml_sycl_quantize_i8_convrot(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_sycl_convrot_geometry(dst, false));
+    const auto x = dst->src[0];
+    const int64_t rows = ggml_nrows(x), padded = (rows + 3) / 4 * 4;
+    auto bytes = static_cast<int8_t *>(dst->data);
+    // Deterministic unused scale-slot bytes, in addition to zero padded rows.
+    ctx.stream()->memset(bytes + x->ne[0] * padded, 0, ggml_nbytes(dst) - x->ne[0] * padded);
+    quantize(ctx, static_cast<const float *>(x->data), bytes,
+             reinterpret_cast<float *>(bytes + x->ne[0] * padded), x->ne[0], rows, 256);
+}
+
+void ggml_sycl_mul_mat_i8_convrot(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_sycl_convrot_geometry(dst, true));
+    const auto weight = dst->src[0], input = dst->src[1];
+    const int64_t k = weight->ne[0], n = weight->ne[1], rows = ggml_nrows(dst), padded = (rows+3)/4*4;
+    auto queue = ctx.stream();
+    GGML_ASSERT(queue->has_property<sycl::property::queue::in_order>());
+    ggml_sycl_pool_alloc<int8_t> temporary_input(ctx.pool());
+    ggml_sycl_pool_alloc<float> temporary_scales(ctx.pool());
+    const int8_t * q = static_cast<const int8_t *>(input->data);
+    const float * activation_scales = nullptr;
+    if (input->type == GGML_TYPE_I8) activation_scales = reinterpret_cast<const float *>(q+k*padded);
+    else {
+        q = temporary_input.alloc(k*padded);
+        activation_scales = temporary_scales.alloc(rows);
+        quantize(ctx, static_cast<const float *>(input->data), const_cast<int8_t *>(q),
+                 const_cast<float *>(activation_scales), k, rows, ggml_get_op_params_i32(dst, 2));
+    }
+    ggml_sycl_pool_alloc<int32_t> temporary_accum(ctx.pool(), n*padded);
+    auto accum = temporary_accum.get();
+    auto gemm = oneapi::mkl::blas::column_major::gemm(*queue, oneapi::mkl::transpose::trans,
+        oneapi::mkl::transpose::nontrans, n, padded, k, int32_t(1),
+        static_cast<const int8_t *>(weight->data), k, q, k, int32_t(0), accum, n,
+        oneapi::mkl::blas::compute_mode::standard);
+    auto scales = static_cast<const float *>(dst->src[2]->data);
+    auto bias = dst->src[3] ? static_cast<const float *>(dst->src[3]->data) : nullptr;
+    auto output = static_cast<float *>(dst->data);
+    queue->submit([&](sycl::handler & h) {
+        h.depends_on(gemm);
+        h.parallel_for(sycl::range<1>(rows*n), [=](sycl::id<1> at) {
+            const int64_t i = at[0], row = i/n, col = i%n;
+            float value = float(accum[i]) * activation_scales[row];
+            value *= scales[col];
+            if (bias) value += bias[col];
+            output[i] = value;
+        });
+    });
+    // Pool allocations are stream-ordered, like existing SYCL GEMM scratch.
+}
