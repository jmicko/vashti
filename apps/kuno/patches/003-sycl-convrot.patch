+// Lookahead for MUL_MAT(i8) [-> SCALE] -> ... -> MUL(gate) -> ADD(residual). Nodes in
+// between may only be independent small gate computations, which run first.
+static bool kuno_try_epilogue_fusion(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int & i) {
+    ggml_tensor * mm = cgraph->nodes[i];
+    if (!g_ggml_sycl_enable_fusion || !ggml_node_has_n_uses(cgraph, i, 1)) return false;
+    auto consumer = [&](int from, const ggml_tensor * t) {
+        for (int j = from + 1; j < std::min(cgraph->n_nodes, from + 10); ++j)
+            for (int q = 0; q < GGML_MAX_SRC; ++q) if (cgraph->nodes[j]->src[q] == t) return j;
+        return -1;
+    };
+    int j = consumer(i, mm);
+    if (j < 0) return false;
+    ggml_tensor * scale = nullptr; int scale_index = -1;
+    if (cgraph->nodes[j]->op == GGML_OP_SCALE) {
+        scale = cgraph->nodes[j]; scale_index = j;
+        if (!ggml_node_has_n_uses(cgraph, j, 1)) return false;
+        j = consumer(j, scale);
+        if (j < 0) return false;
+    }
+    if (j + 1 >= cgraph->n_nodes || cgraph->nodes[j]->op != GGML_OP_MUL || cgraph->nodes[j + 1]->op != GGML_OP_ADD ||
+        !ggml_sycl_mul_add_graph_safe(cgraph, j)) return false;
+    // Everything strictly between must be independent and cheap.
+    for (int q = i + 1; q < j; ++q) {
+        if (q == scale_index) continue;
+        const auto op = cgraph->nodes[q]->op;
+        if (op != GGML_OP_CONT && op != GGML_OP_UNARY && op != GGML_OP_SCALE && op != GGML_OP_VIEW &&
+            op != GGML_OP_RESHAPE && op != GGML_OP_PERMUTE && op != GGML_OP_TRANSPOSE && op != GGML_OP_NONE) return false;
+        for (int r = 0; r < GGML_MAX_SRC; ++r)
+            if (cgraph->nodes[q]->src[r] == mm || (scale && cgraph->nodes[q]->src[r] == scale)) return false;
+    }
+    if (!ggml_sycl_mul_add_memory_safe(cgraph->nodes[j], cgraph->nodes[j + 1])) return false;
+    for (int q = i + 1; q < j; ++q) {
+        ggml_tensor * t = cgraph->nodes[q];
+        if (q == scale_index || ggml_is_empty(t) || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_TRANSPOSE || t->op == GGML_OP_VIEW ||
+            t->op == GGML_OP_PERMUTE || t->op == GGML_OP_NONE || (t->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) continue;
+        GGML_ASSERT(ggml_sycl_compute_forward(ctx, t));
+    }
+    if (!ggml_sycl_mul_mat_i8_convrot_epilogue(ctx, mm, scale, cgraph->nodes[j], cgraph->nodes[j + 1])) {
