diff --git a/src/ggml-sycl/fattn-onednn-shapes.hpp b/src/ggml-sycl/fattn-onednn-shapes.hpp
new file mode 100644
index 0000000..0b81ddd
--- /dev/null
+++ b/src/ggml-sycl/fattn-onednn-shapes.hpp
@@ -0,0 +1,66 @@
+#pragma once
+
+#include "ggml.h"
+#include <cmath>
+#include <cstring>
+#include <initializer_list>
+#include <limits>
+
+// Hardware-independent envelope for the strided staging kernels and the
+// contiguous oneDNN SDPA graph. Unsupported layouts retain native attention.
+inline bool ggml_sycl_onednn_sdpa_shape_supported(const ggml_tensor * dst) {
+    if (!dst || dst->op != GGML_OP_FLASH_ATTN_EXT || dst->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    const auto * Q = dst->src[0];
+    const auto * K = dst->src[1];
+    const auto * V = dst->src[2];
+    const auto * mask = dst->src[3];
+    if (!Q || !K || !V || dst->src[4] || Q->type != GGML_TYPE_F32 ||
+        Q->nb[0] != sizeof(float)) {
+        return false;
+    }
+    for (const auto * t : {Q, K, V}) {
+        for (const auto dim : t->ne) {
+            if (dim <= 0 || dim > std::numeric_limits<int>::max()) return false;
+        }
+    }
+    if (Q->ne[3] != 1 || K->ne[3] != 1 || V->ne[3] != 1 ||
+        Q->ne[0] != K->ne[0] || V->ne[0] != K->ne[0] ||
+        K->ne[1] != V->ne[1] || K->ne[2] != V->ne[2] ||
+        Q->ne[2] % K->ne[2] != 0 || Q->ne[1] < 32) {
+        return false;
+    }
+    // The new unmasked path targets Qwen MHA at head dimension 128. Other
+    // unmasked shapes remain native until separately validated on Xe2.
+    if (!mask && (K->ne[0] != 128 || Q->ne[2] != K->ne[2])) return false;
+    if (mask && (mask->type != GGML_TYPE_F16 || mask->ne[0] != K->ne[1] ||
+                 mask->ne[1] < Q->ne[1] || mask->ne[2] != 1 || mask->ne[3] != 1 ||
+                 mask->nb[0] != sizeof(ggml_fp16_t) ||
+                 mask->nb[1] != size_t(K->ne[1]) * sizeof(ggml_fp16_t))) {
+        return false;
+    }
+    const bool half_kv = K->type == GGML_TYPE_F16 && V->type == GGML_TYPE_F16;
+    auto convertible = [](ggml_type type) {
+        return type == GGML_TYPE_F32 || type == GGML_TYPE_Q4_0 || type == GGML_TYPE_Q4_1 ||
+               type == GGML_TYPE_Q5_0 || type == GGML_TYPE_Q5_1 || type == GGML_TYPE_Q8_0;
+    };
+    if (!half_kv && (!convertible(K->type) || !convertible(V->type) || K->ne[1] < 1024 ||
+                    ggml_is_quantized(K->type) != ggml_is_quantized(V->type))) return false;
+    for (const auto * t : {K, V}) {
+        if ((t->type == GGML_TYPE_F16 && t->nb[0] != sizeof(ggml_fp16_t)) ||
+            (t->type == GGML_TYPE_F32 && t->nb[0] != sizeof(float))) return false;
+    }
+    float scale, max_bias, softcap;
+    std::memcpy(&scale, dst->op_params, sizeof(float));
+    std::memcpy(&max_bias, reinterpret_cast<const char *>(dst->op_params) + sizeof(float), sizeof(float));
+    std::memcpy(&softcap, reinterpret_cast<const char *>(dst->op_params) + 2 * sizeof(float), sizeof(float));
+    // The graph divides by an F16 reciprocal captured by value in a kernel.
+    // A zero/overflowed reciprocal cannot reproduce the requested attention.
+    if (!(scale > 0) || !std::isfinite(scale) || max_bias != 0 || softcap != 0) return false;
+    const float reciprocal = ggml_fp16_to_fp32(ggml_fp32_to_fp16(1.0f / scale));
+    if (!(reciprocal > 0) || !std::isfinite(reciprocal)) return false;
+    const auto precision = ggml_flash_attn_ext_get_prec(dst);
+    return precision == GGML_PREC_DEFAULT || precision == GGML_PREC_F32;
+}
