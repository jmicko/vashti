--- /dev/null
+++ b/src/ggml-sycl/cpy-offset.hpp
@@ -0,0 +1,23 @@
+#ifndef GGML_SYCL_CPY_OFFSET_HPP
+#define GGML_SYCL_CPY_OFFSET_HPP
+
+#include <cstddef>
+#include <cstdint>
+
+// GGML byte strides can exceed INT32_MAX even when the scalar element index
+// fits in a signed int. Keep them wide through every caller and multiplication.
+static inline size_t ggml_sycl_cpy_byte_offset(
+        int64_t index, const int64_t ne0, const int64_t ne1, const int64_t ne2,
+        const size_t nb0, const size_t nb1, const size_t nb2, const size_t nb3,
+        const int64_t block = 1) {
+    const int64_t i0 = index % ne0;
+    index /= ne0;
+    const int64_t i1 = index % ne1;
+    index /= ne1;
+    const int64_t i2 = index % ne2;
+    const int64_t i3 = index / ne2;
+    return size_t(i0 / block) * nb0 + size_t(i1) * nb1 +
+           size_t(i2) * nb2 + size_t(i3) * nb3;
+}
+
+#endif
