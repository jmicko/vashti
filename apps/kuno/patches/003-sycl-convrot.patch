diff --git a/src/ggml-sycl/pci-address.hpp b/src/ggml-sycl/pci-address.hpp
new file mode 100644
index 0000000..9907438
--- /dev/null
+++ b/src/ggml-sycl/pci-address.hpp
@@ -0,0 +1,14 @@
+#pragma once
+#include <string>
+
+// The device extension must supply an exact conventional domain:bus:slot.func.
+inline std::string ggml_sycl_canonical_pci_address(std::string pci) {
+    if (pci.size() != 12 || pci[4] != ':' || pci[7] != ':' || pci[10] != '.') return {};
+    for (size_t at = 0; at < pci.size(); ++at) {
+        if (at == 4 || at == 7 || at == 10) continue;
+        if (pci[at] >= 'A' && pci[at] <= 'F') pci[at] += 'a' - 'A';
+        if (!((pci[at] >= '0' && pci[at] <= '9') || (pci[at] >= 'a' && pci[at] <= 'f'))) return {};
+    }
+    if (pci[8] > '1' || pci[11] > '7') return {}; // PCI slot <=31, function <=7.
+    return pci;
+}
