diff --git a/src/ggml-sycl/whole-rope.cpp b/src/ggml-sycl/whole-rope.cpp
new file mode 100644
index 0000000..70ff0ff
--- /dev/null
+++ b/src/ggml-sycl/whole-rope.cpp
@@ -0,0 +1,46 @@
+#include "whole-rope.hpp"
+
+#ifdef KUNO_SYCL_WHOLE_ROPE_BYPASS
+#include "binbcast.hpp"
+
+// This experimental TU requires explicit precise/no-fast-math/no-contraction
+// flags. Volatile F32 intermediates additionally expose the two rounding
+// boundaries; device NaN payload/zero/denormal equivalence needs native tests.
+#if defined(__FAST_MATH__)
+#error "whole_rope_requires_no_fast_math"
+#endif
+#if defined(__clang__)
+#pragma clang fp contract(off)
+#pragma clang fp reassociate(off)
+#endif
+
+void ggml_sycl_whole_rope(ggml_backend_sycl_context& context,
+    const ggml_tensor* input,const ggml_tensor* prepared_pe,ggml_tensor* output) {
+    const char* x=static_cast<const char*>(input->data);
+    const float* pe=static_cast<const float*>(prepared_pe->data);
+    float* destination=static_cast<float*>(output->data);
+    const size_t length=size_t(input->ne[2]);
+    const size_t head_stride=input->nb[1],token_stride=input->nb[2];
+    const size_t pairs=64*length*32;
+    constexpr size_t local_size=128;
+    const size_t global_size=((pairs+local_size-1)/local_size)*local_size;
+    // Only immutable scalar descriptors/pointers are captured. No tensor/plan
+    // host address, device scratch, waits, cache or asynchronous fallback.
+    context.stream()->parallel_for(sycl::nd_range<1>(global_size,local_size),
+        [=](sycl::nd_item<1> item) {
+            const size_t i=item.get_global_linear_id();
+            if(i>=pairs) return;
+            const size_t pair=i%64;
+            const size_t token=(i/64)%length,head=i/(64*length);
+            const float* original=reinterpret_cast<const float*>(x+head*head_stride+token*token_stride+pair*8);
+            const float x0=original[0],x1=original[1];
+            const size_t coefficient=2*pair+128*token;
+            const size_t result=2*pair+128*(token+length*head);
+            for(size_t component=0;component<2;++component) {
+                volatile float product0=op_mul(x0,pe[coefficient+component]);
+                volatile float product1=op_mul(x1,pe[coefficient+component+128*length]);
+                destination[result+component]=op_add(product0,product1);
+            }
+        });
+}
+#endif
