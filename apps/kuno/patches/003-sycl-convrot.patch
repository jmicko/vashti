diff --git a/src/ggml-sycl/convrot-policy.hpp b/src/ggml-sycl/convrot-policy.hpp
new file mode 100644
index 0000000..7899841
--- /dev/null
+++ b/src/ggml-sycl/convrot-policy.hpp
@@ -0,0 +1,44 @@
+// Experimental ConvRot geometry shared by the SYCL dispatcher and CPU tests.
+#pragma once
+#include "ggml.h"
+#include "ggml-impl.h"
+#include <limits>
+
+inline bool ggml_sycl_convrot_geometry(const ggml_tensor * dst, bool matmul) {
+    if (!dst || !ggml_is_contiguous(dst)) return false;
+    const ggml_tensor * weight = matmul ? dst->src[0] : nullptr;
+    const ggml_tensor * input = matmul ? dst->src[1] : dst->src[0];
+    if (!input || !ggml_is_contiguous(input)) return false;
+    const bool packed = input->type == GGML_TYPE_I8;
+    const ggml_tensor * logical = packed ? input->src[0] : input;
+    if (!logical || logical->type != GGML_TYPE_F32 || !ggml_is_contiguous(logical)) return false;
+    const int64_t k = logical->ne[0], rows = ggml_nrows(logical);
+    // Signed INT8 weights include -128, activations are in [-127,127].
+    // Bound the worst possible dot product before selecting I32 accumulation.
+    if (k <= 0 || k > std::numeric_limits<int32_t>::max() / (128 * 127) ||
+        k % 4 != 0 || rows <= 0 || rows > std::numeric_limits<int32_t>::max() - 3) return false;
+    const int group = ggml_get_op_params_i32(dst, matmul ? 2 : 0);
+    if ((group != 0 && group != 256) || (group == 256 && k % 256 != 0)) return false;
+    if (!matmul && (group != 256 || packed || dst->type != GGML_TYPE_I8)) return false;
+    const int64_t padded = (rows + 3) / 4 * 4;
+    const int64_t scale_rows = (rows * sizeof(float) + k - 1) / k;
+    const ggml_tensor * packed_tensor = matmul ? input : dst;
+    if (packed || !matmul) {
+        if (packed_tensor->op != GGML_OP_QUANTIZE_I8_CONVROT ||
+            ggml_get_op_params_i32(packed_tensor, 0) != 256 || group != 256 ||
+            packed_tensor->ne[0] != k || packed_tensor->ne[1] != padded + scale_rows ||
+            packed_tensor->ne[2] != 1 || packed_tensor->ne[3] != 1) return false;
+    }
+    if (!matmul) return true;
+    const ggml_tensor * scales = dst->src[2], * bias = dst->src[3];
+    if (!weight || weight->type != GGML_TYPE_I8 || !ggml_is_contiguous(weight) ||
+        weight->ne[0] != k || weight->ne[1] <= 0 || weight->ne[1] > std::numeric_limits<int32_t>::max() ||
+        weight->ne[2] != 1 || weight->ne[3] != 1 || dst->type != GGML_TYPE_F32 ||
+        dst->ne[0] != weight->ne[1] || dst->ne[1] != logical->ne[1] ||
+        dst->ne[2] != logical->ne[2] || dst->ne[3] != logical->ne[3] ||
+        !scales || scales->type != GGML_TYPE_F32 || !ggml_is_contiguous(scales) ||
+        ggml_nelements(scales) != weight->ne[1] ||
+        (bias && (bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) ||
+                  ggml_nelements(bias) != weight->ne[1]))) return false;
+    return uint64_t(weight->ne[1]) * uint64_t(padded) <= std::numeric_limits<size_t>::max() / sizeof(int32_t);
+}
diff --git a/src/ggml-sycl/convrot.cpp b/src/ggml-sycl/convrot.cpp
new file mode 100644
index 0000000..4233c77
--- /dev/null
+++ b/src/ggml-sycl/convrot.cpp
@@ -0,0 +1,344 @@
+// Experimental native signed INT8 tensorwise GEMM for Qwen ConvRot weights.
+#include "convrot.hpp"
+#include "element_wise.hpp"
+#include <oneapi/mkl/blas.hpp>
+#include <sycl/ext/intel/math/imf_rounding_math.hpp>
+
+bool ggml_sycl_convrot_device_supported(const sycl::device & d) {
+    return d.is_gpu() && d.get_backend() == sycl::backend::ext_oneapi_level_zero &&
+           d.get_info<sycl::info::device::vendor_id>() == 0x8086 &&
+           d.get_info<sycl::info::device::max_work_group_size>() >= 64 &&
+           d.get_info<sycl::info::device::local_mem_size>() >= 320 * sizeof(float);
+}
+
+
+// Row-parallel ConvRot quantizer. Each work-group quantizes one row with 16
+// sub-groups; each sub-group owns G consecutive 256-value rotation groups.
+// The radix-4 stages run in the original order (strides 1, 4, 16, 64) with the
+// original expressions, so rotated values, row scales and INT8 bytes are
+// bit-identical to the legacy shared-memory kernel (verified including
+// subnormal, zero, infinite and NaN rows).
+#define KB4(v, i0, i1, i2, i3) { const float a = v[i0], b = v[i1], c = v[i2], d = v[i3]; \
+    v[i0] = a+b+c-d; v[i1] = a+b-c+d; v[i2] = a-b+c+d; v[i3] = -a+b+c+d; }
+// 16 sub-groups per row; each sub-group owns G consecutive 256-value groups.
+struct convrot_load_f32 {
+    const float * x; int64_t k;
+    float operator()(int64_t row, int64_t e) const { return x[row * k + e]; }
+};
+
+template <int G, typename Load>
+static void quantize_rows_sg_load(sycl::queue & Q, Load load, int8_t * q, float * scales, int64_t k, int64_t rows) {
+    Q.submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> maxima(16, h), tile(16 * 16 * 17, h);
+        h.parallel_for(sycl::nd_range<1>(rows * 256, 256), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            auto sg = it.get_sub_group();
+            const int64_t row = it.get_group(0);
+            const int s = int(sg.get_group_linear_id());
+            const int lane = int(sg.get_local_linear_id());
+            float * t = &tile[s * 16 * 17];
+            float v[G][16];
+            float maximum = 0.f;
+#pragma unroll
+            for (int g = 0; g < G; ++g) {
+                const int64_t base = (s * G + g) * 256;
+                if (g) sycl::group_barrier(sg);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) t[j * 17 + lane] = load(row, base + j * 16 + lane) / 16.f;
+                sycl::group_barrier(sg);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) v[g][j] = t[lane * 17 + j];
+#pragma unroll
+                for (int m = 0; m < 4; ++m) KB4(v[g], 4*m, 4*m+1, 4*m+2, 4*m+3)
+#pragma unroll
+                for (int m = 0; m < 4; ++m) KB4(v[g], m, m+4, m+8, m+12)
+                sycl::group_barrier(sg);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) t[lane * 17 + j] = v[g][j];
+                sycl::group_barrier(sg);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) v[g][j] = t[j * 17 + lane];
+#pragma unroll
+                for (int m = 0; m < 4; ++m) KB4(v[g], 4*m, 4*m+1, 4*m+2, 4*m+3)
+#pragma unroll
+                for (int m = 0; m < 4; ++m) KB4(v[g], m, m+4, m+8, m+12)
+#pragma unroll
+                for (int j = 0; j < 16; ++j) maximum = sycl::fmax(maximum, sycl::fabs(v[g][j]));
+            }
+            maximum = sycl::reduce_over_group(sg, maximum, sycl::maximum<float>());
+            if (lane == 0) maxima[s] = maximum;
+            it.barrier(sycl::access::fence_space::local_space);
+            maximum = 0.f;
+#pragma unroll
+            for (int i = 0; i < 16; ++i) maximum = sycl::fmax(maximum, maxima[i]);
+            const float scale = sycl::ext::intel::math::fdiv_rn(maximum, 127.f);
+            if (s == 0 && lane == 0) scales[row] = scale;
+            const float inverse = scale == 0.f ? 0.f : sycl::ext::intel::math::fdiv_rn(1.f, scale);
+            // A single IEEE multiply is round-to-nearest; only flushed subnormal
+            // operands could differ, and those quantize to zero unless the row
+            // scale is tiny. Such rows keep the exact library multiply.
+            const bool exact_mul = !(inverse < 1e30f);
+            auto store = [&](auto mul) {
+#pragma unroll
+                for (int g = 0; g < G; ++g) {
+                    int8_t * dst = q + row * k + (s * G + g) * 256 + lane;
+#pragma unroll
+                    for (int j = 0; j < 16; ++j) {
+                        int8_t out = 0;
+                        if (scale != 0.f) {
+                            const float scaled = mul(v[g][j], inverse);
+                            out = sycl::isfinite(scaled) ? int8_t(sycl::clamp(sycl::rint(scaled), -127.f, 127.f)) : int8_t(0);
+                        }
+                        dst[j * 16] = out;
+                    }
+                }
+            };
+            if (exact_mul) store([](float a, float b) { return sycl::ext::intel::math::fmul_rn(a, b); });
+            else store([](float a, float b) { return a * b; });
+        });
+    });
+}
+
+template <int G>
+static void quantize_rows_sg(sycl::queue & Q, const float * x, int8_t * q, float * scales, int64_t k, int64_t rows) {
+    quantize_rows_sg_load<G>(Q, convrot_load_f32{x, k}, q, scales, k, rows);
+}
+
+static void quantize_legacy(ggml_backend_sycl_context & ctx, const float * x, int8_t * q,
+                            float * scales, int64_t k, int64_t rows, int group_size);
+
+static void quantize(ggml_backend_sycl_context & ctx, const float * x, int8_t * q,
+                     float * scales, int64_t k, int64_t rows, int group_size) {
+    auto queue = ctx.stream();
+    GGML_ASSERT(queue->has_property<sycl::property::queue::in_order>());
+    static const bool legacy = getenv("KUNO_DEV_QUANT_LEGACY") != nullptr;
+    static const bool check = getenv("KUNO_DEV_QUANT_CHECK") != nullptr;
+    const int64_t groups = k / 256;
+    if (legacy || group_size != 256 || k % 4096 != 0 || groups / 16 > 3) {
+        quantize_legacy(ctx, x, q, scales, k, rows, group_size);
+        return;
+    }
+    const int64_t padded = (rows + 3) / 4 * 4;
+    if (padded > rows) queue->memset(q + rows * k, 0, (padded - rows) * k);
+    switch (groups / 16) {
+        case 1: quantize_rows_sg<1>(*queue, x, q, scales, k, rows); break;
+        case 2: quantize_rows_sg<2>(*queue, x, q, scales, k, rows); break;
+        default: quantize_rows_sg<3>(*queue, x, q, scales, k, rows); break;
+    }
+    if (check) {
+        int8_t * q2 = sycl::malloc_device<int8_t>(padded * k, *queue);
+        float * s2 = sycl::malloc_device<float>(rows, *queue);
+        unsigned * bad = sycl::malloc_shared<unsigned>(2, *queue);
+        bad[0] = bad[1] = 0;
+        quantize_legacy(ctx, x, q2, s2, k, rows, group_size);
+        queue->parallel_for(sycl::range<1>(rows * k), [=](sycl::id<1> i) {
+            if (q[i] != q2[i]) sycl::atomic_ref<unsigned, sycl::memory_order::relaxed, sycl::memory_scope::device>(bad[0]).fetch_add(1u);
+            if (i[0] < (size_t) rows && sycl::bit_cast<uint32_t>(scales[i]) != sycl::bit_cast<uint32_t>(s2[i]))
+                sycl::atomic_ref<unsigned, sycl::memory_order::relaxed, sycl::memory_scope::device>(bad[1]).fetch_add(1u);
+        }).wait();
+        static unsigned calls = 0, failing = 0;
+        calls++; if (bad[0] || bad[1]) failing++;
+        if (bad[0] || bad[1] || calls % 500 == 0)
+            fprintf(stderr, "KUNO_DEV_QUANT_CHECK k=%lld rows=%lld byte_mismatch=%u scale_mismatch=%u calls=%u failing=%u\n",
+                    (long long) k, (long long) rows, bad[0], bad[1], calls, failing);
+        sycl::free(q2, *queue); sycl::free(s2, *queue); sycl::free(bad, *queue);
+    }
+}
+
+static void quantize_legacy(ggml_backend_sycl_context & ctx, const float * x, int8_t * q,
+                            float * scales, int64_t k, int64_t rows, int group_size) {
+    auto queue = ctx.stream();
+    const int64_t padded = (rows + 3) / 4 * 4;
+    if (padded > rows) queue->memset(q + rows * k, 0, (padded - rows) * k);
+    queue->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> values(256, h), maxima(64, h);
+        h.parallel_for(sycl::nd_range<1>(rows * 64, 64), [=](sycl::nd_item<1> it) {
+            const int64_t row = it.get_group(0), tid = it.get_local_id(0);
+            auto transform = [&](int64_t group) {
+                for (int i = 0; i < 4; ++i) values[tid + i * 64] = x[row*k + group*256 + tid+i*64] / 16.f;
+                it.barrier(sycl::access::fence_space::local_space);
+                for (int stride = 1; stride < 256; stride *= 4) {
+                    const int at = (tid / stride) * 4 * stride + tid % stride;
+                    const float a = values[at], b = values[at+stride], c = values[at+2*stride], d = values[at+3*stride];
+                    values[at] = a+b+c-d; values[at+stride] = a+b-c+d;
+                    values[at+2*stride] = a-b+c+d; values[at+3*stride] = -a+b+c+d;
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            };
+            float maximum = 0.f;
+            if (group_size == 256) {
+                for (int64_t group = 0; group < k / 256; ++group) {
+                    transform(group);
+                    for (int i = 0; i < 4; ++i) maximum = sycl::fmax(maximum, sycl::fabs(values[tid+i*64]));
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            } else {
+                for (int64_t col = tid; col < k; col += 64) maximum = sycl::fmax(maximum, sycl::fabs(x[row*k+col]));
+            }
+            maxima[tid] = maximum;
+            it.barrier(sycl::access::fence_space::local_space);
+            for (int stride = 32; stride > 0; stride /= 2) {
+                if (tid < stride) maxima[tid] = sycl::fmax(maxima[tid], maxima[tid+stride]);
+                it.barrier(sycl::access::fence_space::local_space);
+            }
+            // Preserve each FP32 rounding before nearest-even integer rounding.
+            // SYCL's ordinary division permits error that can turn an exact
+            // half tie (e.g. .40625 with max .8125) into 63.499996 instead of
+            // 63.5, changing an INT8 byte and therefore the exact integer dot.
+            const float scale = sycl::ext::intel::math::fdiv_rn(maxima[0], 127.f);
+            if (tid == 0) scales[row] = scale;
+            const float inverse = scale == 0.f ? 0.f : sycl::ext::intel::math::fdiv_rn(1.f, scale);
+            auto rounded = [&](float value) {
+                if (scale == 0.f) return int8_t(0);
+                const float scaled = sycl::ext::intel::math::fmul_rn(value, inverse);
+                // Nonfinite activations have no usable row scale. Avoid a
+                // float-to-integer UB; ordinary finite rows retain ties-even.
+                if (!sycl::isfinite(scaled)) return int8_t(0);
+                return int8_t(sycl::clamp(sycl::rint(scaled), -127.f, 127.f));
+            };
+            if (group_size == 256) {
+                for (int64_t group = 0; group < k / 256; ++group) {
+                    transform(group);
+                    for (int i = 0; i < 4; ++i) q[row*k + group*256 + tid+i*64] = rounded(values[tid+i*64]);
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            } else {
+                for (int64_t col = tid; col < k; col += 64) q[row*k+col] = rounded(x[row*k+col]);
+            }
+        });
+    });
+}
+
+void ggml_sycl_quantize_i8_convrot(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_sycl_convrot_geometry(dst, false));
+    const auto x = dst->src[0];
+    const int64_t rows = ggml_nrows(x), padded = (rows + 3) / 4 * 4;
+    auto bytes = static_cast<int8_t *>(dst->data);
+    // Deterministic unused scale-slot bytes, in addition to zero padded rows.
+    ctx.stream()->memset(bytes + x->ne[0] * padded, 0, ggml_nbytes(dst) - x->ne[0] * padded);
+    quantize(ctx, static_cast<const float *>(x->data), bytes,
+             reinterpret_cast<float *>(bytes + x->ne[0] * padded), x->ne[0], rows, 256);
+}
+
+// Shared front half of the INT8 ConvRot linear: activation INT8/scales and
+// the exact int32 oneMKL product, row-major [padded rows][n].
+struct convrot_product {
+    ggml_sycl_pool_alloc<int8_t> temporary_input;
+    ggml_sycl_pool_alloc<float> temporary_scales;
+    ggml_sycl_pool_alloc<int32_t> temporary_accum;
+    const float * activation_scales = nullptr;
+    int32_t * accum = nullptr;
+    sycl::event gemm;
+    int64_t k = 0, n = 0, rows = 0, padded = 0;
+    convrot_product(ggml_backend_sycl_context & ctx, ggml_tensor * dst)
+        : temporary_input(ctx.pool()), temporary_scales(ctx.pool()), temporary_accum(ctx.pool()) {
+        const auto weight = dst->src[0], input = dst->src[1];
+        k = weight->ne[0]; n = weight->ne[1]; rows = ggml_nrows(dst); padded = (rows+3)/4*4;
+        auto queue = ctx.stream();
+        GGML_ASSERT(queue->has_property<sycl::property::queue::in_order>());
+        const int8_t * q = static_cast<const int8_t *>(input->data);
+        if (input->type == GGML_TYPE_I8) activation_scales = reinterpret_cast<const float *>(q+k*padded);
+        else {
+            q = temporary_input.alloc(k*padded);
+            activation_scales = temporary_scales.alloc(rows);
+            quantize(ctx, static_cast<const float *>(input->data), const_cast<int8_t *>(q),
+                     const_cast<float *>(activation_scales), k, rows, ggml_get_op_params_i32(dst, 2));
+        }
+        accum = temporary_accum.alloc(n*padded);
+        gemm = oneapi::mkl::blas::column_major::gemm(*queue, oneapi::mkl::transpose::trans,
+            oneapi::mkl::transpose::nontrans, n, padded, k, int32_t(1),
+            static_cast<const int8_t *>(weight->data), k, q, k, int32_t(0), accum, n,
+            oneapi::mkl::blas::compute_mode::standard);
+    }
+};
+
+void ggml_sycl_mul_mat_i8_convrot(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_sycl_convrot_geometry(dst, true));
+    convrot_product p(ctx, dst);
+    auto queue = ctx.stream();
+    const int64_t rows = p.rows, n = p.n;
+    auto accum = p.accum;
+    auto activation_scales = p.activation_scales;
+    auto scales = static_cast<const float *>(dst->src[2]->data);
+    auto bias = dst->src[3] ? static_cast<const float *>(dst->src[3]->data) : nullptr;
+    auto output = static_cast<float *>(dst->data);
+    queue->submit([&](sycl::handler & h) {
+        h.depends_on(p.gemm);
+        h.parallel_for(sycl::range<1>(rows*n), [=](sycl::id<1> at) {
+            const int64_t i = at[0], row = i/n, col = i%n;
+            float value = float(accum[i]) * activation_scales[row];
+            value *= scales[col];
+            if (bias) value += bias[col];
+            output[i] = value;
+        });
+    });
+    // Pool allocations are stream-ordered, like existing SYCL GEMM scratch.
+}
+
+// gate_up INT8 linear -> SWIGLU -> ConvRot quantize, without materializing the
+// F32 product or the activation. Each value is dequantized, activated and
+// rotated with exactly the arithmetic of the three separate operations.
+struct convrot_load_swiglu {
+    const int32_t * accum; const float * activation_scales; const float * scales; const float * bias;
+    int64_t n, half, gate_offset, up_offset;
+    float deq(int64_t row, int64_t col) const {
+        float value = float(accum[row * n + col]) * activation_scales[row];
+        value *= scales[col];
+        if (bias) value += bias[col];
+        return value;
+    }
+    float operator()(int64_t row, int64_t e) const {
+        const float x = deq(row, gate_offset + e), g = deq(row, up_offset + e);
+        return x / (1.0f + sycl::exp(-x)) * g;
+    }
+};
+
+bool ggml_sycl_mul_mat_i8_convrot_swiglu_quantize(ggml_backend_sycl_context & ctx, ggml_tensor * mm,
+                                                  ggml_tensor * glu, ggml_tensor * quant) {
+    static const bool disabled = getenv("KUNO_DEV_NO_SWIGLU_FUSION") != nullptr;
+    if (disabled) return false;
+    if (glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || glu->src[0] != mm ||
+        glu->src[1] != nullptr || quant->op != GGML_OP_QUANTIZE_I8_CONVROT || quant->src[0] != glu) return false;
+    if (!ggml_sycl_convrot_geometry(mm, true) || !ggml_sycl_convrot_geometry(quant, false)) return false;
+    if (mm->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) || !ggml_is_contiguous(glu)) return false;
+    const int64_t half = glu->ne[0];
+    if (mm->ne[0] != 2 * half || ggml_nrows(glu) != ggml_nrows(mm) || half % 4096 != 0 || half / 4096 > 3) return false;
+    convrot_product p(ctx, mm);
+    auto queue = ctx.stream();
+    const int64_t rows = p.rows, padded = p.padded;
+    const int32_t swapped = ggml_get_op_params_i32(glu, 1);
+    convrot_load_swiglu load{p.accum, p.activation_scales, static_cast<const float *>(mm->src[2]->data),
+                             mm->src[3] ? static_cast<const float *>(mm->src[3]->data) : nullptr,
+                             p.n, half, swapped ? half : 0, swapped ? 0 : half};
+    auto bytes = static_cast<int8_t *>(quant->data);
+    queue->memset(bytes + half * padded, 0, ggml_nbytes(quant) - half * padded);
+    if (padded > rows) queue->memset(bytes + rows * half, 0, (padded - rows) * half);
+    float * row_scales = reinterpret_cast<float *>(bytes + half * padded);
+    switch (half / 4096) {
+        case 1: quantize_rows_sg_load<1>(*queue, load, bytes, row_scales, half, rows); break;
+        case 2: quantize_rows_sg_load<2>(*queue, load, bytes, row_scales, half, rows); break;
+        default: quantize_rows_sg_load<3>(*queue, load, bytes, row_scales, half, rows); break;
+    }
+    static const bool check = getenv("KUNO_DEV_SWIGLU_CHECK") != nullptr;
+    if (check) {
+        // Reference: the three original operations into scratch, then compare bytes and scales.
+        int8_t * ref = sycl::malloc_device<int8_t>(ggml_nbytes(quant), *queue);
+        float * act = sycl::malloc_device<float>(rows * half, *queue);
+        float * prod = sycl::malloc_device<float>(rows * p.n, *queue);
+        void * saved_mm = mm->data; void * saved_glu = glu->data; void * saved_q = quant->data;
+        mm->data = prod; ggml_sycl_mul_mat_i8_convrot(ctx, mm);
+        glu->data = act; ggml_sycl_swiglu(ctx, glu);
+        quant->data = ref; ggml_sycl_quantize_i8_convrot(ctx, quant);
+        mm->data = saved_mm; glu->data = saved_glu; quant->data = saved_q;
+        unsigned * bad = sycl::malloc_shared<unsigned>(1, *queue); bad[0] = 0;
+        const size_t total = ggml_nbytes(quant);
+        queue->parallel_for(sycl::range<1>(total), [=](sycl::id<1> i) {
+            if (bytes[i] != ref[i]) sycl::atomic_ref<unsigned, sycl::memory_order::relaxed, sycl::memory_scope::device>(bad[0]).fetch_add(1u);
+        }).wait();
+        static unsigned calls = 0, failing = 0; calls++; if (bad[0]) failing++;
+        if (bad[0] || calls % 100 == 0)
+            fprintf(stderr, "KUNO_DEV_SWIGLU_CHECK rows=%lld half=%lld byte_mismatch=%u calls=%u failing=%u\n",
+                    (long long) rows, (long long) half, bad[0], calls, failing);
+        sycl::free(ref, *queue); sycl::free(act, *queue); sycl::free(prod, *queue); sycl::free(bad, *queue);
+    }
+    return true;
+}
