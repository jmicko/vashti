index 0000000..9735cbf
--- /dev/null
+++ b/src/ggml-sycl/im2col-launch-policy.hpp
@@ -0,0 +1,12 @@
+#pragma once
+#include <cstdint>
+#include <algorithm>
+#include <limits>
+
+// Keep each dispatch's total work-item count inside the signed 32-bit envelope.
+// Tensor/address arithmetic remains 64-bit; no output-sized host staging.
+inline int64_t ggml_sycl_im2col_rows_per_launch(int64_t padded_channels, int64_t width) {
+    constexpr int64_t max_work_items = std::numeric_limits<int32_t>::max();
+    if (padded_channels <= 0 || width <= 0 || padded_channels > max_work_items / width) return 0;
+    return std::min<int64_t>(65535, max_work_items / (padded_channels * width));
+}
