+// Same-shape float copy/conversion without per-element 64-bit index division.
+// Element (i0,i1,i2,i3) is read and written through both tensors' byte strides;
+// each value is converted exactly as by the scalar cpy_1_* helpers above.
+template <typename S, typename D>
+static void kuno_cpy_same_shape(const char * src, char * dst, const ggml_tensor * s, const ggml_tensor * d, queue_ptr stream) {
+    const int64_t ne0 = s->ne[0], ne1 = s->ne[1], ne2 = s->ne[2], ne3 = s->ne[3];
+    const size_t sb0 = s->nb[0], sb1 = s->nb[1], sb2 = s->nb[2], sb3 = s->nb[3];
+    const size_t db0 = d->nb[0], db1 = d->nb[1], db2 = d->nb[2], db3 = d->nb[3];
+    const int64_t lx = std::min<int64_t>(256, (ne0 + 15) / 16 * 16), ly = std::max<int64_t>(1, 256 / lx);
+    const int64_t gx = (ne0 + lx - 1) / lx * lx, gy = (ne1 + ly - 1) / ly * ly;
+    // Keep every launch index within int range; the outer dimension loops.
+    const int64_t ne23 = ne2 * ne3, plane = gx * gy;
+    const int64_t gz = std::max<int64_t>(1, std::min<int64_t>(ne23, (int64_t(INT32_MAX) / plane)));
+    GGML_ASSERT(plane <= INT32_MAX);
+    stream->parallel_for(sycl::nd_range<3>(sycl::range<3>(gz, gy, gx), sycl::range<3>(1, ly, lx)),
+        [=](sycl::nd_item<3> it) {
+            const int64_t i0 = it.get_global_id(2), i1 = it.get_global_id(1);
+            if (i0 >= ne0 || i1 >= ne1) return;
+            for (int64_t z = it.get_global_id(0); z < ne23; z += gz) {
+                const uint32_t i23 = uint32_t(z), i3 = i23 / uint32_t(ne2), i2 = i23 - i3 * uint32_t(ne2);
+                const S value = *(const S *) (src + i0 * sb0 + i1 * sb1 + i2 * sb2 + i3 * sb3);
+                D * out = (D *) (dst + i0 * db0 + i1 * db1 + i2 * db2 + i3 * db3);
+                if constexpr (std::is_same_v<S, float> && std::is_same_v<D, sycl::half>) {
+                    *out = sycl::vec<float, 1>(value).convert<sycl::half, sycl::rounding_mode::automatic>()[0];
+                } else {
+                    *out = D(value);
+                }
+            }
+        });
+}
+
+static bool kuno_cpy_fast(const ggml_tensor * src0, const ggml_tensor * src1, queue_ptr stream) {
+    static const bool disabled = getenv("KUNO_DEV_NO_FAST_CPY") != nullptr;
+    if (disabled || !ggml_are_same_shape(src0, src1) || src0->ne[2] * src0->ne[3] > INT32_MAX) return false;
