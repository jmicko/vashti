+bool ggml_sycl_op_mul_add_f32(ggml_backend_sycl_context & ctx, ggml_tensor * mul, ggml_tensor * add) {
+    if (!ggml_sycl_mul_add_memory_safe(mul, add)) return false;
+    auto queue = ctx.stream();
+    const auto device = queue->get_device();
+    if (!device.is_gpu() || device.get_backend() != sycl::backend::ext_oneapi_level_zero ||
+        device.get_info<sycl::info::device::vendor_id>() != 0x8086) return false;
+    const auto activation = mul->src[0], gate = mul->src[1];
+    const auto residual = add->src[0] == mul ? add->src[1] : add->src[0];
+    for (const auto tensor : {activation, gate, residual, add}) {
+        const auto buffer = tensor->buffer ? tensor->buffer : tensor->view_src ? tensor->view_src->buffer : nullptr;
+        if (!buffer || ggml_backend_buffer_get_type(buffer) != ggml_backend_sycl_buffer_type(ctx.device)) return false;
+    }
+    const auto a = static_cast<const float *>(activation->data);
+    const auto g = static_cast<const float *>(gate->data);
+    const auto r = static_cast<const float *>(residual->data);
+    const auto output = static_cast<float *>(add->data);
+    const size_t columns = size_t(mul->ne[0]), rows = size_t(mul->ne[1]);
+    const bool product_first = add->src[0] == mul;
+    queue->parallel_for(sycl::range<2>(rows, columns), [=](sycl::id<2> at) {
+#pragma clang fp contract(off)
+        const size_t i = at[0] * columns + at[1];
+        // Use the exact plain operators from the two former kernels. Volatile
+        // FP32 materialization prevents contraction across their storage
+        // boundary without substituting the IMF rounding entrypoints' special
+        // value behavior. No global scratch or retained state is introduced.
+        volatile float product = op_mul(a[i], g[at[1]]);
+        const float materialized_product = product;
+        output[i] = product_first ? op_add(materialized_product, r[i])
+                                  : op_add(r[i], materialized_product);
+    });
+    return true;
+}
