+    else if (st == GGML_TYPE_F32 && dt == GGML_TYPE_F16) kuno_cpy_same_shape<float, sycl::half>(a, b, src0, src1, stream);
+    else if (st == GGML_TYPE_F16 && dt == GGML_TYPE_F16) kuno_cpy_same_shape<sycl::half, sycl::half>(a, b, src0, src1, stream);
+    else if (st == GGML_TYPE_F16 && dt == GGML_TYPE_F32) kuno_cpy_same_shape<sycl::half, float>(a, b, src0, src1, stream);
+    else return false;
+    return true;
+}
