diff --git a/src/ggml-sycl/convrot-policy.hpp b/src/ggml-sycl/convrot-policy.hpp
new file mode 100644
index 0000000..7899841
--- /dev/null
+++ b/src/ggml-sycl/convrot-policy.hpp
@@ -0,0 +1,44 @@
+// Experimental ConvRot geometry shared by the SYCL dispatcher and CPU tests.
+#pragma once
+#include "ggml.h"
+#include "ggml-impl.h"
+#include <limits>
+
+inline bool ggml_sycl_convrot_geometry(const ggml_tensor * dst, bool matmul) {
+    if (!dst || !ggml_is_contiguous(dst)) return false;
+    const ggml_tensor * weight = matmul ? dst->src[0] : nullptr;
+    const ggml_tensor * input = matmul ? dst->src[1] : dst->src[0];
+    if (!input || !ggml_is_contiguous(input)) return false;
+    const bool packed = input->type == GGML_TYPE_I8;
+    const ggml_tensor * logical = packed ? input->src[0] : input;
+    if (!logical || logical->type != GGML_TYPE_F32 || !ggml_is_contiguous(logical)) return false;
+    const int64_t k = logical->ne[0], rows = ggml_nrows(logical);
+    // Signed INT8 weights include -128, activations are in [-127,127].
+    // Bound the worst possible dot product before selecting I32 accumulation.
+    if (k <= 0 || k > std::numeric_limits<int32_t>::max() / (128 * 127) ||
+        k % 4 != 0 || rows <= 0 || rows > std::numeric_limits<int32_t>::max() - 3) return false;
+    const int group = ggml_get_op_params_i32(dst, matmul ? 2 : 0);
+    if ((group != 0 && group != 256) || (group == 256 && k % 256 != 0)) return false;
+    if (!matmul && (group != 256 || packed || dst->type != GGML_TYPE_I8)) return false;
+    const int64_t padded = (rows + 3) / 4 * 4;
+    const int64_t scale_rows = (rows * sizeof(float) + k - 1) / k;
+    const ggml_tensor * packed_tensor = matmul ? input : dst;
+    if (packed || !matmul) {
+        if (packed_tensor->op != GGML_OP_QUANTIZE_I8_CONVROT ||
+            ggml_get_op_params_i32(packed_tensor, 0) != 256 || group != 256 ||
+            packed_tensor->ne[0] != k || packed_tensor->ne[1] != padded + scale_rows ||
+            packed_tensor->ne[2] != 1 || packed_tensor->ne[3] != 1) return false;
+    }
+    if (!matmul) return true;
+    const ggml_tensor * scales = dst->src[2], * bias = dst->src[3];
+    if (!weight || weight->type != GGML_TYPE_I8 || !ggml_is_contiguous(weight) ||
+        weight->ne[0] != k || weight->ne[1] <= 0 || weight->ne[1] > std::numeric_limits<int32_t>::max() ||
+        weight->ne[2] != 1 || weight->ne[3] != 1 || dst->type != GGML_TYPE_F32 ||
+        dst->ne[0] != weight->ne[1] || dst->ne[1] != logical->ne[1] ||
+        dst->ne[2] != logical->ne[2] || dst->ne[3] != logical->ne[3] ||
+        !scales || scales->type != GGML_TYPE_F32 || !ggml_is_contiguous(scales) ||
+        ggml_nelements(scales) != weight->ne[1] ||
+        (bias && (bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) ||
+                  ggml_nelements(bias) != weight->ne[1]))) return false;
+    return uint64_t(weight->ne[1]) * uint64_t(padded) <= std::numeric_limits<size_t>::max() / sizeof(int32_t);
+}
diff --git a/src/ggml-sycl/convrot.cpp b/src/ggml-sycl/convrot.cpp
new file mode 100644
index 0000000..1d6077c
--- /dev/null
+++ b/src/ggml-sycl/convrot.cpp
@@ -0,0 +1,763 @@
+// Experimental native signed INT8 tensorwise GEMM for Qwen ConvRot weights.
+#include "convrot.hpp"
+#include "binbcast.hpp"
+#include "mul-add-policy.hpp"
+#include <oneapi/mkl/blas.hpp>
+#include <sycl/ext/intel/math/imf_rounding_math.hpp>
+
+bool ggml_sycl_convrot_device_supported(const sycl::device & d) {
+    return d.is_gpu() && d.get_backend() == sycl::backend::ext_oneapi_level_zero &&
+           d.get_info<sycl::info::device::vendor_id>() == 0x8086 &&
+           d.get_info<sycl::info::device::max_work_group_size>() >= 64 &&
+           d.get_info<sycl::info::device::local_mem_size>() >= 320 * sizeof(float);
+}
+
+
+// Row-parallel ConvRot quantizer. Each work-group quantizes one row with 16
+// sub-groups; each sub-group owns G consecutive 256-value rotation groups.
+// The radix-4 stages run in the original order (strides 1, 4, 16, 64) with the
+// original expressions, so rotated values, row scales and INT8 bytes are
+// bit-identical to the legacy shared-memory kernel (verified including
+// subnormal, zero, infinite and NaN rows).
+#define KB4(v, i0, i1, i2, i3) { const float a = v[i0], b = v[i1], c = v[i2], d = v[i3]; \
+    v[i0] = a+b+c-d; v[i1] = a+b-c+d; v[i2] = a-b+c+d; v[i3] = -a+b+c+d; }
+// 16 sub-groups per row; each sub-group owns G consecutive 256-value groups.
+struct convrot_load_f32 {
+    const float * x; int64_t k;
+    float operator()(int64_t row, int64_t e) const { return x[row * k + e]; }
+};
+
+// Loaders may provide row(r) returning a per-row element functor (hoists per-row setup).
+template <typename Load> static auto convrot_row_view(const Load & load, int64_t row, int) -> decltype(load.row(row)) { return load.row(row); }
+template <typename Load> static auto convrot_row_view(const Load & load, int64_t row, long) {
+    return [&load, row](int64_t e) { return load(row, e); };
+}
+
+template <int G, typename Load>
+static void quantize_rows_sg_load(sycl::queue & Q, Load load, int8_t * q, float * scales, int64_t k, int64_t rows) {
+    Q.submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> maxima(16, h), tile(16 * 16 * 17, h);
+        h.parallel_for(sycl::nd_range<1>(rows * 256, 256), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            auto sg = it.get_sub_group();
+            const int64_t row = it.get_group(0);
+            const int s = int(sg.get_group_linear_id());
+            const int lane = int(sg.get_local_linear_id());
+            float * t = &tile[s * 16 * 17];
+            const auto rl = convrot_row_view(load, row, 0);
+            float v[G][16];
+            float maximum = 0.f;
+#pragma unroll
+            for (int g = 0; g < G; ++g) {
+                // Sub-group s owns groups s*G .. s*G+G-1; trailing ones past k are skipped (uniform per sub-group).
+                if ((s * G + g) * 256 >= k) break;
+                const int64_t base = (s * G + g) * 256;
+                if (g) sycl::group_barrier(sg);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) t[j * 17 + lane] = rl(base + j * 16 + lane) / 16.f;
+                sycl::group_barrier(sg);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) v[g][j] = t[lane * 17 + j];
+#pragma unroll
+                for (int m = 0; m < 4; ++m) KB4(v[g], 4*m, 4*m+1, 4*m+2, 4*m+3)
+#pragma unroll
+                for (int m = 0; m < 4; ++m) KB4(v[g], m, m+4, m+8, m+12)
+                sycl::group_barrier(sg);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) t[lane * 17 + j] = v[g][j];
+                sycl::group_barrier(sg);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) v[g][j] = t[j * 17 + lane];
+#pragma unroll
+                for (int m = 0; m < 4; ++m) KB4(v[g], 4*m, 4*m+1, 4*m+2, 4*m+3)
+#pragma unroll
+                for (int m = 0; m < 4; ++m) KB4(v[g], m, m+4, m+8, m+12)
+#pragma unroll
+                for (int j = 0; j < 16; ++j) maximum = sycl::fmax(maximum, sycl::fabs(v[g][j]));
+            }
+            maximum = sycl::reduce_over_group(sg, maximum, sycl::maximum<float>());
+            if (lane == 0) maxima[s] = maximum;
+            it.barrier(sycl::access::fence_space::local_space);
+            maximum = 0.f;
+#pragma unroll
+            for (int i = 0; i < 16; ++i) maximum = sycl::fmax(maximum, maxima[i]);
+            const float scale = sycl::ext::intel::math::fdiv_rn(maximum, 127.f);
+            if (s == 0 && lane == 0) scales[row] = scale;
+            const float inverse = scale == 0.f ? 0.f : sycl::ext::intel::math::fdiv_rn(1.f, scale);
+            // A single IEEE multiply is round-to-nearest; only flushed subnormal
+            // operands could differ, and those quantize to zero unless the row
+            // scale is tiny. Such rows keep the exact library multiply.
+            const bool exact_mul = !(inverse < 1e30f);
+            auto store = [&](auto mul) {
+#pragma unroll
+                for (int g = 0; g < G; ++g) {
+                    if ((s * G + g) * 256 >= k) break;
+                    int8_t * dst = q + row * k + (s * G + g) * 256 + lane;
+#pragma unroll
+                    for (int j = 0; j < 16; ++j) {
+                        int8_t out = 0;
+                        if (scale != 0.f) {
+                            const float scaled = mul(v[g][j], inverse);
+                            out = sycl::isfinite(scaled) ? int8_t(sycl::clamp(sycl::rint(scaled), -127.f, 127.f)) : int8_t(0);
+                        }
+                        dst[j * 16] = out;
+                    }
+                }
+            };
+            if (exact_mul) store([](float a, float b) { return sycl::ext::intel::math::fmul_rn(a, b); });
+            else store([](float a, float b) { return a * b; });
+        });
+    });
+}
+
+template <int G>
+static void quantize_rows_sg(sycl::queue & Q, const float * x, int8_t * q, float * scales, int64_t k, int64_t rows) {
+    quantize_rows_sg_load<G>(Q, convrot_load_f32{x, k}, q, scales, k, rows);
+}
+
+// Row-parallel kernel coverage: K a multiple of 256 with at most 64 groups (16 sub-groups x G <= 4).
+static inline bool convrot_rows_supported(int64_t k) { return k > 0 && k % 256 == 0 && (k / 256 + 15) / 16 <= 4; }
+
+template <typename Load>
+static void quantize_rows_dispatch(sycl::queue & Q, Load load, int8_t * q, float * scales, int64_t k, int64_t rows) {
+    switch ((k / 256 + 15) / 16) {
+        case 1: quantize_rows_sg_load<1>(Q, load, q, scales, k, rows); break;
+        case 2: quantize_rows_sg_load<2>(Q, load, q, scales, k, rows); break;
+        case 3: quantize_rows_sg_load<3>(Q, load, q, scales, k, rows); break;
+        default: quantize_rows_sg_load<4>(Q, load, q, scales, k, rows); break;
+    }
+}
+
+static void quantize_legacy(ggml_backend_sycl_context & ctx, const float * x, int8_t * q,
+                            float * scales, int64_t k, int64_t rows, int group_size);
+
+static void quantize(ggml_backend_sycl_context & ctx, const float * x, int8_t * q,
+                     float * scales, int64_t k, int64_t rows, int group_size) {
+    auto queue = ctx.stream();
+    GGML_ASSERT(queue->has_property<sycl::property::queue::in_order>());
+    const int64_t groups = k / 256;
+    // The row-parallel kernel covers K = 4096..12288 in whole 4096 blocks; other
+    // shapes use the shared-memory kernel. Both produce identical bytes.
+    if (group_size != 256 || !convrot_rows_supported(k)) {
+        quantize_legacy(ctx, x, q, scales, k, rows, group_size);
+        return;
+    }
+    const int64_t padded = (rows + 3) / 4 * 4;
+    if (padded > rows) queue->memset(q + rows * k, 0, (padded - rows) * k);
+    quantize_rows_dispatch(*queue, convrot_load_f32{x, k}, q, scales, k, rows);
+}
+
+static void quantize_legacy(ggml_backend_sycl_context & ctx, const float * x, int8_t * q,
+                            float * scales, int64_t k, int64_t rows, int group_size) {
+    auto queue = ctx.stream();
+    const int64_t padded = (rows + 3) / 4 * 4;
+    if (padded > rows) queue->memset(q + rows * k, 0, (padded - rows) * k);
+    queue->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> values(256, h), maxima(64, h);
+        h.parallel_for(sycl::nd_range<1>(rows * 64, 64), [=](sycl::nd_item<1> it) {
+            const int64_t row = it.get_group(0), tid = it.get_local_id(0);
+            auto transform = [&](int64_t group) {
+                for (int i = 0; i < 4; ++i) values[tid + i * 64] = x[row*k + group*256 + tid+i*64] / 16.f;
+                it.barrier(sycl::access::fence_space::local_space);
+                for (int stride = 1; stride < 256; stride *= 4) {
+                    const int at = (tid / stride) * 4 * stride + tid % stride;
+                    const float a = values[at], b = values[at+stride], c = values[at+2*stride], d = values[at+3*stride];
+                    values[at] = a+b+c-d; values[at+stride] = a+b-c+d;
+                    values[at+2*stride] = a-b+c+d; values[at+3*stride] = -a+b+c+d;
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            };
+            float maximum = 0.f;
+            if (group_size == 256) {
+                for (int64_t group = 0; group < k / 256; ++group) {
+                    transform(group);
+                    for (int i = 0; i < 4; ++i) maximum = sycl::fmax(maximum, sycl::fabs(values[tid+i*64]));
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            } else {
+                for (int64_t col = tid; col < k; col += 64) maximum = sycl::fmax(maximum, sycl::fabs(x[row*k+col]));
+            }
+            maxima[tid] = maximum;
+            it.barrier(sycl::access::fence_space::local_space);
+            for (int stride = 32; stride > 0; stride /= 2) {
+                if (tid < stride) maxima[tid] = sycl::fmax(maxima[tid], maxima[tid+stride]);
+                it.barrier(sycl::access::fence_space::local_space);
+            }
+            // Preserve each FP32 rounding before nearest-even integer rounding.
+            // SYCL's ordinary division permits error that can turn an exact
+            // half tie (e.g. .40625 with max .8125) into 63.499996 instead of
+            // 63.5, changing an INT8 byte and therefore the exact integer dot.
+            const float scale = sycl::ext::intel::math::fdiv_rn(maxima[0], 127.f);
+            if (tid == 0) scales[row] = scale;
+            const float inverse = scale == 0.f ? 0.f : sycl::ext::intel::math::fdiv_rn(1.f, scale);
+            auto rounded = [&](float value) {
+                if (scale == 0.f) return int8_t(0);
+                const float scaled = sycl::ext::intel::math::fmul_rn(value, inverse);
+                // Nonfinite activations have no usable row scale. Avoid a
+                // float-to-integer UB; ordinary finite rows retain ties-even.
+                if (!sycl::isfinite(scaled)) return int8_t(0);
+                return int8_t(sycl::clamp(sycl::rint(scaled), -127.f, 127.f));
+            };
+            if (group_size == 256) {
+                for (int64_t group = 0; group < k / 256; ++group) {
+                    transform(group);
+                    for (int i = 0; i < 4; ++i) q[row*k + group*256 + tid+i*64] = rounded(values[tid+i*64]);
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+            } else {
+                for (int64_t col = tid; col < k; col += 64) q[row*k+col] = rounded(x[row*k+col]);
+            }
+        });
+    });
+}
+
+void ggml_sycl_quantize_i8_convrot(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_sycl_convrot_geometry(dst, false));
+    const auto x = dst->src[0];
+    const int64_t rows = ggml_nrows(x), padded = (rows + 3) / 4 * 4;
+    auto bytes = static_cast<int8_t *>(dst->data);
+    // Deterministic unused scale-slot bytes, in addition to zero padded rows.
+    ctx.stream()->memset(bytes + x->ne[0] * padded, 0, ggml_nbytes(dst) - x->ne[0] * padded);
+    quantize(ctx, static_cast<const float *>(x->data), bytes,
+             reinterpret_cast<float *>(bytes + x->ne[0] * padded), x->ne[0], rows, 256);
+}
+
+// Shared front half of the INT8 ConvRot linear: activation INT8/scales and
+// the exact int32 oneMKL product, row-major [padded rows][n].
+struct convrot_product {
+    ggml_sycl_pool_alloc<int8_t> temporary_input;
+    ggml_sycl_pool_alloc<float> temporary_scales;
+    ggml_sycl_pool_alloc<int32_t> temporary_accum;
+    const float * activation_scales = nullptr;
+    int32_t * accum = nullptr;
+    sycl::event gemm;
+    int64_t k = 0, n = 0, rows = 0, padded = 0;
+    convrot_product(ggml_backend_sycl_context & ctx, ggml_tensor * dst)
+        : temporary_input(ctx.pool()), temporary_scales(ctx.pool()), temporary_accum(ctx.pool()) {
+        const auto weight = dst->src[0], input = dst->src[1];
+        k = weight->ne[0]; n = weight->ne[1]; rows = ggml_nrows(dst); padded = (rows+3)/4*4;
+        auto queue = ctx.stream();
+        GGML_ASSERT(queue->has_property<sycl::property::queue::in_order>());
+        const int8_t * q = static_cast<const int8_t *>(input->data);
+        if (input->type == GGML_TYPE_I8) activation_scales = reinterpret_cast<const float *>(q+k*padded);
+        else {
+            q = temporary_input.alloc(k*padded);
+            activation_scales = temporary_scales.alloc(rows);
+            quantize(ctx, static_cast<const float *>(input->data), const_cast<int8_t *>(q),
+                     const_cast<float *>(activation_scales), k, rows, ggml_get_op_params_i32(dst, 2));
+        }
+        accum = temporary_accum.alloc(n*padded);
+        gemm = oneapi::mkl::blas::column_major::gemm(*queue, oneapi::mkl::transpose::trans,
+            oneapi::mkl::transpose::nontrans, n, padded, k, int32_t(1),
+            static_cast<const int8_t *>(weight->data), k, q, k, int32_t(0), accum, n,
+            oneapi::mkl::blas::compute_mode::standard);
+    }
+};
+
+void ggml_sycl_mul_mat_i8_convrot(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_sycl_convrot_geometry(dst, true));
+    convrot_product p(ctx, dst);
+    auto queue = ctx.stream();
+    const int64_t rows = p.rows, n = p.n;
+    auto accum = p.accum;
+    auto activation_scales = p.activation_scales;
+    auto scales = static_cast<const float *>(dst->src[2]->data);
+    auto bias = dst->src[3] ? static_cast<const float *>(dst->src[3]->data) : nullptr;
+    auto output = static_cast<float *>(dst->data);
+    queue->submit([&](sycl::handler & h) {
+        h.depends_on(p.gemm);
+        h.parallel_for(sycl::range<1>(rows*n), [=](sycl::id<1> at) {
+            const int64_t i = at[0], row = i/n, col = i%n;
+            float value = float(accum[i]) * activation_scales[row];
+            value *= scales[col];
+            if (bias) value += bias[col];
+            output[i] = value;
+        });
+    });
+    // Pool allocations are stream-ordered, like existing SYCL GEMM scratch.
+}
+
+// gate_up INT8 linear -> SWIGLU -> ConvRot quantize, without materializing the
+// F32 product or the activation. Each value is dequantized, activated and
+// rotated with exactly the arithmetic of the three separate operations.
+struct convrot_load_swiglu {
+    const int32_t * accum; const float * activation_scales; const float * scales; const float * bias;
+    int64_t n, half, gate_offset, up_offset;
+    float deq(int64_t row, int64_t col) const {
+        float value = float(accum[row * n + col]) * activation_scales[row];
+        value *= scales[col];
+        if (bias) value += bias[col];
+        return value;
+    }
+    float operator()(int64_t row, int64_t e) const {
+        const float x = deq(row, gate_offset + e), g = deq(row, up_offset + e);
+        return x / (1.0f + sycl::exp(-x)) * g;
+    }
+};
+
+bool ggml_sycl_mul_mat_i8_convrot_swiglu_quantize(ggml_backend_sycl_context & ctx, ggml_tensor * mm,
+                                                  ggml_tensor * glu, ggml_tensor * quant) {
+    if (glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || glu->src[0] != mm ||
+        glu->src[1] != nullptr || quant->op != GGML_OP_QUANTIZE_I8_CONVROT || quant->src[0] != glu) return false;
+    if (!ggml_sycl_convrot_geometry(mm, true) || !ggml_sycl_convrot_geometry(quant, false)) return false;
+    if (mm->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) || !ggml_is_contiguous(glu)) return false;
+    const int64_t half = glu->ne[0];
+    if (mm->ne[0] != 2 * half || ggml_nrows(glu) != ggml_nrows(mm) || !convrot_rows_supported(half)) return false;
+    if (kuno_overlap(quant, mm->src[2]) || (mm->src[3] && kuno_overlap(quant, mm->src[3]))) return false;
+    convrot_product p(ctx, mm);
+    auto queue = ctx.stream();
+    const int64_t rows = p.rows, padded = p.padded;
+    const int32_t swapped = ggml_get_op_params_i32(glu, 1);
+    convrot_load_swiglu load{p.accum, p.activation_scales, static_cast<const float *>(mm->src[2]->data),
+                             mm->src[3] ? static_cast<const float *>(mm->src[3]->data) : nullptr,
+                             p.n, half, swapped ? half : 0, swapped ? 0 : half};
+    auto bytes = static_cast<int8_t *>(quant->data);
+    queue->memset(bytes + half * padded, 0, ggml_nbytes(quant) - half * padded);
+    if (padded > rows) queue->memset(bytes + rows * half, 0, (padded - rows) * half);
+    float * row_scales = reinterpret_cast<float *>(bytes + half * padded);
+    quantize_rows_dispatch(*queue, load, bytes, row_scales, half, rows);
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// Producer fusion into the ConvRot quantizer: MUL by a per-channel row, or
+// SCALE, immediately followed by QUANTIZE_I8_CONVROT of its result.
+struct convrot_load_mul_row {
+    const float * x; const float * w; int64_t k;
+    float operator()(int64_t row, int64_t e) const { return op_mul(x[row * k + e], w[e]); }
+};
+struct convrot_load_scale {
+    const float * x; float scale, bias; int64_t k;
+    float operator()(int64_t row, int64_t e) const { return scale * x[row * k + e] + bias; }
+};
+
+template <typename Load>
+static void quantize_into(ggml_backend_sycl_context & ctx, ggml_tensor * quant, Load load, int64_t k, int64_t rows) {
+    auto queue = ctx.stream();
+    const int64_t padded = (rows + 3) / 4 * 4;
+    auto bytes = static_cast<int8_t *>(quant->data);
+    queue->memset(bytes + k * padded, 0, ggml_nbytes(quant) - k * padded);
+    if (padded > rows) queue->memset(bytes + rows * k, 0, (padded - rows) * k);
+    float * row_scales = reinterpret_cast<float *>(bytes + k * padded);
+    quantize_rows_dispatch(*queue, load, bytes, row_scales, k, rows);
+}
+
+// ---------------------------------------------------------------------------
+// MiniMax H3 MLP: MUL_MAT(i8 fc1) -> SCALE -> {VIEW u -> CONT -> SILU} * {VIEW v -> CONT}
+// -> SCALE -> QUANTIZE_I8_CONVROT, read straight from the int32 product. Each former
+// node result is materialized as a volatile FP32 value (exact per-op rounding).
+struct convrot_load_minimax_mlp {
+    const int32_t * accum; const float * act; const float * scales; const float * bias;
+    int64_t n, half; float s1, b1, s2, b2;
+    float stage(int64_t row, int64_t col) const {
+        float value = float(accum[row * n + col]) * act[row];
+        value *= scales[col];
+        if (bias) value += bias[col];
+        volatile float linear = value;
+        const float l = linear;
+        volatile float scaled = s1 * l + b1;
+        return scaled;
+    }
+    float operator()(int64_t row, int64_t e) const {
+        const float u = stage(row, e), v = stage(row, half + e);
+        volatile float silu = u / (1.0f + sycl::exp(-u));
+        const float s = silu;
+        volatile float product = op_mul(s, v);
+        const float p = product;
+        volatile float out = s2 * p + b2;
+        return out;
+    }
+};
+
+bool ggml_sycl_mul_mat_i8_convrot_minimax_mlp(ggml_backend_sycl_context & ctx, ggml_tensor * mm, ggml_tensor * scale1,
+                                              ggml_tensor * silu, ggml_tensor * mul, ggml_tensor * scale2, ggml_tensor * quant) {
+    if (!ggml_sycl_convrot_geometry(mm, true) || mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) ||
+        !ggml_sycl_convrot_geometry(quant, false) || quant->src[0] != scale2) return false;
+    if (scale1->op != GGML_OP_SCALE || scale1->src[0] != mm || !ggml_are_same_shape(scale1, mm) || !ggml_is_contiguous(scale1)) return false;
+    if (silu->op != GGML_OP_UNARY || ggml_get_unary_op(silu) != GGML_UNARY_OP_SILU || mul->op != GGML_OP_MUL ||
+        mul->src[0] != silu || scale2->op != GGML_OP_SCALE || scale2->src[0] != mul) return false;
+    const int64_t half = mul->ne[0];
+    if (mm->ne[0] != 2 * half || mm->ne[2] != 1 || mm->ne[3] != 1 || !convrot_rows_supported(half) ||
+        !ggml_are_same_shape(mul, silu) || !ggml_are_same_shape(mul, scale2) || ggml_nrows(mul) != ggml_nrows(mm)) return false;
+    // u = CONT(VIEW(scale1, cols [0, half))), v = CONT(VIEW(scale1, cols [half, 2*half)))
+    const ggml_tensor * cu = silu->src[0], * cv = mul->src[1];
+    auto half_of = [&](const ggml_tensor * c, size_t offset) {
+        const ggml_tensor * v = c ? c->src[0] : nullptr;
+        return c && c->op == GGML_OP_CONT && ggml_is_contiguous(c) && c->type == GGML_TYPE_F32 && ggml_are_same_shape(c, mul) &&
+               v && v->op == GGML_OP_VIEW && v->src[0] == scale1 && v->view_src == scale1 && v->view_offs == offset &&
+               v->nb[1] == scale1->nb[1] && v->ne[0] == half;
+    };
+    if (!half_of(cu, 0) || !half_of(cv, size_t(half) * sizeof(float))) return false;
+    if (kuno_overlap(quant, mm->src[2]) || (mm->src[3] && kuno_overlap(quant, mm->src[3]))) return false;
+    float s1, b1, s2, b2;
+    memcpy(&s1, (const float *) scale1->op_params + 0, sizeof(float)); memcpy(&b1, (const float *) scale1->op_params + 1, sizeof(float));
+    memcpy(&s2, (const float *) scale2->op_params + 0, sizeof(float)); memcpy(&b2, (const float *) scale2->op_params + 1, sizeof(float));
+    convrot_product p(ctx, mm);
+    convrot_load_minimax_mlp load{p.accum, p.activation_scales, static_cast<const float *>(mm->src[2]->data),
+                                  mm->src[3] ? static_cast<const float *>(mm->src[3]->data) : nullptr,
+                                  p.n, half, s1, b1, s2, b2};
+    quantize_into(ctx, quant, load, half, p.rows);
+    return true;
+}
+
+// MiniMax H3 modulation fused into the quantizer: per token t in segment k,
+//   v = (x + x * scale_k) + shift_k   [then SCALE]   -> ConvRot quantize.
+struct convrot_load_minimax_mod {
+    kuno_minimax_seg_desc d;
+    struct row_loader {
+        const float * x; const float * p; const float * q; bool scaled; float qs, qb;
+        float operator()(int64_t e) const {
+            // Separately rounded IEEE products and sums, exactly like the per-node kernels.
+#pragma clang fp contract(off) reassociate(off)
+            const float v = x[e];
+            const float product = v * p[e];
+            const float added = v + product;
+            float r = added + q[e];
+            if (scaled) r = qs * r + qb;
+            return r;
+        }
+    };
+    row_loader row(int64_t row) const {
+        int64_t row0 = 0; const float * sa = nullptr, * sp = nullptr, * sq = nullptr;
+#pragma unroll
+        for (int j = 0; j < kuno_minimax_seg_desc::max_segs; ++j)
+            if (j < d.nseg && row >= d.seg[j].row0) { row0 = d.seg[j].row0; sa = d.seg[j].a; sp = d.seg[j].p; sq = d.seg[j].q; }
+        return {sa + (row - row0) * d.C, sp, sq, d.q_scaled, d.q_scale, d.q_bias};
+    }
+    float operator()(int64_t r, int64_t e) const { return row(r)(e); }
+};
+
+bool ggml_sycl_quantize_i8_convrot_minimax_mod(ggml_backend_sycl_context & ctx, ggml_tensor * quant, const kuno_minimax_seg_desc & d) {
+    if (!ggml_sycl_convrot_geometry(quant, false) || quant->src[0]->ne[0] != d.C || ggml_nrows(quant->src[0]) != d.L ||
+        !convrot_rows_supported(d.C) || d.nseg < 1 || d.nseg > kuno_minimax_seg_desc::max_segs) return false;
+    quantize_into(ctx, quant, convrot_load_minimax_mod{d}, d.C, d.L);
+    return true;
+}
+
+bool ggml_sycl_quantize_i8_convrot_fused_input(ggml_backend_sycl_context & ctx, ggml_tensor * producer, ggml_tensor * quant) {
+    if (quant->op != GGML_OP_QUANTIZE_I8_CONVROT || quant->src[0] != producer ||
+        !ggml_sycl_convrot_geometry(quant, false) || producer->type != GGML_TYPE_F32 || !ggml_is_contiguous(producer)) return false;
+    const int64_t k = producer->ne[0], rows = ggml_nrows(producer);
+    if (!convrot_rows_supported(k)) return false;
+    const auto x = producer->src[0];
+    if (!x || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || !ggml_are_same_shape(x, producer)) return false;
+    if (kuno_overlap(x, quant) || (producer->op == GGML_OP_MUL && kuno_overlap(producer->src[1], quant))) return false;
+    if (producer->op == GGML_OP_MUL) {
+        const auto w = producer->src[1];
+        if (!w || w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) || w->ne[0] != k || ggml_nelements(w) != k) return false;
+        quantize_into(ctx, quant, convrot_load_mul_row{static_cast<const float *>(x->data), static_cast<const float *>(w->data), k}, k, rows);
+    } else if (producer->op == GGML_OP_SCALE) {
+        float scale, bias;
+        memcpy(&scale, (const float *) producer->op_params + 0, sizeof(float));
+        memcpy(&bias, (const float *) producer->op_params + 1, sizeof(float));
+        quantize_into(ctx, quant, convrot_load_scale{static_cast<const float *>(x->data), scale, bias, k}, k, rows);
+    } else return false;
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// INT8 linear epilogue fused with an optional SCALE and the Qwen gate/residual
+// MUL+ADD. Every stage is materialized to FP32 (volatile) exactly as the
+// separate kernels store it, so no contraction or reassociation crosses stages.
+bool ggml_sycl_mul_mat_i8_convrot_epilogue(ggml_backend_sycl_context & ctx, ggml_tensor * mm, ggml_tensor * scale_node,
+                                           ggml_tensor * mul, ggml_tensor * add) {
+    if (!ggml_sycl_convrot_geometry(mm, true) || mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm)) return false;
+    ggml_tensor * value = scale_node ? scale_node : mm;
+    if (scale_node && (scale_node->op != GGML_OP_SCALE || scale_node->src[0] != mm || !ggml_is_contiguous(scale_node) ||
+                       !ggml_are_same_shape(scale_node, mm))) return false;
+    if (!ggml_sycl_mul_add_memory_safe(mul, add) || mul->src[0] != value || add->src[1] != mul) return false;
+    if (mm->ne[2] != 1 || mm->ne[3] != 1) return false;
+    // The output may be the residual itself (same element in place) but no other input.
+    if (kuno_overlap(add, mul->src[1]) || (kuno_overlap(add, add->src[0]) && add->data != add->src[0]->data) ||
+        kuno_overlap(add, mm->src[2]) || (mm->src[3] && kuno_overlap(add, mm->src[3]))) return false;
+    float s_scale = 1.f, s_bias = 0.f;
+    if (scale_node) {
+        memcpy(&s_scale, (const float *) scale_node->op_params + 0, sizeof(float));
+        memcpy(&s_bias, (const float *) scale_node->op_params + 1, sizeof(float));
+    }
+    convrot_product p(ctx, mm);
+    auto queue = ctx.stream();
+    const int64_t rows = p.rows, n = p.n;
+    const int32_t * accum = p.accum;
+    const float * activation_scales = p.activation_scales;
+    const float * scales = static_cast<const float *>(mm->src[2]->data);
+    const float * bias = mm->src[3] ? static_cast<const float *>(mm->src[3]->data) : nullptr;
+    const float * gate = static_cast<const float *>(mul->src[1]->data);
+    const float * residual = static_cast<const float *>(add->src[0]->data);
+    float * output = static_cast<float *>(add->data);
+    const bool has_scale = scale_node != nullptr;
+    queue->submit([&](sycl::handler & h) {
+        h.depends_on(p.gemm);
+        h.parallel_for(sycl::range<2>(rows, n), [=](sycl::id<2> at) {
+            const size_t i = at[0] * n + at[1];
+            const int64_t row = at[0], col = at[1];
+            float value = float(accum[i]) * activation_scales[row];
+            value *= scales[col];
+            if (bias) value += bias[col];
+            volatile float linear = value;
+            float x = linear;
+            if (has_scale) {
+                volatile float scaled = s_scale * x + s_bias;
+                x = scaled;
+            }
+            volatile float product = op_mul(x, gate[col]);
+            const float materialized_product = product;
+            output[i] = op_add(residual[i], materialized_product);
+        });
+    });
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// q/k projection: INT8 linear -> per-head RMS norm * weight -> RoPE, in one
+// pass over the int32 product. One 16-lane sub-group per (token, head) row;
+// lane l owns columns l + 16m, matching the RMS kernel's accumulation order.
+// Every former materialization is kept as a volatile FP32 value, and RoPE
+// products/sums are uncontracted like the precise whole-RoPE kernel.
+bool ggml_sycl_mul_mat_i8_convrot_qk(ggml_backend_sycl_context & ctx, ggml_tensor * mm, ggml_tensor * rms, ggml_tensor * mul,
+                                     const ggml_tensor * pe, ggml_tensor * out_f32, ggml_tensor * concat, const ggml_tensor * prefix) {
+    if (!ggml_sycl_convrot_geometry(mm, true) || mm->type != GGML_TYPE_F32 || mm->ne[0] != 4096 || mm->ne[2] != 1 || mm->ne[3] != 1) return false;
+    const ggml_tensor * w = mul->src[0] == rms ? mul->src[1] : mul->src[0];
+    if (!w || w->type != GGML_TYPE_F32 || ggml_nelements(w) != 128 || !ggml_is_contiguous(w)) return false;
+    const int64_t L = mm->ne[1];
+    if (pe->type != GGML_TYPE_F32 || !ggml_is_contiguous(pe) || ggml_nelements(pe) != 2 * 128 * L) return false;
+    float eps = 0.f; memcpy(&eps, rms->op_params, sizeof(float));
+    int64_t prefix_len = 0, total = L;
+    if (concat) {
+        if (!prefix || prefix->type != GGML_TYPE_F16 || concat->type != GGML_TYPE_F16 || !ggml_is_contiguous(concat) ||
+            ((const int32_t *) concat->op_params)[0] != 1 || prefix->ne[0] != 128 || prefix->ne[2] != 32 ||
+            concat->ne[0] != 128 || concat->ne[2] != 32 || concat->ne[1] != prefix->ne[1] + L) return false;
+        prefix_len = prefix->ne[1]; total = concat->ne[1];
+        if (kuno_overlap(concat, prefix)) return false;
+    } else if (!out_f32 || out_f32->type != GGML_TYPE_F32 || !ggml_is_contiguous(out_f32) || ggml_nelements(out_f32) != 4096 * L) return false;
+    ggml_tensor * out = concat ? concat : out_f32;
+    if (kuno_overlap(out, pe) || kuno_overlap(out, w) || kuno_overlap(out, mm->src[2]) || (mm->src[3] && kuno_overlap(out, mm->src[3])) ||
+        (mm->src[1]->type == GGML_TYPE_I8 && kuno_overlap(out, mm->src[1]))) return false;
+    convrot_product p(ctx, mm);
+    auto queue = ctx.stream();
+    const int32_t * accum = p.accum; const float * act = p.activation_scales;
+    const float * ws = static_cast<const float *>(mm->src[2]->data);
+    const float * bias = mm->src[3] ? static_cast<const float *>(mm->src[3]->data) : nullptr;
+    const float * wn = static_cast<const float *>(w->data); const float * pp = static_cast<const float *>(pe->data);
+    float * of = concat ? nullptr : static_cast<float *>(out_f32->data);
+    sycl::half * q16 = nullptr;
+    if (of) {
+        auto & sh = kuno_q_shadow();
+        const size_t need = size_t(L) * 4096;
+        if (sh.cap < need) {
+            if (sh.buf) { queue->wait(); sycl::free(sh.buf, *queue); }
+            sh.buf = sycl::malloc_device<sycl::half>(need, *queue); sh.cap = sh.buf ? need : 0;
+        }
+        if (sh.buf) { q16 = sh.buf; sh.key = out_f32->data; }
+    }
+    sycl::half * oh = concat ? static_cast<sycl::half *>(concat->data) : nullptr;
+    if (concat) {
+        // Prefix rows are copied bitwise into their concatenated positions.
+        const sycl::half * pr = static_cast<const sycl::half *>(prefix->data);
+        const size_t pb1 = prefix->nb[1], pb2 = prefix->nb[2];
+        const int64_t pl = prefix_len, tot = total;
+        queue->parallel_for(sycl::range<3>(32, pl, 128), [=](sycl::id<3> at) {
+            const int64_t h = at[0], t = at[1], e = at[2];
+            oh[e + 128 * (t + tot * h)] = *(const sycl::half *) ((const char *) pr + e * 2 + t * pb1 + h * pb2);
+        });
+    }
+    const int64_t rows = L * 32;
+    const int ncols = int(rms->src[0]->ne[0]);  // runtime divisor, as in the RMS kernel
+    const int block_size = 16;  // runtime, as passed to the RMS kernel
+    queue->submit([&](sycl::handler & h) {
+        h.depends_on(p.gemm);
+        sycl::local_accessor<float, 1> stage(8 * 128, h);
+        h.parallel_for(sycl::nd_range<1>(rows * 16, 128), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            auto sg = it.get_sub_group();
+            const int64_t r = it.get_global_id(0) / 16;
+            const int lane = int(sg.get_local_linear_id());
+            const int64_t t = r / 32, hd = r % 32;
+            float * x = &stage[sg.get_group_linear_id() * 128];
+            for (int m = 0; m < 8; ++m) {
+                const int64_t col = hd * 128 + lane + 16 * m;
+                float value = float(accum[t * 4096 + col]) * act[t];
+                value *= ws[col];
+                if (bias) value += bias[col];
+                x[lane + 16 * m] = value;
+            }
+            sycl::group_barrier(sg);
+            // The RMS kernel's exact loop forms over the materialized row.
+            const int tid = lane;
+            float tmp = 0.0f;
+            for (int col = tid; col < ncols; col += block_size) {
+                const float xi = x[col];
+                tmp += xi * xi;
+            }
+            for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                tmp += dpct::permute_sub_group_by_xor(sg, tmp, mask);
+            }
+            const float mean = tmp / ncols;
+            const float scale = sycl::rsqrt(mean + eps);
+            const bool even = (lane & 1) == 0;
+#pragma unroll
+            for (int m = 0; m < 8; ++m) {
+                const int e = lane + 16 * m;
+                volatile float normed_store = scale * x[e] * wn[e];
+                const float normed = normed_store;
+                const float partner = sycl::permute_group_by_xor(sg, normed, 1);
+                const float x0 = even ? normed : partner, x1 = even ? partner : normed;
+                float rope;
+                {
+#pragma clang fp contract(off)
+                    volatile float product0 = op_mul(x0, pp[128 * t + e]);
+                    volatile float product1 = op_mul(x1, pp[128 * t + e + 128 * L]);
+                    rope = op_add(product0, product1);
+                }
+                if (of) {
+                    of[e + 128 * (t + L * hd)] = rope;
+                    if (q16) q16[e + 128 * (t + L * hd)] = sycl::vec<float, 1>(rope).convert<sycl::half, sycl::rounding_mode::automatic>()[0];
+                }
+                else oh[e + 128 * (prefix_len + t + total * hd)] =
+                         sycl::vec<float, 1>(rope).convert<sycl::half, sycl::rounding_mode::automatic>()[0];
+            }
+        });
+    });
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// MiniMax H3 attention inputs from the fused qkv projection, in one pass over the int32 product:
+//   q, k: per-head RMS norm * weight (exact RMS loop forms) -> partial RoPE (first R dims,
+//         non-interleaved halves) -> [128, L, H]; q as F32 (+F16 shadow), k scaled -> F16
+//   v:    scaled -> F16 [128, L, H]
+// One 16-lane sub-group per (token, q|k|v, head) row; every former node value is materialized.
+bool ggml_sycl_mul_mat_i8_convrot_minimax_qkv(ggml_backend_sycl_context & ctx, ggml_tensor * mm, const kuno_minimax_qkv_args & a) {
+    if (!ggml_sycl_convrot_geometry(mm, true) || mm->type != GGML_TYPE_F32 || mm->ne[2] != 1 || mm->ne[3] != 1) return false;
+    const int64_t H = a.heads, L = mm->ne[1], inner = H * 128, R = a.rot;
+    if (mm->ne[0] != 3 * inner || R <= 0 || R > 128 || R % 2) return false;
+    for (const ggml_tensor * w : {a.wq, a.wk})
+        if (!w || w->type != GGML_TYPE_F32 || ggml_nelements(w) != 128 || !ggml_is_contiguous(w)) return false;
+    if (!a.q || a.q->type != GGML_TYPE_F32 || !ggml_is_contiguous(a.q) || ggml_nelements(a.q) != inner * L) return false;
+    for (const ggml_tensor * o : {a.k16, a.v16})
+        if (!o || o->type != GGML_TYPE_F16 || !ggml_is_contiguous(o) || ggml_nelements(o) != inner * L) return false;
+    for (const ggml_tensor * o : {a.q, a.k16, a.v16}) {
+        if (kuno_overlap(o, a.pe) || kuno_overlap(o, a.wq) || kuno_overlap(o, a.wk) || kuno_overlap(o, mm->src[2]) ||
+            (mm->src[3] && kuno_overlap(o, mm->src[3]))) return false;
+    }
+    if (kuno_overlap(a.q, a.k16) || kuno_overlap(a.q, a.v16) || kuno_overlap(a.k16, a.v16)) return false;
+    convrot_product p(ctx, mm);
+    auto queue = ctx.stream();
+    const int32_t * accum = p.accum; const float * act = p.activation_scales;
+    const float * ws = static_cast<const float *>(mm->src[2]->data);
+    const float * bias = mm->src[3] ? static_cast<const float *>(mm->src[3]->data) : nullptr;
+    const float * wq = static_cast<const float *>(a.wq->data), * wk = static_cast<const float *>(a.wk->data);
+    const char * pe = static_cast<const char *>(a.pe->data);
+    const size_t p0 = a.pe->nb[0], p1 = a.pe->nb[1], p2 = a.pe->nb[2], p3 = a.pe->nb[3];
+    float * qo = static_cast<float *>(a.q->data);
+    sycl::half * ko = static_cast<sycl::half *>(a.k16->data), * vo = static_cast<sycl::half *>(a.v16->data);
+    sycl::half * q16 = nullptr;
+    {
+        auto & sh = kuno_q_shadow();
+        const size_t need = size_t(L) * inner;
+        if (sh.cap < need) {
+            if (sh.buf) { queue->wait(); sycl::free(sh.buf, *queue); }
+            sh.buf = sycl::malloc_device<sycl::half>(need, *queue); sh.cap = sh.buf ? need : 0;
+        }
+        if (sh.buf) { q16 = sh.buf; sh.key = a.q->data; }
+    }
+    const float eps_q = a.eps_q, eps_k = a.eps_k, ks = a.k_scale, kb = a.k_bias, vs = a.v_scale, vb = a.v_bias;
+    const int64_t n = p.n, R2 = R / 2, rows = L * 3 * H;
+    const int ncols = 128;     // runtime divisor and bound, as in the RMS kernel
+    const int block_size = 16;
+    queue->submit([&](sycl::handler & h) {
+        h.depends_on(p.gemm);
+        sycl::local_accessor<float, 1> stage(8 * 128, h);
+        h.parallel_for(sycl::nd_range<1>(rows * 16, 128), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            auto sg = it.get_sub_group();
+            const int64_t r = it.get_global_id(0) / 16;
+            const int lane = int(sg.get_local_linear_id());
+            const int64_t hd = r % H, which = (r / H) % 3, t = r / (3 * H);
+            float * x = &stage[sg.get_group_linear_id() * 128];
+            const size_t out_base = size_t(128) * (t + L * hd);
+            for (int m = 0; m < 8; ++m) {
+                const int64_t col = which * inner + hd * 128 + lane + 16 * m;
+                float value = float(accum[t * n + col]) * act[t];
+                value *= ws[col];
+                if (bias) value += bias[col];
+                volatile float linear = value;
+                x[lane + 16 * m] = linear;
+            }
+            if (which == 2) {
+                for (int m = 0; m < 8; ++m) {
+                    const int e = lane + 16 * m;
+                    volatile float scaled = vs * x[e] + vb;
+                    const float sv = scaled;
+                    vo[out_base + e] = sycl::vec<float, 1>(sv).convert<sycl::half, sycl::rounding_mode::automatic>()[0];
+                }
+                return;
+            }
+            sycl::group_barrier(sg);
+            const float eps = which == 0 ? eps_q : eps_k;
+            const float * wn = which == 0 ? wq : wk;
+            const int tid = lane;
+            float tmp = 0.0f;
+            for (int col = tid; col < ncols; col += block_size) {
+                const float xi = x[col];
+                tmp += xi * xi;
+            }
+            for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                tmp += dpct::permute_sub_group_by_xor(sg, tmp, mask);
+            }
+            const float mean = tmp / ncols;
+            const float scale = sycl::rsqrt(mean + eps);
+            float normed[8];
+            for (int m = 0; m < 8; ++m) {
+                const int e = lane + 16 * m;
+                volatile float normed_store = scale * x[e] * wn[e];
+                normed[m] = normed_store;
+            }
+            sycl::group_barrier(sg);
+            for (int m = 0; m < 8; ++m) x[lane + 16 * m] = normed[m];
+            sycl::group_barrier(sg);
+            for (int m = 0; m < 8; ++m) {
+                const int64_t d = lane + 16 * m;
+                float out;
+                if (d < R) {
+                    const int64_t k = d / R2, aa = d % R2;
+                    const char * pp = pe + k * p0 + aa * p1 + t * p2;
+                    const float c0 = *(const float *) pp, c1 = *(const float *) (pp + p3);
+                    {
+#pragma clang fp contract(off)
+                        volatile float product0 = op_mul(x[aa], c0);
+                        volatile float product1 = op_mul(x[aa + R2], c1);
+                        out = op_add(float(product0), float(product1));
+                    }
+                } else {
+                    out = x[d];
+                }
+                if (which == 0) {
+                    qo[out_base + d] = out;
+                    if (q16) q16[out_base + d] = sycl::vec<float, 1>(out).convert<sycl::half, sycl::rounding_mode::automatic>()[0];
+                } else {
+                    volatile float scaled = ks * out + kb;
+                    const float sk = scaled;
+                    ko[out_base + d] = sycl::vec<float, 1>(sk).convert<sycl::half, sycl::rounding_mode::automatic>()[0];
+                }
+            }
+        });
+    });
+    return true;
+}
+
+kuno_f16_shadow & kuno_q_shadow() { static kuno_f16_shadow shadow; return shadow; }
+
+// Attention output (oneDNN F16 [H][q][d]) -> SCALE -> ConvRot quantize.
+struct convrot_load_sdpa16 {
+    const sycl::half * o; int64_t q; float scale, bias;
+    float operator()(int64_t row, int64_t e) const {
+        const int64_t h = e >> 7, c = e & 127;
+        const float x = float(o[(h * q + row) * 128 + c]);
+        return sycl::fma(scale, x, bias);
+    }
+};
+void ggml_sycl_quantize_i8_convrot_from_sdpa16(ggml_backend_sycl_context & ctx, const sycl::half * out16, int64_t q,
+                                                const ggml_tensor * scale_node, ggml_tensor * quant) {
+    float scale, bias;
+    memcpy(&scale, (const float *) scale_node->op_params + 0, sizeof(float));
+    memcpy(&bias, (const float *) scale_node->op_params + 1, sizeof(float));
+    quantize_into(ctx, quant, convrot_load_sdpa16{out16, q, scale, bias}, 4096, q);
+}
