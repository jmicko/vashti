+        let pool = CleanReadbacks::<wgpu::Buffer>::new(true).unwrap();
+        assert!(
+            pool.buffers.capacity() * std::mem::size_of::<(wgpu::Buffer, u64)>()
+                + std::mem::size_of_val(&pool)
+                <= 4096
+        );
+        assert!(CleanReadbacks::<[u8; 4096]>::new(true).is_err());
+    }
+}
