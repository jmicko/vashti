+    pub(crate) fn await_inline_read_maps(&self, deadline: Instant) -> Result<(), ServerError> {
+        if self.poll_map_until(deadline) {
+            Ok(())
+        } else {
+            Err(fault(self.leases.reason(Failure::ReadbackMap)))
