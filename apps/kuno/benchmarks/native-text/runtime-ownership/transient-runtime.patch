+                    .as_ref()
+                    .map(|v| {
+                        v.to_str()
+                            .ok_or_else(|| fault("readback reuse setting encoding"))
+                    })
+                    .transpose()?,
+                info_batch,
+            )?;
+            let raw_gpu = std::env::var_os("KUNO_LAB_GPU_UPLOAD_CLEAR");
+            let gpu_upload_clear = configured_gpu_upload_clear(
