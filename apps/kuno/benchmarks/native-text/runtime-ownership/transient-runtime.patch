+impl AuditBackend for NativeAudit<'_> {
+    type Buffer = wgpu::Buffer;
+    fn prepare_full(
+        &mut self,
+        source: &wgpu::Buffer,
+        kind: Kind,
+    ) -> Result<AuditCounts, ServerError> {
+        let mut counts = AuditCounts {
+            bytes: source.size(),
+            buffers: 1,
