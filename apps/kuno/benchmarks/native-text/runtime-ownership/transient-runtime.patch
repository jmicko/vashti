+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+struct AuditCounts {
+    bytes: u64,
+    buffers: u64,
+}
+impl AuditCounts {
+    fn add(&mut self, other: Self) -> Result<(), ServerError> {
+        self.bytes = self
+            .bytes
+            .checked_add(other.bytes)
+            .ok_or_else(|| fault("private audit counter overflow"))?;
+        self.buffers = self
+            .buffers
+            .checked_add(other.buffers)
+            .ok_or_else(|| fault("private audit counter overflow"))?;
+        Ok(())
+    }
+}
+trait AuditBackend {
+    type Buffer;
