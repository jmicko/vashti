+fn drop_lifo<T>(values: &mut Vec<T>) {
+    while let Some(value) = values.pop() {
+        drop(value);
+    }
+}
+impl Drop for IoScopes {
+    fn drop(&mut self) {
+        drop_lifo(&mut self.0);
+    }
+}
