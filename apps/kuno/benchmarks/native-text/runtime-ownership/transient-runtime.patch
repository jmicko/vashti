+    #[test]
+    fn error_panic_and_abandonment_restore_boundary_and_retire_stream() {
+        for failure in [0, 1, 2] {
+            let state = Arc::new(CleanupBoundary::default());
+            let guard = state.begin(0).unwrap();
+            if failure == 2 {
+                drop(guard);
+            } else {
+                assert!(
