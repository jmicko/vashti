+        buffer: &Self::Buffer,
+        kind: Kind,
+    ) -> Result<AuditCounts, ServerError>;
+    /// Complete all prepared copies and inspect every full readable span.
+    fn inspect_prepared(&mut self, buffers: &[Tracked<Self::Buffer>]) -> Result<(), ServerError>;
+    fn finish_scopes(&mut self) {}
