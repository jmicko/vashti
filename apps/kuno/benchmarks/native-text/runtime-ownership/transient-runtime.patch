+impl Drop for AuditMapGuard {
+    fn drop(&mut self) {
+        if self.requested
+            && std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| self.buffer.unmap()))
+                .is_err()
+        {
+            self.retired.retire_with(Failure::Unmap);
+        }
+    }
