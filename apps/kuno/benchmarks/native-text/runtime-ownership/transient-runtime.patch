+impl PrivateMutationGuard {
+    pub(crate) fn accept(mut self) {
+        self.accepted = true;
+    }
+}
+impl Drop for PrivateMutationGuard {
+    fn drop(&mut self) {
+        if !self.accepted {
+            self.tracker.retire_with(Failure::MutationAbandoned);
+        }
+    }
