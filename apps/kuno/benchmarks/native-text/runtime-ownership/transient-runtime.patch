+                            .ok_or_else(|| fault("batched private INFO setting encoding"))
+                    })
+                    .transpose()?,
+                slab_bytes,
+            )?;
+            if info_batch {
+                println!("private_info_batch_upload enabled=true");
+            }
+            let raw_reuse = std::env::var_os("KUNO_LAB_READBACK_REUSE");
+            let reuse = configured_readback_reuse(
